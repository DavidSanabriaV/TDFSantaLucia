@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>

    <div class="d-flex justify-content-center gap-4">
        <a asp-controller="Cliente"
           asp-action="Index"
           class="btn btn-primary btn-lg">Clientes</a>
    </div>
    <div class="d-flex justify-content-center gap-4">
        <a asp-controller="Categoria"
           asp-action="Index"
           class="btn btn-primary btn-lg">Categorias</a>
    </div>
    <div class="d-flex justify-content-center gap-4">
        <a asp-controller="Inventario"
           asp-action="Index"
           class="btn btn-primary btn-lg">Inventario</a>
    </div>
    <div class="d-flex justify-content-center gap-4">
        <a asp-controller="Producto"
           asp-action="Index"
           class="btn btn-primary btn-lg">Productos</a>
    </div>
    <div class="d-flex justify-content-center gap-4">
        <a asp-controller="Expediente"
           asp-action="Index"
           class="btn btn-primary btn-lg">Expedientes</a>
    </div>
</div>
