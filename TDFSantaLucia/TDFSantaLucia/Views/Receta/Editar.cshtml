@model TDFSantaLucia.Models.RecetaMedica
@{
    ViewData["Title"] = "Editar Receta Médica";
    var expediente = ViewBag.Expediente as TDFSantaLucia.Models.Expediente;
}

<div class="container py-4" style="max-width:700px;">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <h2 class="fw-bold mb-4" style="color:#1a3c5e;">
                <i class="bi bi-file-medical me-2 text-primary"></i>Editar Receta Médica
            </h2>

            @if (!ViewData.ModelState.IsValid && ViewContext.HttpContext.Request.Method == "POST")
            {
                <div class="alert alert-danger rounded-3 mb-4">
                    <h6 class="fw-bold mb-2">
                        <i class="bi bi-exclamation-triangle me-1"></i>Por favor corrija los siguientes errores:
                    </h6>
                    <ul class="mb-0">
                        @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@e.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form asp-action="Editar" asp-route-id="@Model.Receta_Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Receta_Id" />
                <input type="hidden" asp-for="Expediente_Id" />

                <div class="row g-3">

                    <div class="col-12">
                        <label class="form-label fw-semibold">Medicamento</label>
                        @Html.DropDownList("Producto_Id",
                            (SelectList)ViewBag.Productos,
                            "— Seleccione un medicamento —",
                            new { @class = "form-select rounded-3" })
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Frecuencia</label>
                        <input asp-for="Frecuencia" class="form-control rounded-3" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Fecha de vencimiento</label>
                        <input asp-for="Fecha_Vencimiento" type="date" class="form-control rounded-3"
                               value="@Model.Fecha_Vencimiento?.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">Descripción</label>
                        <textarea asp-for="Descripcion" class="form-control rounded-3" rows="3"></textarea>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">Observaciones</label>
                        <textarea asp-for="Observaciones" class="form-control rounded-3" rows="2"></textarea>
                    </div>

                    <div class="col-12 d-flex justify-content-between mt-2">
                        <a asp-controller="Expediente" asp-action="Detalle"
                           asp-route-id="@Model.Expediente_Id"
                           class="btn rounded-3"
                           style="background-color:#d0e8f5; color:#2a7ab5; border:none;">
                            <i class="bi bi-arrow-left me-1"></i>Cancelar
                        </a>
                        <button type="submit" class="btn rounded-3" id="btnGuardar"
                                style="background-color:#fde8cc; color:#d4620a; border:none;">
                            <i class="bi bi-save me-1"></i>Guardar cambios
                        </button>
                    </div>

                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelector('form').addEventListener('submit', function () {
            const btn = document.getElementById('btnGuardar');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Guardando...';
        });
    </script>
}