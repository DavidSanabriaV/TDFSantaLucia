@model List<TDFSantaLucia.Models.CarritoItem>
@{
    ViewData["Title"] = "Mi Carrito";
    var subtotal = Model.Sum(i => i.Subtotal);
    var impuesto = Math.Round(subtotal * 0.13m, 2);
    var total = subtotal + impuesto;
}

<div class="container py-4">
    <h2 class="fw-bold mb-4" style="color:#243C8F;">
        <i class="bi bi-cart3 me-2"></i>Mi Carrito
    </h2>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-cart-x display-3 text-muted"></i>
            <p class="text-muted mt-3">Tu carrito está vacío.</p>
            <a asp-controller="Producto" asp-action="Index"
                   class="btn btn-primary mt-2">
                <i class="bi bi-bag me-1"></i>Ver productos
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-0">
                        @foreach (var item in Model)
                        {
                            <div class="d-flex align-items-center gap-3 p-3 border-bottom"
                                 id="fila-@item.Producto_Id">
                                <img src="@(item.Imagen_URL ?? "/img/producto-default.png")"
                                     style="width:70px;height:70px;object-fit:contain;border-radius:12px;"
                                     onerror="this.src='/img/producto-default.png'" />

                                <div class="flex-grow-1">
                                    <div class="fw-semibold" style="color:#243C8F;">
                                        @item.Nombre
                                    </div>
                                    <small class="text-muted">@(item.Marca ?? "")</small>
                                    @if (item.Receta)
                                    {
                                        <span class="badge bg-warning text-dark ms-1">
                                            <i class="bi bi-file-medical me-1"></i>Receta
                                        </span>
                                    }
                                    <div class="text-primary fw-bold mt-1">
                                        ₡@item.Precio.ToString("N2")
                                    </div>
                                </div>

                                <div class="d-flex align-items-center gap-2">
                                    <button class="btn btn-outline-secondary btn-sm"
                                            onclick="cambiarCantidad(@item.Producto_Id, -1)">
                                        <i class="bi bi-dash"></i>
                                    </button>
                                    <span class="fw-bold px-2"
                                          id="cant-@item.Producto_Id">
                                        @item.Cantidad
                                    </span>
                                    <button class="btn btn-outline-secondary btn-sm"
                                            onclick="cambiarCantidad(@item.Producto_Id, 1)">
                                        <i class="bi bi-plus"></i>
                                    </button>
                                </div>

                                <div class="text-end" style="min-width:90px;">
                                    <div class="fw-bold" id="sub-@item.Producto_Id">
                                        ₡@item.Subtotal.ToString("N2")
                                    </div>
                                    <button class="btn btn-link text-danger btn-sm p-0 mt-1"
                                            onclick="eliminarItem(@item.Producto_Id)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4">
                    <h5 class="fw-bold mb-3" style="color:#243C8F;">
                        Resumen del pedido
                    </h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Subtotal</span>
                        <span id="resumenSubtotal">₡@subtotal.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">IVA (13%)</span>
                        <span id="resumenImpuesto">₡@impuesto.ToString("N2")</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between fw-bold fs-5 mb-4">
                        <span>Total</span>
                        <span id="resumenTotal" style="color:#243C8F;">
                            ₡@total.ToString("N2")
                        </span>
                    </div>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Pedido" asp-action="Checkout"
                               class="btn btn-success w-100 rounded-3 fw-bold">
                            <i class="bi bi-bag-check me-1"></i>Proceder al pago
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login"
                               class="btn btn-primary w-100 rounded-3 fw-bold">
                            <i class="bi bi-person me-1"></i>
                            Inicia sesión para continuar
                        </a>
                    }

                    <a asp-controller="Producto" asp-action="Index"
                           class="btn btn-outline-secondary w-100 rounded-3 mt-2">
                        <i class="bi bi-arrow-left me-1"></i>Seguir comprando
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
                const token = document.querySelector(
            'input[name="__RequestVerificationToken"]').value;

                        function cambiarCantidad(productoId, delta) {
            const cantEl = document.getElementById(`cant-${productoId}`);
            const nuevaCant = parseInt(cantEl.textContent) + delta;

            if (nuevaCant < 1) {
                eliminarItem(productoId);
                return;
            }

            fetch('/carrito/actualizar', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: `productoId=${productoId}&cantidad=${nuevaCant}`
            })
            .then(r => r.json())
            .then(d => {
                if (d.exito) {
                    cantEl.textContent = nuevaCant;
                    document.getElementById(`sub-${productoId}`)
                        .textContent = `₡${d.subtotal.toLocaleString('es-CR', {minimumFractionDigits: 2})}`;
                    actualizarResumen(d.total, d.count);
                }

            });
        }

        function eliminarItem(productoId) {
            if (!confirm('¿Eliminar este producto del carrito?')) return;

            fetch('/carrito/eliminar', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: `productoId=${productoId}`
            })
            .then(r => r.json())
            .then(d => {
                if (d.exito) {
                    document.getElementById(`fila-${productoId}`).remove();
                    actualizarResumen(d.total, d.count);
                    if (d.count === 0) location.reload();
                }
            });
        }

        function actualizarResumen(total, count) {
            const subtotalNum = total;
            const impuestoNum = Math.round(subtotalNum * 0.13 * 100) / 100;
            const totalNum    = subtotalNum + impuestoNum;

            document.getElementById('resumenSubtotal').textContent =
                `₡${subtotalNum.toLocaleString('es-CR', {minimumFractionDigits: 2})}`;
            document.getElementById('resumenImpuesto').textContent =
                `₡${impuestoNum.toLocaleString('es-CR', {minimumFractionDigits: 2})}`;
            document.getElementById('resumenTotal').textContent =
                `₡${totalNum.toLocaleString('es-CR', {minimumFractionDigits: 2})}`;

            const badge = document.querySelector('.badge.rounded-pill');
            if (badge) badge.textContent = count;
        }
    </script>
}