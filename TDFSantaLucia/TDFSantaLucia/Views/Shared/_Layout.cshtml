<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TDFSantaLucia</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TDFSantaLucia.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>

    <header>
        <div class="top-navbar px-4 py-2">
            <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap">

                <a asp-controller="Home" asp-action="Index">
                    <img src="~/images/fotoL.jpg" alt="Logo" style="height:58px; border-radius:14px;">
                </a>

                <form asp-controller="Producto"
                      asp-action="Index"
                      method="get"
                      class="flex-grow-1 mx-4"
                      style="max-width:550px; position:relative;">
                    <div class="input-group buscador-navbar" style="position:relative;">
                        <input type="text" name="buscar" class="form-control"
                               placeholder="Buscar producto..." autocomplete="off">
                        <button class="input-group-text">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </form>

                <div class="d-flex align-items-center gap-3">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown">
                            <a href="#"
                               class="icon-navbar d-flex align-items-center gap-2 dropdown-toggle text-decoration-none"
                               data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle fs-5"></i>
                                <span class="small fw-semibold d-none d-md-inline"
                                      style="max-width:120px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; display:inline-block;">
                                    @User.Identity.Name
                                </span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3">
                                <li>
                                    <span class="dropdown-item-text small text-muted">
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <i class="bi bi-shield-fill-check text-danger me-1"></i>
                                            <text>Administrador</text>
                                        }
                                        else if (User.IsInRole("Empleado"))
                                        {
                                            <i class="bi bi-person-badge-fill text-primary me-1"></i>
                                            <text>Empleado</text>
                                        }
                                        else
                                        {
                                            <i class="bi bi-person-fill text-success me-1"></i>
                                            <text>Cliente</text>
                                        }
                                    </span>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="icon-navbar">
                            <i class="bi bi-person"></i>
                        </a>
                    }

                    <a href="#" class="icon-navbar position-relative">
                        <i class="bi bi-cart"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-info text-dark"
                              style="font-size:10px;">0</span>
                    </a>

                </div>
            </div>
        </div>

        <div class="menu-navbar px-4 py-2">
            <ul class="nav justify-content-center align-items-center flex-wrap gap-2">

                <li class="nav-item">
                    <a class="nav-link menu-link" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-fill me-1"></i>Home
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link menu-link" asp-controller="Producto" asp-action="Index">
                        <i class="bi bi-bag-fill me-1"></i>Productos
                    </a>
                </li>

                @if (User.IsInRole("Admin") || User.IsInRole("Empleado"))
                {
                    <li class="nav-item">
                        <a class="nav-link menu-link" asp-controller="Cliente" asp-action="Index">
                            <i class="bi bi-people-fill me-1"></i>Clientes
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link menu-link" asp-controller="Inventario" asp-action="Index">
                            <i class="bi bi-box-seam-fill me-1"></i>Inventario
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link menu-link" asp-controller="Expediente" asp-action="Index">
                            <i class="bi bi-folder-fill me-1"></i>Expedientes
                        </a>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link menu-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-calendar2-heart-fill me-1"></i>Citas
                        </a>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item" asp-controller="Cita" asp-action="Index">
                                    Gestión de Citas
                                </a>
                            </li>
                        </ul>
                    </li>
                }

                @if (User.IsInRole("Cliente"))
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link menu-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-calendar2-heart-fill me-1"></i>Citas
                        </a>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item" asp-controller="Cita" asp-action="MisCitas">
                                    <i class="bi bi-calendar-check me-1"></i>Mis Citas
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Cita" asp-action="Agendar">
                                    <i class="bi bi-calendar-plus me-1"></i>Agendar Cita
                                </a>
                            </li>
                        </ul>
                    </li>
                }

                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item">
                        <a class="nav-link menu-link" asp-controller="Categoria" asp-action="Index">
                            <i class="bi bi-grid-fill me-1"></i>Categorías
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link menu-link" asp-controller="Empleado" asp-action="Index">
                            <i class="bi bi-person-badge-fill me-1"></i>Empleados
                        </a>
                    </li>
                }

            </ul>
        </div>
    </header>

        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>

        <footer class="footer-custom pt-4 pb-2">
            <div class="container">
                <div class="row justify-content-between mb-3">

                    <div class="col-12 col-lg-3 mb-3 text-center text-lg-start">
                        <a asp-controller="Home" asp-action="Index">
                            <img src="~/images/fotoL.jpg" alt="Logo Farmacia Santa Lucía"
                                 style="height:100px; border-radius:16px;">
                            </a>
                        </div>

                        <div class="col-12 col-lg-3 mb-3">
                            <h6 class="fw-bold mb-3 footer-title">Contacto</h6>
                            <ul class="nav flex-column">
                                <li class="nav-item mb-2 footer-text">
                                    <i class="bi bi-telephone-fill me-2"></i>2237 3040
                                </li>
                                <li class="nav-item mb-2 footer-text">
                                    <i class="bi bi-envelope-fill me-2"></i>farmasantalucia@ice.co.cr
                                </li>
                                <li class="nav-item mb-2 footer-text">
                                    <i class="bi bi-geo-alt-fill me-2"></i>Heredia, Costa Rica, 40102
                                </li>
                            </ul>
                        </div>

                        <div class="col-12 col-lg-3 mb-3">
                            <h6 class="fw-bold mb-3 footer-title">Enlaces</h6>
                            <ul class="nav flex-column">
                                <li class="nav-item mb-2">
                                    <a asp-controller="Home" asp-action="Index" class="footer-link">
                                        <i class="bi bi-house-fill me-2"></i>Inicio
                                    </a>
                                </li>
                                <li class="nav-item mb-2">
                                    <a asp-controller="Producto" asp-action="Index" class="footer-link">
                                        <i class="bi bi-bag-fill me-2"></i>Productos
                                    </a>
                                </li>
                                <li class="nav-item mb-2">
                                    <a asp-controller="Home" asp-action="SobreNosotros" class="footer-link">
                                        <i class="bi bi-info-circle-fill me-2"></i>Sobre nosotros
                                    </a>
                                </li>
                                <li class="nav-item mb-2">
                                    <a asp-controller="Cita" asp-action="Index" class="footer-link">
                                        <i class="bi bi-calendar-check-fill me-2"></i>Citas
                                    </a>
                                </li>
                            </ul>
                        </div>

                    </div>
                </div>

                <hr class="footer-divider">

        <div class="container">
            <div class="row align-items-center mb-2">
                <div class="col-12 text-center">
                    <small class="footer-copy">
                        Farmacia Santa Lucía de Barva © 2026. Todos los derechos reservados.
                    </small>
                </div>
            </div>
        </div>
            </footer>

            <script src="~/lib/jquery/dist/jquery.min.js"></script>
            <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
            <script src="~/js/site.js" asp-append-version="true"></script>
            @await RenderSectionAsync("Scripts", required: false)
        </body>

<script>
    (function () {
        const inputNav = document.querySelector('form[action*="producto"] input[name="buscar"]');
        if (!inputNav) return;

        const wrapper = inputNav.closest('form');
        wrapper.style.position = 'relative';

        const dropdown = document.createElement('div');
        dropdown.id = 'sugerenciasDropdown';
        dropdown.style.display = 'none';
        wrapper.appendChild(dropdown);

        let productos = [];

        fetch('/producto/sugerencias')
            .then(r => r.json())
            .then(data => productos = data)
            .catch(() => {});

        inputNav.addEventListener('input', function () {
            const q = this.value.trim().toLowerCase();
            dropdown.innerHTML = '';

            if (!q || productos.length === 0) {
                dropdown.style.display = 'none';
                return;
            }

            const coincidencias = productos
                .filter(p => p.nombre.toLowerCase().includes(q))
                .slice(0, 8);

            if (coincidencias.length === 0) {
                dropdown.style.display = 'none';
                return;
            }

            coincidencias.forEach(p => {
                const a = document.createElement('a');
                a.className = 'sugerencia-item';
                a.href = `/producto/detalle/${p.id}`;
                a.innerHTML = `
                    <img class="sugerencia-img"
                         src="${p.imagen || '/img/producto-default.png'}"
                         onerror="this.src='/img/producto-default.png'">
                    <div>
                        <div class="sugerencia-nombre">${p.nombre}</div>
                        <div class="sugerencia-precio">₡${parseFloat(p.precio).toLocaleString('es-CR', {minimumFractionDigits:2})}</div>
                    </div>`;
                dropdown.appendChild(a);
            });

            dropdown.style.display = 'block';
        });

        document.addEventListener('click', function (e) {
            if (!wrapper.contains(e.target)) dropdown.style.display = 'none';
        });

        inputNav.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') dropdown.style.display = 'none';
        });
    })();
</script>
    </html>