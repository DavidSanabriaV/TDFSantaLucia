<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TDFSantaLucia</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TDFSantaLucia.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>

    <header>
        <div class="top-navbar px-4 py-2">
            <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap">

                <a asp-controller="Home" asp-action="Index">
                    <img src="~/images/fotoL.jpg" alt="Logo" style="height:58px; border-radius:14px;">
                </a>

                <form asp-controller="Producto"
                      asp-action="Index"
                      method="get"
                      class="flex-grow-1 mx-4"
                      style="max-width:550px;">
                    <div class="input-group buscador-navbar">
                        <input type="text" name="buscar" class="form-control"
                               placeholder="Buscar producto..." autocomplete="off">
                        <button class="input-group-text">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </form>

                <div class="d-flex align-items-center gap-3">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown">
                            <a href="#"
                                   class="icon-navbar d-flex align-items-center gap-2 dropdown-toggle text-decoration-none"
                                   data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle fs-5"></i>
                                <span class="small fw-semibold d-none d-md-inline"
                                      style="max-width:120px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; display:inline-block;">
                                    @User.Identity.Name
                                </span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3">
                                <li>
                                    <span class="dropdown-item-text small text-muted">
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <i class="bi bi-shield-fill-check text-danger me-1"></i>
                                            <text>Administrador</text>
                                        }
                                        else if (User.IsInRole("Empleado"))
                                        {
                                            <i class="bi bi-person-badge-fill text-primary me-1"></i>
                                            <text>Empleado</text>
                                        }
                                        else
                                        {
                                            <i class="bi bi-person-fill text-success me-1"></i>
                                            <text>Cliente</text>
                                        }
                                    </span>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="icon-navbar">
                            <i class="bi bi-person"></i>
                        </a>
                    }

                    <a asp-controller="Carrito" asp-action="Index"
                           class="icon-navbar position-relative" id="btnCarrito">
                        <i class="bi bi-cart"></i>
                        <span class="position-absolute top-0 start-100 translate-middle
                        badge rounded-pill bg-info text-dark"
                              style="font-size:10px;" id="carritoCount">0</span>
                    </a>

                </div>
            </div>
        </div>

        <div class="menu-navbar px-4 py-2">
            <ul class="nav justify-content-center align-items-center flex-wrap gap-2">

                <li class="nav-item">
                    <a class="nav-link menu-link" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-fill me-1"></i>Home
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link menu-link" asp-controller="Producto" asp-action="Index">
                        <i class="bi bi-bag-fill me-1"></i>Productos
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link menu-link" asp-controller="Articulo" asp-action="Index">
                        <i class="bi bi-heart-pulse-fill me-1"></i>Salud & Bienestar
                    </a>
                </li>

                @if (User.IsInRole("Admin") || User.IsInRole("Empleado"))
                {
                    <li class="nav-item">
                        <a class="nav-link menu-link" asp-controller="Cliente" asp-action="Index">
                            <i class="bi bi-people-fill me-1"></i>Clientes
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link menu-link" asp-controller="Inventario" asp-action="Index">
                            <i class="bi bi-box-seam-fill me-1"></i>Inventario
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link menu-link" asp-controller="Expediente" asp-action="Index">
                            <i class="bi bi-folder-fill me-1"></i>Expedientes
                        </a>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link menu-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-calendar2-heart-fill me-1"></i>Citas
                        </a>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item" asp-controller="Cita" asp-action="Index">
                                    Gestión de Citas
                                </a>
                            </li>
                        </ul>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link menu-link" asp-controller="Articulo" asp-action="Admin">
                            <i class="bi bi-journal-text me-1"></i>Gestión Salud
                        </a>
                    </li>
                }

                @if (User.IsInRole("Admin") || User.IsInRole("Empleado"))
                {
                    <li class="nav-item">
                        <a class="nav-link menu-link" asp-controller="Cupon" asp-action="Index">
                            <i class="bi bi-ticket-perforated-fill me-1"></i>Cupones
                        </a>
                    </li>
                }

                @if (User.IsInRole("Cliente"))
                {
                    <li class="nav-item">
                        <a class="nav-link menu-link" asp-controller="Cupon" asp-action="MisCupones">
                            <i class="bi bi-ticket-perforated me-1"></i>Mis Cupones
                        </a>
                    </li>
                }

                @if (User.IsInRole("Cliente"))
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link menu-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-calendar2-heart-fill me-1"></i>Citas
                        </a>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item" asp-controller="Cita" asp-action="MisCitas">
                                    <i class="bi bi-calendar-check me-1"></i>Mis Citas
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Cita" asp-action="Agendar">
                                    <i class="bi bi-calendar-plus me-1"></i>Agendar Cita
                                </a>
                            </li>
                        </ul>
                    </li>
                }

                @if (User.IsInRole("Cliente"))
                {
                    <li class="nav-item">
                        <a class="nav-link menu-link"
                               asp-controller="Pedido" asp-action="MisPedidos">
                            <i class="bi bi-list-ul me-1"></i>Mis Pedidos
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link menu-link"
                           asp-controller="Pedido" asp-action="MisPuntos">
                            <i class="bi bi-star-fill me-1"></i>Mis Puntos
                        </a>
                    </li>


                    <li class="nav-item">
                        <a class="nav-link menu-link"
                               asp-controller="Factura" asp-action="MisFacturas">
                            <i class="bi bi-receipt me-1"></i>Mis Facturas
                        </a>
                    </li>
                }

                @if (User.IsInRole("Admin") || User.IsInRole("Empleado"))
                {
                    <li class="nav-item">
                        <a class="nav-link menu-link"
                               asp-controller="Pedido" asp-action="Admin">
                            <i class="bi bi-clipboard2-check-fill me-1"></i>Pedidos
                        </a>
                    </li>
                }

                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item">
                        <a class="nav-link menu-link" asp-controller="Categoria" asp-action="Index">
                            <i class="bi bi-grid-fill me-1"></i>Categorías
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link menu-link" asp-controller="Empleado" asp-action="Index">
                            <i class="bi bi-person-badge-fill me-1"></i>Empleados
                        </a>
                    </li>
                }

            </ul>
        </div>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-custom pt-4 pb-2">
        <div class="container">
            <div class="row justify-content-between mb-3">

                <div class="col-12 col-lg-3 mb-3 text-center text-lg-start">
                    <a asp-controller="Home" asp-action="Index">
                        <img src="~/images/fotoL.jpg" alt="Logo Farmacia Santa Lucía"
                             style="height:100px; border-radius:16px;">
                    </a>
                </div>

                <div class="col-12 col-lg-3 mb-3">
                    <h6 class="fw-bold mb-3 footer-title">Contacto</h6>
                    <ul class="nav flex-column">
                        <li class="nav-item mb-2 footer-text">
                            <i class="bi bi-telephone-fill me-2"></i>2237 3040
                        </li>
                        <li class="nav-item mb-2 footer-text">
                            <i class="bi bi-envelope-fill me-2"></i>farmasantalucia@ice.co.cr
                        </li>
                        <li class="nav-item mb-2 footer-text">
                            <i class="bi bi-geo-alt-fill me-2"></i>Heredia, Costa Rica, 40102
                        </li>
                    </ul>
                </div>

                <div class="col-12 col-lg-3 mb-3">
                    <h6 class="fw-bold mb-3 footer-title">Enlaces</h6>
                    <ul class="nav flex-column">
                        <li class="nav-item mb-2">
                            <a asp-controller="Home" asp-action="Index" class="footer-link">
                                <i class="bi bi-house-fill me-2"></i>Inicio
                            </a>
                        </li>
                        <li class="nav-item mb-2">
                            <a asp-controller="Producto" asp-action="Index" class="footer-link">
                                <i class="bi bi-bag-fill me-2"></i>Productos
                            </a>
                        </li>
                        <li class="nav-item mb-2">
                            <a asp-controller="Home" asp-action="SobreNosotros" class="footer-link">
                                <i class="bi bi-info-circle-fill me-2"></i>Sobre nosotros
                            </a>
                        </li>
                        <li class="nav-item mb-2">
                            <a asp-controller="Cita" asp-action="Index" class="footer-link">
                                <i class="bi bi-calendar-check-fill me-2"></i>Citas
                            </a>
                        </li>
                        <li class="nav-item mb-2">
                            <a asp-controller="Articulo" asp-action="Index" class="footer-link">
                                <i class="bi bi-heart-pulse-fill me-2"></i>Salud & Bienestar
                            </a>
                        </li>
                    </ul>
                </div>

            </div>
        </div>

        <hr class="footer-divider">

        <div class="container">
            <div class="row align-items-center mb-2">
                <div class="col-12 text-center">
                    <small class="footer-copy">
                        Farmacia Santa Lucía de Barva © 2026. Todos los derechos reservados.
                    </small>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
            function actualizarContadorCarrito() {
                fetch('/carrito/contar')
                    .then(r => r.json())
                    .then(d => {
                        const badge = document.getElementById('carritoCount');
                        if (badge) badge.textContent = d.count;
                    })
                    .catch(() => {});
            }

            actualizarContadorCarrito();
    </script>
</body>
</html>