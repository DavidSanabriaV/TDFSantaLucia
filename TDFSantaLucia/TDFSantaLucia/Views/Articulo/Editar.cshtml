@* Views/Articulo/Editar.cshtml *@
@model TDFSantaLucia.Models.ArticuloSalud
@{
    ViewData["Title"] = "Editar Artículo";
}

<div class="container py-4" style="max-width:750px;">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <h2 class="fw-bold mb-4" style="color:#1a3c5e;">
                <i class="bi bi-pencil-square me-2 text-primary"></i>Editar Artículo
            </h2>

            @if (!ViewData.ModelState.IsValid && ViewContext.HttpContext.Request.Method == "POST")
            {
                <div class="alert alert-danger rounded-3 mb-4">
                    <h6 class="fw-bold mb-2">
                        <i class="bi bi-exclamation-triangle me-1"></i>Por favor corrija los siguientes errores:
                    </h6>
                    <ul class="mb-0">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form asp-action="Editar" asp-route-id="@Model.Articulo_Id" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Articulo_Id" />
                <input type="hidden" asp-for="Usuario_Id" />
                <input type="hidden" asp-for="Fecha_Creacion" />
                <input type="hidden" asp-for="Fecha_Actualizacion" />
                <input type="hidden" asp-for="Imagen_URL" />

                <div class="mb-3">
                    <label asp-for="Titulo" class="form-label fw-semibold">Título</label>
                    <input asp-for="Titulo" class="form-control rounded-3" placeholder="Título del artículo" />
                    <span asp-validation-for="Titulo" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Resumen" class="form-label fw-semibold">Resumen</label>
                    <input asp-for="Resumen" class="form-control rounded-3" placeholder="Breve descripción (opcional)" />
                </div>

                <div class="mb-3">
                    <label asp-for="Contenido" class="form-label fw-semibold">Contenido</label>
                    <textarea asp-for="Contenido" class="form-control rounded-3" rows="10"
                              placeholder="Contenido del artículo..."></textarea>
                    <span asp-validation-for="Contenido" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Imagen_Archivo" class="form-label fw-semibold">Imagen</label>

                    @if (!string.IsNullOrEmpty(Model.Imagen_URL))
                    {
                        <div class="mb-2">
                            <img id="imagenActual" src="@Model.Imagen_URL" class="img-fluid rounded-3"
                                 style="max-height:200px;" alt="Imagen actual" />
                            <div class="form-text">Imagen actual. Seleccione un archivo para reemplazarla.</div>
                        </div>
                    }

                    <input asp-for="Imagen_Archivo" type="file" id="imagenInput"
                           class="form-control rounded-3"
                           accept=".jpg,.jpeg,.png,.webp,.gif" />
                    <div class="form-text">JPG, PNG, WEBP o GIF. Máximo 5 MB.</div>
                    <span asp-validation-for="Imagen_Archivo" class="text-danger small"></span>
                    <img id="imagenPreview" class="img-fluid rounded-3 mt-2 d-none"
                         style="max-height:200px;" alt="Vista previa" />
                </div>

                <div class="mb-3">
                    <label asp-for="Categoria" class="form-label fw-semibold">Categoría</label>
                    <input asp-for="Categoria" class="form-control rounded-3" placeholder="Ej: Nutrición, Ejercicio..." />
                </div>

                <div class="mb-3">
                    <div class="form-check form-switch">
                        <input asp-for="Publicado" class="form-check-input" type="checkbox" />
                        <label asp-for="Publicado" class="form-check-label fw-semibold">Publicado</label>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Admin" class="btn rounded-3"
                       style="background-color:#d0e8f5; color:#2a7ab5; border:none;">
                        <i class="bi bi-arrow-left me-1"></i>Cancelar
                    </a>
                    <button type="submit" class="btn rounded-3" id="btnActualizar"
                            style="background-color:#fde8cc; color:#d4620a; border:none;">
                        <i class="bi bi-save me-1"></i>Actualizar
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('imagenInput').addEventListener('change', function (e) {
            const preview = document.getElementById('imagenPreview');
            const file = e.target.files[0];
            if (file) {
                preview.src = URL.createObjectURL(file);
                preview.classList.remove('d-none');
            } else {
                preview.classList.add('d-none');
            }
        });
    </script>
}