@model TDFSantaLucia.Models.ArticuloSalud
@{
    ViewData["Title"] = Model.Titulo;
    var userId = ViewBag.UserId as string;
    var dioLike = (bool)(ViewBag.UsuarioDioLike ?? false);
}

<div class="container py-5" style="max-width:800px;">

    @if (!string.IsNullOrEmpty(Model.Imagen_URL))
    {
        <img src="@Model.Imagen_URL"
             class="img-fluid rounded-4 mb-4 w-100"
             style="max-height:400px; object-fit:cover;"
             alt="@Model.Titulo">
    }

    @if (!string.IsNullOrEmpty(Model.Categoria))
    {
        <span class="badge rounded-pill mb-3"
              style="background:#243C8F;">
            @Model.Categoria
        </span>
    }

    <h1 class="fw-bold mb-2" style="color:#243C8F;">@Model.Titulo</h1>

    <div class="d-flex align-items-center gap-3 text-muted small mb-4">
        <span>
            <i class="bi bi-person-fill me-1"></i>
            @Model.Usuario?.Nombre @Model.Usuario?.Primer_Apellido
        </span>
        <span>
            <i class="bi bi-calendar3 me-1"></i>
            @Model.Fecha_Creacion.ToString("dd/MM/yyyy")
        </span>
    </div>

    <div class="fs-6 lh-lg mb-5" style="white-space: pre-line;">
        @Model.Contenido
    </div>

    <hr class="my-4">

    <div class="d-flex align-items-center gap-3 mb-5">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <button class="btn @(dioLike
                                                            ? "btn-danger"
                                                            : "btn-outline-danger") rounded-pill px-4"
                    id="btnLike"
                    onclick="toggleLike(@Model.Articulo_Id)">
                <i class="bi bi-heart@(dioLike ? "-fill" : "") me-1"
                   id="iconLike"></i>
                <span id="countLike">@Model.Likes.Count</span>
                Me gusta
            </button>
        }
        else
        {
            <span class="text-muted small">
                <i class="bi bi-heart me-1"></i>
                @Model.Likes.Count Me gusta —
                <a asp-controller="Account" asp-action="Login">
                    Inicia sesión para dar like
                </a>
            </span>
        }
    </div>

    <h5 class="fw-bold mb-3" style="color:#243C8F;">
        <i class="bi bi-chat-dots-fill me-2"></i>
        Comentarios (<span id="totalComentarios">
        @Model.Comentarios.Count
    </span>)
</h5>

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4">
        <div class="d-flex gap-3">
            <i class="bi bi-person-circle fs-3 text-muted mt-1"></i>
            <div class="flex-grow-1">
                <textarea id="nuevoComentario"
                          class="form-control border-0 bg-light rounded-3"
                          rows="2"
                          placeholder="Escribe un comentario..."></textarea>
                <div class="text-end mt-2">
                    <button class="btn btn-primary btn-sm rounded-3 px-4"
                            onclick="enviarComentario(@Model.Articulo_Id)">
                        <i class="bi bi-send me-1"></i>Comentar
                    </button>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-light rounded-3 mb-4">
        <a asp-controller="Account" asp-action="Login">
            Inicia sesión
        </a> para comentar.
    </div>
}

<div id="listaComentarios">
    @foreach (var c in Model.Comentarios
        .OrderByDescending(c => c.Fecha_Creacion))
    {
        <div class="d-flex gap-3 mb-3 comentario-item"
             id="comentario-@c.Comentario_Id">
            <i class="bi bi-person-circle fs-3 text-muted mt-1"></i>
            <div class="flex-grow-1">
                <div class="card border-0 bg-light rounded-4 p-3">
                    <div class="d-flex justify-content-between
                        align-items-start mb-1">
                        <span class="fw-semibold small">
                            @c.Usuario?.Nombre @c.Usuario?.Primer_Apellido
                        </span>
                        <div class="d-flex align-items-center gap-2">
                            <small class="text-muted">
                                @c.Fecha_Creacion.ToString("dd/MM/yyyy HH:mm")
                            </small>
                            @if (userId == c.Usuario_Id ||
                                 User.IsInRole("Admin"))
                            {
                                <button class="btn btn-link btn-sm
                                    text-danger p-0"
                                        onclick="eliminarComentario(@c.Comentario_Id)"
                                        title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </button>
                            }
                        </div>
                    </div>
                    <p class="mb-0 small">@c.Contenido</p>
                </div>
            </div>
        </div>
    }
</div>

<div class="mt-4">
    <a asp-action="Index" class="btn btn-outline-secondary rounded-3">
        <i class="bi bi-arrow-left me-1"></i>Volver
    </a>
</div>
</div>

@section Scripts {
    <script>
        const antiForgery = document.querySelector(
            'input[name="__RequestVerificationToken"]')?.value ?? '';

        async function toggleLike(articuloId) {
            const resp = await fetch(`/salud/like/${articuloId}`, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': antiForgery,
                    'Content-Type': 'application/json'
                }
            });
            const data = await resp.json();
            if (!data.exito) return;

            const btn  = document.getElementById('btnLike');
            const icon = document.getElementById('iconLike');
            document.getElementById('countLike').textContent = data.totalLikes;

            if (data.usuarioDioLike) {
                btn.classList.replace('btn-outline-danger', 'btn-danger');
                icon.className = 'bi bi-heart-fill me-1';
            } else {
                btn.classList.replace('btn-danger', 'btn-outline-danger');
                icon.className = 'bi bi-heart me-1';
            }
        }

        async function enviarComentario(articuloId) {
            const textarea  = document.getElementById('nuevoComentario');
            const contenido = textarea.value.trim();
            if (!contenido) return;

            const form = new FormData();
            form.append('contenido', contenido);
            form.append('__RequestVerificationToken', antiForgery);

            const resp = await fetch(`/salud/comentar/${articuloId}`, {
                method: 'POST',
                body: form
            });
            const data = await resp.json();
            if (!data.exito) {
                alert(data.error);
                return;
            }

            textarea.value = '';
            const total = parseInt(
                document.getElementById('totalComentarios').textContent) + 1;
            document.getElementById('totalComentarios').textContent = total;

            const html = `
                <div class="d-flex gap-3 mb-3 comentario-item"
                     id="comentario-${data.comentarioId}">
                    <i class="bi bi-person-circle fs-3 text-muted mt-1"></i>
                    <div class="flex-grow-1">
                        <div class="card border-0 bg-light rounded-4 p-3">
                            <div class="d-flex justify-content-between
                                        align-items-start mb-1">
                                <span class="fw-semibold small">${data.nombre}</span>
                                <div class="d-flex align-items-center gap-2">
                                    <small class="text-muted">${data.fecha}</small>
                                    <button class="btn btn-link btn-sm text-danger p-0"
                                            onclick="eliminarComentario(${data.comentarioId})"
                                            title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                            <p class="mb-0 small">${data.contenido}</p>
                        </div>
                    </div>
                </div>`;

            document.getElementById('listaComentarios')
                .insertAdjacentHTML('afterbegin', html);
        }

        async function eliminarComentario(comentarioId) {
            if (!confirm('¿Eliminar este comentario?')) return;

            const form = new FormData();
            form.append('__RequestVerificationToken', antiForgery);

            const resp = await fetch(
                `/salud/comentario/eliminar/${comentarioId}`,
                { method: 'POST', body: form });
            const data = await resp.json();

            if (!data.exito) { alert(data.error); return; }

            document.getElementById(`comentario-${comentarioId}`)?.remove();
            const total = parseInt(
                document.getElementById('totalComentarios').textContent) - 1;
            document.getElementById('totalComentarios').textContent = total;
        }
    </script>
    @Html.AntiForgeryToken()
}