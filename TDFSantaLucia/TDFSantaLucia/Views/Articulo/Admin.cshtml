@model List<TDFSantaLucia.Models.ArticuloSalud>
@{
    ViewData["Title"] = "Gestión de Artículos";
    var intentLabels = new Dictionary<string, string>();
}

<style>
    .table-responsive {
        overflow: visible !important;
    }
</style>

<div class="container-fluid px-4 py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-1" style="color:#1a3c5e;">
                <i class="bi bi-journal-richtext me-2 text-primary"></i>Artículos de Salud
            </h2>
            <p class="text-muted mb-0">Gestiona los artículos de Salud & Bienestar</p>
        </div>
        <a asp-action="Crear" class="btn btn-success rounded-3 shadow-sm">
            <i class="bi bi-plus-lg me-1"></i>Nuevo artículo
        </a>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4">
            <i class="bi bi-check-circle me-2"></i>@TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Título</th>
                    <th>Categoría</th>
                    <th>Autor</th>
                    <th class="text-center">Likes</th>
                    <th class="text-center">Comentarios</th>
                    <th class="text-center">Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td class="fw-semibold">@a.Titulo</td>
                        <td>
                            @if (!string.IsNullOrEmpty(a.Categoria))
                            {
                                <span class="badge rounded-pill" style="background:#243C8F;">
                                    @a.Categoria
                                </span>
                            }
                        </td>
                        <td class="small text-muted">
                            @a.Usuario?.Nombre @a.Usuario?.Primer_Apellido
                        </td>
                        <td class="text-center">
                            <i class="bi bi-heart-fill text-danger me-1"></i>
                            @a.Likes.Count
                        </td>
                        <td class="text-center">
                            <i class="bi bi-chat me-1"></i>
                            @a.Comentarios.Count
                        </td>
                        <td class="text-center">
                            <form asp-action="TogglePublicado"
                                  asp-route-id="@a.Articulo_Id"
                                  method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="btn btn-sm @(a.Publicado ? "btn-success-subtle text-success border border-success-subtle" : "btn-outline-secondary") rounded-pill">
                                    @(a.Publicado ? "Publicado" : "Borrador")
                                </button>
                            </form>
                        </td>
                        <td class="text-center">
                            <div class="dropdown">
                                <button class="btn btn-outline-secondary btn-sm rounded-3"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu shadow rounded-3">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-action="Detalle" asp-route-id="@a.Articulo_Id">
                                            <i class="bi bi-eye me-2" style="color:#6baed6;"></i>Ver detalle
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item"
                                           asp-action="Editar" asp-route-id="@a.Articulo_Id">
                                            <i class="bi bi-pencil me-2" style="color:#fd8d3c;"></i>Editar
                                        </a>
                                    </li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form asp-action="Eliminar" asp-route-id="@a.Articulo_Id"
                                                  method="post"
                                                  onsubmit="return confirm('¿Eliminar artículo?')">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="dropdown-item">
                                                    <i class="bi bi-trash me-2" style="color:#e57373;"></i>Eliminar
                                                </button>
                                            </form>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>