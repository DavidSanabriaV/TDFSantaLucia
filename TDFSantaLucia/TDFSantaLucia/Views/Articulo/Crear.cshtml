@model TDFSantaLucia.Models.ArticuloSalud
@{
    ViewData["Title"] = "Nuevo Artículo";
}

<div class="container py-4" style="max-width:750px;">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <h2 class="fw-bold mb-4" style="color:#1a3c5e;">
                <i class="bi bi-journal-plus me-2 text-primary"></i>Nuevo Artículo
            </h2>

            @if (!ViewData.ModelState.IsValid && ViewContext.HttpContext.Request.Method == "POST")
            {
                <div class="alert alert-danger rounded-3 mb-4">
                    <h6 class="fw-bold mb-2">
                        <i class="bi bi-exclamation-triangle me-1"></i>Por favor corrija los siguientes errores:
                    </h6>
                    <ul class="mb-0">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form asp-action="Crear" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="Titulo" class="form-label fw-semibold">Título</label>
                    <input asp-for="Titulo" class="form-control rounded-3" placeholder="Título del artículo" />
                    <span asp-validation-for="Titulo" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Resumen" class="form-label fw-semibold">Resumen</label>
                    <input asp-for="Resumen" class="form-control rounded-3" placeholder="Breve descripción (opcional)" />
                </div>

                <div class="mb-3">
                    <label asp-for="Contenido" class="form-label fw-semibold">Contenido</label>
                    <textarea asp-for="Contenido" class="form-control rounded-3" rows="10"
                              placeholder="Contenido del artículo..."></textarea>
                    <span asp-validation-for="Contenido" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Imagen_URL" class="form-label fw-semibold">URL de imagen</label>
                    <input asp-for="Imagen_URL" class="form-control rounded-3" placeholder="https://..." />
                </div>

                <div class="mb-3">
                    <label asp-for="Categoria" class="form-label fw-semibold">Categoría</label>
                    <input asp-for="Categoria" class="form-control rounded-3" placeholder="Ej: Nutrición, Ejercicio..." />
                </div>

                <div class="mb-3">
                    <div class="form-check form-switch">
                        <input asp-for="Publicado" class="form-check-input" type="checkbox" />
                        <label asp-for="Publicado" class="form-check-label fw-semibold">Publicado</label>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Admin" class="btn rounded-3"
                       style="background-color:#d0e8f5; color:#2a7ab5; border:none;">
                        <i class="bi bi-arrow-left me-1"></i>Cancelar
                    </a>
                    <button type="submit" class="btn rounded-3" id="btnGuardar"
                            style="background-color:#d4edda; color:#2d7a4f; border:none;">
                        <i class="bi bi-save me-1"></i>Guardar
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}