@model TDFSantaLucia.Models.Factura
@{
    ViewData["Title"] = $"Factura {Model.Numero_Factura}";
    var cliente = Model.Cliente?.Usuario;
}

<div class="container py-4" style="max-width:800px;">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold" style="color:#243C8F;">
            <i class="bi bi-receipt me-2"></i>@Model.Numero_Factura
        </h2>
        <a asp-action="Descargar" asp-route-id="@Model.Factura_Id"
               class="btn btn-primary rounded-3">
            <i class="bi bi-download me-1"></i>Descargar
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
        <div class="row g-3">
            <div class="col-md-6">
                <div class="fw-bold fs-5" style="color:#243C8F;">
                    Farmacia Santa Lucía
                </div>
                <div class="text-muted small">
                    Santa Lucía de Barva, Heredia, Costa Rica<br>
                    Tel: 2237-3040<br>
                    farmasantalucia@ice.co.cr
                </div>
            </div>
            <div class="col-md-6 text-md-end">
                <div class="text-muted small">
                    Pedido:
                    <strong>@Model.Pedido?.Numero_Orden</strong>
                </div>
                <div class="text-muted small">
                    Emitida: @Model.Fecha_Emision.ToString("dd/MM/yyyy HH:mm")
                </div>
                <span class="badge bg-success mt-1">@Model.Estado</span>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
        <h5 class="fw-bold mb-3" style="color:#243C8F;">
            Datos del cliente
        </h5>
        <div class="row g-2">
            <div class="col-md-6">
                <small class="text-muted">Nombre</small>
                <div class="fw-semibold">
                    @cliente?.Nombre @cliente?.Primer_Apellido
                    @cliente?.Segundo_Apellido
                </div>
            </div>
            <div class="col-md-6">
                <small class="text-muted">Cédula</small>
                <div>@(cliente?.Cedula ?? "—")</div>
            </div>
            <div class="col-md-6">
                <small class="text-muted">Correo</small>
                <div>@(cliente?.Email ?? "—")</div>
            </div>
            <div class="col-md-6">
                <small class="text-muted">Teléfono</small>
                <div>@(cliente?.Telefono ?? "—")</div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <table class="table align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Producto</th>
                    <th class="text-center">Cantidad</th>
                    <th class="text-end">Precio unit.</th>
                    <th class="text-end">Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.DetallesFactura)
                {
                    <tr>
                        <td class="fw-semibold">@d.Producto?.Nombre</td>
                        <td class="text-center">@d.Cantidad</td>
                        <td class="text-end">₡@d.Precio_Unitario.ToString("N2")</td>
                        <td class="text-end">₡@d.Subtotal.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4">
        <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">Subtotal</span>
            <span>₡@Model.Subtotal.ToString("N2")</span>
        </div>
        <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">IVA (13%)</span>
            <span>₡@Model.Impuesto.ToString("N2")</span>
        </div>
        @if (Model.Pedido?.Uso_Puntos == true)
        {
            <div class="alert alert-warning rounded-3 mb-3">
                <i class="bi bi-star-fill me-1"></i>
                Se utilizaron
                <strong>
                    @Model.Pedido.Puntos_Canjeados puntos
                </strong>
                en esta compra.
            </div>
        }
        <hr />
        <div class="d-flex justify-content-between fw-bold fs-4">
            <span>Total</span>
            <span style="color:#243C8F;">₡@Model.Total.ToString("N2")</span>
        </div>
    </div>

    <div class="d-flex gap-2 mt-4">
        <a asp-controller="Pedido" asp-action="MisPedidos"
               class="btn btn-outline-secondary rounded-3">
            <i class="bi bi-arrow-left me-1"></i>Volver
        </a>
        <a asp-action="Descargar" asp-route-id="@Model.Factura_Id"
               class="btn btn-primary rounded-3">
            <i class="bi bi-download me-1"></i>Descargar factura
        </a>
    </div>
</div>