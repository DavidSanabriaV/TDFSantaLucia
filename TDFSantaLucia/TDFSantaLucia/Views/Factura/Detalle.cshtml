@model TDFSantaLucia.Models.Factura
@{
    ViewData["Title"] = $"Factura {Model.Numero_Factura}";
    var cliente = Model.Cliente?.Usuario;
    var pedido = Model.Pedido;
    var descuentoTotal = Model.Descuento;
    var descuentoPuntos = pedido?.Descuento_Puntos ?? 0;
    var descuentoCupon = descuentoTotal - descuentoPuntos;
}

<div class="container py-4" style="max-width:800px;">

    <div class="mb-4">
        <h2 class="fw-bold" style="color:#1a3c5e;">
            <i class="bi bi-receipt me-2 text-primary"></i>@Model.Numero_Factura
        </h2>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
        <div class="row g-3">
            <div class="col-md-6">
                <div class="fw-bold fs-5" style="color:#1a3c5e;">Farmacia Santa Lucía</div>
                <div class="text-muted small">
                    Santa Lucía de Barva, Heredia, Costa Rica<br>
                    Tel: 2237-3040<br>
                    farmasantalucia@ice.co.cr
                </div>
            </div>
            <div class="col-md-6 text-md-end">
                <div class="text-muted small">
                    Pedido: <strong>@pedido?.Numero_Orden</strong>
                </div>
                <div class="text-muted small">
                    Emitida: @Model.Fecha_Emision.ToString("dd/MM/yyyy HH:mm")
                </div>
                <span class="badge bg-success-subtle text-success border border-success-subtle mt-1">
                    @Model.Estado
                </span>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
        <h5 class="fw-bold mb-3" style="color:#1a3c5e;">Datos del cliente</h5>
        <div class="row g-2">
            <div class="col-md-6">
                <small class="text-muted">NOMBRE</small>
                <div class="fw-semibold">
                    @cliente?.Nombre @cliente?.Primer_Apellido @cliente?.Segundo_Apellido
                </div>
            </div>
            <div class="col-md-6">
                <small class="text-muted">CÉDULA</small>
                <div class="fw-semibold">@(cliente?.Cedula ?? "—")</div>
            </div>
            <div class="col-md-6">
                <small class="text-muted">CORREO</small>
                <div class="fw-semibold">@(cliente?.Email ?? "—")</div>
            </div>
            <div class="col-md-6">
                <small class="text-muted">TELÉFONO</small>
                <div class="fw-semibold">@(cliente?.Telefono ?? "—")</div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Producto</th>
                        <th class="text-center">Cantidad</th>
                        <th class="text-end">Precio unit.</th>
                        <th class="text-end">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.DetallesFactura)
                    {
                        <tr>
                            <td class="fw-semibold">@d.Producto?.Nombre</td>
                            <td class="text-center">@d.Cantidad</td>
                            <td class="text-end text-muted">₡@d.Precio_Unitario.ToString("N2")</td>
                            <td class="text-end fw-semibold">₡@d.Subtotal.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4">
        <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">Subtotal</span>
            <span>₡@Model.Subtotal.ToString("N2")</span>
        </div>
        <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">IVA (13%)</span>
            <span>₡@Model.Impuesto.ToString("N2")</span>
        </div>

        @if (pedido?.Uso_Puntos == true && descuentoPuntos > 0)
        {
            <div class="d-flex justify-content-between mb-2 text-danger">
                <span>
                    <i class="bi bi-star-fill me-1"></i>
                    Descuento por puntos (@pedido.Puntos_Canjeados pts)
                </span>
                <span class="fw-bold">-₡@descuentoPuntos.ToString("N2")</span>
            </div>
        }

        @if (pedido?.Cupon != null && descuentoCupon > 0)
        {
            <div class="d-flex justify-content-between mb-2 text-success">
                <span>
                    <i class="bi bi-ticket-perforated-fill me-1"></i>
                    Cupón: @pedido.Cupon.Descripcion
                    @if (pedido.Cupon.Tipo_Descuento == "Porcentaje")
                    {
                        <span class="badge bg-info-subtle text-info border border-info-subtle ms-1">@pedido.Cupon.Valor_Descuento:G29}%</span>
                    }
                    else
                    {
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-1">Monto fijo</span>
                    }
                </span>
                <span class="fw-bold">-₡@descuentoCupon.ToString("N2")</span>
            </div>
        }

        @if (descuentoTotal > 0)
        {
            <hr />
            <div class="d-flex justify-content-between mb-2 fw-semibold">
                <span class="text-muted">Total descuentos</span>
                <span class="text-danger">-₡@descuentoTotal.ToString("N2")</span>
            </div>
        }

        <hr />
        <div class="d-flex justify-content-between fw-bold fs-4">
            <span>Total</span>
            <span style="color:#1a3c5e;">₡@Model.Total.ToString("N2")</span>
        </div>
    </div>

    <div class="d-flex justify-content-between mt-4">
        <a asp-controller="Factura" asp-action="MisFacturas"
           class="btn rounded-3"
           style="background-color:#d0e8f5; color:#2a7ab5; border:none;">
            <i class="bi bi-arrow-left me-1"></i>Volver
        </a>
        <a asp-action="Descargar" asp-route-id="@Model.Factura_Id"
           class="btn rounded-3"
           style="background-color:#d4edda; color:#2d7a4f; border:none;">
            <i class="bi bi-download me-1"></i>Descargar factura
        </a>
    </div>

</div>