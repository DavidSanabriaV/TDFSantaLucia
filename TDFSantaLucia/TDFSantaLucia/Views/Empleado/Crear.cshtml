@model TDFSantaLucia.Models.EmpleadoViewModel
@{
    ViewData["Title"] = "Crear Empleado";
}

<div class="container py-4" style="max-width:750px;">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <h2 class="fw-bold mb-4" style="color:#1a3c5e;">
                <i class="bi bi-person-plus-fill me-2 text-primary"></i>Nuevo Empleado
            </h2>

            @if (!ViewData.ModelState.IsValid && ViewContext.HttpContext.Request.Method == "POST")
            {
                <div class="alert alert-danger rounded-3 mb-4">
                    <h6 class="fw-bold mb-2">
                        <i class="bi bi-exclamation-triangle me-1"></i>Por favor corrija los siguientes errores:
                    </h6>
                    <ul class="mb-0">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form asp-action="Crear" method="post">
                @Html.AntiForgeryToken()

                <h6 class="fw-bold text-muted mb-3">DATOS PERSONALES</h6>
                <div class="row g-3">

                    <div class="col-md-4">
                        <label asp-for="Nombre" class="form-label fw-semibold">Nombre</label>
                        <input asp-for="Nombre" class="form-control rounded-3" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Primer_Apellido" class="form-label fw-semibold">Primer Apellido</label>
                        <input asp-for="Primer_Apellido" class="form-control rounded-3" />
                        <span asp-validation-for="Primer_Apellido" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Segundo_Apellido" class="form-label fw-semibold">Segundo Apellido</label>
                        <input asp-for="Segundo_Apellido" class="form-control rounded-3" />
                        <span asp-validation-for="Segundo_Apellido" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Cedula" class="form-label fw-semibold">Cédula</label>
                        <input asp-for="Cedula"
                               class="form-control rounded-3"
                               maxlength="9"
                               placeholder="000000000"
                               oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0,9)" />
                        <span asp-validation-for="Cedula" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Telefono" class="form-label fw-semibold">Teléfono</label>
                        <input asp-for="Telefono"
                               class="form-control rounded-3"
                               maxlength="8"
                               placeholder="00000000"
                               oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0,8)" />
                        <span asp-validation-for="Telefono" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Direccion_Exacta" class="form-label fw-semibold">Dirección</label>
                        <input asp-for="Direccion_Exacta" class="form-control rounded-3" />
                    </div>

                </div>

                <h6 class="fw-bold text-muted mb-3 mt-4">ACCESO</h6>
                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold">Correo</label>
                        <input asp-for="Email" class="form-control rounded-3" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="password" class="form-label fw-semibold">Contraseña</label>
                        <div class="input-group">
                            <input asp-for="password"
                                   type="text"
                                   class="form-control rounded-start-3"
                                   id="passwordInput"
                                   autocomplete="new-password" />
                            <button type="button"
                                    class="btn btn-outline-secondary rounded-end-3"
                                    onclick="togglePassword()">
                                <i class="bi bi-eye" id="iconoOjo"></i>
                            </button>
                        </div>
                        <span asp-validation-for="password" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="rol" class="form-label fw-semibold">Rol</label>
                        <select asp-for="rol"
                                asp-items='new SelectList(ViewBag.Roles)'
                                class="form-select rounded-3">
                            <option value="">Seleccione un rol</option>
                        </select>
                        <span asp-validation-for="rol" class="text-danger small"></span>
                    </div>

                </div>

                <h6 class="fw-bold text-muted mb-3 mt-4">DATOS LABORALES</h6>
                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="Puesto" class="form-label fw-semibold">Puesto</label>
                        <input asp-for="Puesto" class="form-control rounded-3" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="SalarioBruto" class="form-label fw-semibold">Salario Bruto</label>
                        <div class="input-group">
                            <span class="input-group-text rounded-start-3">₡</span>
                            <input asp-for="SalarioBruto"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control rounded-end-3" />
                        </div>
                        <span asp-validation-for="SalarioBruto" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <div class="form-check form-switch mt-2">
                            <input asp-for="Estado" class="form-check-input" />
                            <label asp-for="Estado" class="form-check-label fw-semibold">Activo</label>
                        </div>
                    </div>

                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-3">
                        <i class="bi bi-arrow-left me-1"></i>Volver
                    </a>
                    <button type="submit" class="btn btn-success rounded-3" id="btnGuardar">
                        <i class="bi bi-save me-1"></i>Guardar
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

<script>
    document.getElementById('passwordInput').type = 'password';

    function togglePassword() {
        const input = document.getElementById('passwordInput');
        const icono = document.getElementById('iconoOjo');
        if (input.type === 'password') {
            input.type = 'text';
            icono.classList.replace('bi-eye', 'bi-eye-slash');
        } else {
            input.type = 'password';
            icono.classList.replace('bi-eye-slash', 'bi-eye');
        }
    }

    document.querySelector('form').addEventListener('submit', function () {
        const btn = document.getElementById('btnGuardar');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Guardando...';
    });
</script>

<style>
    input[type="password"]::-ms-reveal,
    input[type="password"]::-ms-clear {
        display: none;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}