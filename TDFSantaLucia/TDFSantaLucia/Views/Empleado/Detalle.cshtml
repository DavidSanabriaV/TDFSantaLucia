@model TDFSantaLucia.Models.EmpleadoViewModel
@{
    ViewData["Title"] = "Detalle Empleado";
}

<div class="container py-4" style="max-width:750px;">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <h2 class="fw-bold mb-4" style="color:#1a3c5e;">
                <i class="bi bi-person-fill me-2 text-primary"></i>Detalle del Empleado
            </h2>

            <div class="d-flex align-items-center gap-3 mb-4">
                <div>
                    <h4 class="fw-bold mb-0" style="color:#1a3c5e;">
                        @Model.Nombre @Model.Primer_Apellido @Model.Segundo_Apellido
                    </h4>
                    <small class="text-muted">@Model.UserName — @Model.rol</small>
                </div>
                <div class="ms-auto">
                    @if (Model.Estado)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle fs-6">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle fs-6">Inactivo</span>
                    }
                </div>
            </div>

            <hr />

            <div class="row g-4">
                <div class="col-md-6">
                    <p class="text-muted small mb-1">CÉDULA</p>
                    <p class="fw-semibold">@(Model.Cedula ?? "—")</p>
                </div>
                <div class="col-md-6">
                    <p class="text-muted small mb-1">CORREO</p>
                    <p class="fw-semibold">@(Model.Email ?? "—")</p>
                </div>
                <div class="col-md-6">
                    <p class="text-muted small mb-1">TELÉFONO</p>
                    <p class="fw-semibold">@(Model.Telefono ?? "—")</p>
                </div>
                <div class="col-md-6">
                    <p class="text-muted small mb-1">DIRECCIÓN</p>
                    <p class="fw-semibold">@(Model.Direccion_Exacta ?? "—")</p>
                </div>
                <div class="col-md-6">
                    <p class="text-muted small mb-1">PUESTO</p>
                    <p class="fw-semibold">@(Model.Puesto ?? "—")</p>
                </div>
                <div class="col-md-3">
                    <p class="text-muted small mb-1">SALARIO BRUTO</p>
                    <p class="fw-semibold text-success">₡@Model.SalarioBruto?.ToString("N2")</p>
                </div>
                <div class="col-md-3">
                    <p class="text-muted small mb-1">SALARIO NETO</p>
                    <p class="fw-semibold text-primary">₡@Model.SalarioNeto?.ToString("N2")</p>
                </div>
            </div>

            <hr />

            <h6 class="fw-bold text-muted mb-3">CONTACTOS DE EMERGENCIA</h6>
            @if (Model.ContactosEmergencia.Any())
            {
                <ul class="list-group mb-4">
                    @foreach (var c in Model.ContactosEmergencia)
                    {
                        <li class="list-group-item">
                            <strong>@c.Nombre</strong> — @c.Telefono
                            @if (!string.IsNullOrWhiteSpace(c.Parentesco))
                            {
                                <span class="text-muted"> (@c.Parentesco)</span>
                            }
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted mb-4">No hay contactos de emergencia registrados.</p>
            }

            <h6 class="fw-bold text-muted mb-3">ALERGIAS</h6>
            @if (Model.Alergias.Any())
            {
                <ul class="list-group mb-4">
                    @foreach (var a in Model.Alergias)
                    {
                        <li class="list-group-item">@a.Descripcion</li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted mb-4">No hay alergias registradas.</p>
            }

            <h6 class="fw-bold text-muted mb-3">ENFERMEDADES</h6>
            @if (Model.Enfermedades.Any())
            {
                <ul class="list-group mb-4">
                    @foreach (var e in Model.Enfermedades)
                    {
                        <li class="list-group-item">@e.Descripcion</li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted mb-4">No hay enfermedades registradas.</p>
            }

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn rounded-3"
                   style="background-color:#d0e8f5; color:#2a7ab5; border:none;">
                    <i class="bi bi-arrow-left me-1"></i>Volver
                </a>
                <a asp-action="Editar" asp-route-id="@Model.Empleado_Id"
                   class="btn rounded-3"
                   style="background-color:#fde8cc; color:#d4620a; border:none;">
                    <i class="bi bi-pencil me-1"></i>Editar
                </a>
            </div>

        </div>
    </div>
</div>