@model TDFSantaLucia.Models.TratamientoViewModel
@{
    ViewData["Title"] = "Nuevo Tratamiento";
}

<div class="container py-4" style="max-width:700px;">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <h2 class="fw-bold mb-4" style="color:#1a3c5e;">
                <i class="bi bi-capsule me-2 text-primary"></i>Nuevo Tratamiento
            </h2>

            @if (!ViewData.ModelState.IsValid && ViewContext.HttpContext.Request.Method == "POST")
            {
                <div class="alert alert-danger rounded-3 mb-4">
                    <h6 class="fw-bold mb-2">
                        <i class="bi bi-exclamation-triangle me-1"></i>Corrija los siguientes errores:
                    </h6>
                    <ul class="mb-0">
                        @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@e.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form asp-action="Crear" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-3">

                    <div class="col-12">
                        <label class="form-label fw-semibold">Nombre del medicamento</label>
                        <input asp-for="Nombre_Medicamento" class="form-control rounded-3"
                               placeholder="Ej: Metformina 500mg" />
                        <span asp-validation-for="Nombre_Medicamento" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Dosis</label>
                        <input asp-for="Dosis" class="form-control rounded-3"
                               placeholder="Ej: 1 tableta" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Duración</label>
                        <input asp-for="Duracion" class="form-control rounded-3"
                               placeholder="Ej: 30 días" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Fecha de inicio</label>
                        <input asp-for="Fecha_Inicio" type="date" class="form-control rounded-3"
                               value="@Model.Fecha_Inicio.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="Fecha_Inicio" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Fecha de fin</label>
                        <input asp-for="Fecha_Fin" type="date" class="form-control rounded-3"
                               value="@Model.Fecha_Fin.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="Fecha_Fin" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input asp-for="Alertas_Activas" class="form-check-input"
                                   type="checkbox" checked />
                            <label asp-for="Alertas_Activas" class="form-check-label fw-semibold">
                                <i class="bi bi-bell me-1"></i>Activar alertas de recordatorio
                            </label>
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">Horarios de recordatorio</label>
                        <div id="contenedorHorarios">
                            <div class="input-group mb-2">
                                <span class="input-group-text bg-white">
                                    <i class="bi bi-clock text-muted"></i>
                                </span>
                                <input type="time" name="horarios"
                                       class="form-control rounded-end-3" value="08:00" />
                                <button type="button"
                                        class="btn btn-outline-danger rounded-end-3"
                                        onclick="quitarHorario(this)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                        <button type="button"
                                class="btn btn-sm rounded-3 mb-1"
                                style="background-color:#d0e8f5; color:#2a7ab5; border:none;"
                                onclick="agregarHorario()">
                            <i class="bi bi-plus-circle me-1"></i>Agregar horario
                        </button>
                        <small class="text-muted d-block mt-1">
                            Agrega un horario por cada toma del día.
                        </small>
                    </div>

                    <div class="col-12 d-flex justify-content-between mt-2">
                        <a asp-action="Index" class="btn rounded-3"
                           style="background-color:#d0e8f5; color:#2a7ab5; border:none;">
                            <i class="bi bi-arrow-left me-1"></i>Cancelar
                        </a>
                        <button type="submit" class="btn rounded-3" id="btnGuardar"
                                style="background-color:#d4edda; color:#2d7a4f; border:none;">
                            <i class="bi bi-save me-1"></i>Guardar
                        </button>
                    </div>

                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function agregarHorario() {
            const div = document.createElement('div');
            div.className = 'input-group mb-2';
            div.innerHTML = `
                <span class="input-group-text bg-white">
                    <i class="bi bi-clock text-muted"></i>
                </span>
                <input type="time" name="horarios"
                       class="form-control rounded-end-3" value="08:00" />
                <button type="button" class="btn btn-outline-danger rounded-end-3"
                        onclick="quitarHorario(this)">
                    <i class="bi bi-trash"></i>
                </button>`;
            document.getElementById('contenedorHorarios').appendChild(div);
        }

        function quitarHorario(btn) {
            const contenedor = document.getElementById('contenedorHorarios');
            if (contenedor.children.length > 1)
                btn.closest('.input-group').remove();
            else
                alert('Debe tener al menos un horario.');
        }

        document.querySelector('form').addEventListener('submit', function () {
            const btn = document.getElementById('btnGuardar');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Guardando...';
        });
    </script>
    <partial name="_ValidationScriptsPartial" />
}