@model List<TDFSantaLucia.Models.Inventario>
@{
    ViewData["Title"] = "Inventario";

    var todosParaJs = Model.Select(i => new
    {
        inventario_Id = i.Inventario_Id,
        numero_Lote = i.Numero_Lote ?? "",
        producto = i.Producto?.Nombre ?? "",
        proveedor = i.Proveedor ?? "",
        cantidad_Disponible = i.Cantidad_Disponible,
        cantidad_Minima = i.Cantidad_Minima,
        fecha_Vencimiento = i.Fecha_Vencimiento.ToString("yyyy-MM-dd"),
        fecha_Ingreso = i.Fecha_Ingreso.ToString("yyyy-MM-dd"),
        estado = i.Estado,
        stockBajo = i.Cantidad_Disponible <= i.Cantidad_Minima,
        diasParaVencer = (i.Fecha_Vencimiento - DateTime.Today).Days
    });
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-1" style="color:#1a3c5e;">
                <i class="bi bi-box-seam-fill me-2 text-primary"></i>
                Gestión de Inventario
            </h2>
            <p class="text-muted mb-0">Control de lotes, stock y vencimientos</p>
        </div>
        <a asp-action="Crear" class="btn btn-success rounded-3 shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Nuevo lote
        </a>
    </div>

    @if (TempData["ExitoInventario"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4">
            <i class="bi bi-check-circle me-2"></i>@TempData["ExitoInventario"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorInventario"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorInventario"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (ViewBag.TotalStockBajo > 0)
    {
        <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center gap-2 rounded-3 shadow-sm">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>
                <strong>⚠️ Stock bajo:</strong> hay @ViewBag.TotalStockBajo lote(s) con cantidad por debajo del mínimo.
                <a href="/inventario/stock-bajo" class="alert-link ms-1">Ver lotes</a>
            </div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (ViewBag.TotalProximosVencer > 0)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 rounded-3 shadow-sm">
            <i class="bi bi-calendar-x-fill fs-5"></i>
            <div>
                <strong>🗓️ Próximos a vencer:</strong> hay @ViewBag.TotalProximosVencer lote(s) que vencen en los próximos 30 días.
                <a href="/inventario/proximos-vencer" class="alert-link ms-1">Ver lotes</a>
            </div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-muted small">BUSCAR</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" id="buscador"
                               class="form-control border-start-0 ps-0"
                               placeholder="Producto, lote o proveedor..." />
                        <button class="btn btn-outline-secondary" id="btnLimpiarTexto"
                                type="button" style="display:none;">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold text-muted small">ESTADO</label>
                    <select id="filtroEstado" class="form-select rounded-3">
                        <option value="">Todos</option>
                        <option value="true">✅ Activo</option>
                        <option value="false">❌ Inactivo</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold text-muted small">STOCK</label>
                    <select id="filtroStock" class="form-select rounded-3">
                        <option value="">Todos</option>
                        <option value="bajo">⚠️ Stock bajo</option>
                        <option value="ok">✅ Stock OK</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold text-muted small">VENCIMIENTO</label>
                    <select id="filtroVencimiento" class="form-select rounded-3">
                        <option value="">Todos</option>
                        <option value="30">Próximos 30 días</option>
                        <option value="60">Próximos 60 días</option>
                        <option value="90">Próximos 90 días</option>
                    </select>
                </div>
                <div class="col-md-2 text-end">
                    <button id="btnLimpiarFiltros" class="btn btn-outline-secondary w-100 rounded-3" style="display:none;">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Limpiar filtros
                    </button>
                </div>
            </div>

            <div class="d-flex gap-2 mt-3 flex-wrap align-items-center">
                <span id="chipTexto" class="badge bg-primary d-none">
                    <span id="chipTextoLabel"></span>
                    <button type="button" class="btn-close btn-close-white btn-sm ms-1"
                            id="btnRemoveTexto" style="font-size:0.6rem;"></button>
                </span>
                <span id="chipEstado" class="badge bg-info text-dark d-none">
                    <span id="chipEstadoLabel"></span>
                    <button type="button" class="btn-close btn-sm ms-1"
                            id="btnRemoveEstado" style="font-size:0.6rem;"></button>
                </span>
                <span id="chipStock" class="badge bg-warning text-dark d-none">
                    <span id="chipStockLabel"></span>
                    <button type="button" class="btn-close btn-sm ms-1"
                            id="btnRemoveStock" style="font-size:0.6rem;"></button>
                </span>
                <span id="chipVencimiento" class="badge bg-danger d-none">
                    <span id="chipVencimientoLabel"></span>
                    <button type="button" class="btn-close btn-close-white btn-sm ms-1"
                            id="btnRemoveVencimiento" style="font-size:0.6rem;"></button>
                </span>
                <small id="contadorResultados" class="text-muted ms-auto"></small>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Producto</th>
                    <th>Lote</th>
                    <th>Proveedor</th>
                    <th class="text-center">Disponible</th>
                    <th class="text-center">Mínimo</th>
                    <th class="text-center">F. Ingreso</th>
                    <th class="text-center">F. Vencimiento</th>
                    <th class="text-center">Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody id="tablaInventario">
                @{
                    int fila = 1;
                }
                @foreach (var i in Model)
                {
                    var diasVencer = (i.Fecha_Vencimiento - DateTime.Today).Days;
                    var stockBajo = i.Cantidad_Disponible <= i.Cantidad_Minima;

                    <tr class="@(stockBajo ? "table-warning" : (diasVencer <= 30 ? "table-danger" : ""))">
                        <td class="text-muted small">@fila</td>
                        <td class="fw-semibold">@i.Producto?.Nombre</td>
                        <td><span class="badge bg-secondary">@(i.Numero_Lote ?? "—")</span></td>
                        <td class="text-muted">@(i.Proveedor ?? "—")</td>
                        <td class="text-center">
                            @if (stockBajo)
                            {
                                <span class="badge bg-danger">@i.Cantidad_Disponible ⚠️</span>
                            }
                            else
                            {
                                <span class="badge bg-success">@i.Cantidad_Disponible</span>
                            }
                        </td>
                        <td class="text-center">
                            <span class="badge bg-secondary">@i.Cantidad_Minima</span>
                        </td>
                        <td class="text-center text-muted small">
                            @i.Fecha_Ingreso.ToString("dd/MM/yyyy")
                        </td>
                        <td class="text-center">
                            @if (diasVencer <= 30)
                            {
                                <span class="badge bg-danger">@i.Fecha_Vencimiento.ToString("dd/MM/yyyy") 🗓️</span>
                            }
                            else if (diasVencer <= 60)
                            {
                                <span class="badge bg-warning text-dark">@i.Fecha_Vencimiento.ToString("dd/MM/yyyy")</span>
                            }
                            else
                            {
                                <span class="badge bg-success">@i.Fecha_Vencimiento.ToString("dd/MM/yyyy")</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (i.Estado)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactivo</span>
                            }
                        </td>
                        <td class="text-center">
                            <a asp-action="Detalle" asp-route-id="@i.Inventario_Id"
                               class="btn btn-info btn-sm px-3 text-white">
                                <i class="bi bi-eye"></i> Ver
                            </a>
                            <a asp-action="Editar" asp-route-id="@i.Inventario_Id"
                               class="btn btn-warning btn-sm px-3">
                                <i class="bi bi-pencil"></i> Editar
                            </a>
                            <a href="/inventario/eliminar/@i.Inventario_Id"
                               class="btn btn-danger btn-sm px-3"
                               onclick="return confirmarEliminar(event, '@i.Producto?.Nombre', @i.Cantidad_Disponible, @i.Inventario_Id)">
                                <i class="bi bi-trash"></i> Eliminar
                            </a>
                        </td>
                    </tr>
                    fila++;
                }
            </tbody>
        </table>
    </div>

    <div id="estadoVacio" class="text-center py-5 d-none">
        <i class="bi bi-inbox display-4 text-muted"></i>
        <p class="text-muted mt-2">No se encontraron lotes con los filtros aplicados.</p>
        <button class="btn btn-outline-secondary btn-sm rounded-3" id="btnLimpiarDesdeVacio">
            Limpiar filtros
        </button>
    </div>

</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        const todosLosLotes = @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(todosParaJs)
            );

        const $buscador          = $('#buscador');
        const $filtroEstado      = $('#filtroEstado');
        const $filtroStock       = $('#filtroStock');
        const $filtroVencimiento = $('#filtroVencimiento');
        const $tabla             = $('#tablaInventario');
        const $estadoVacio       = $('#estadoVacio');
        const $contador          = $('#contadorResultados');
        const $btnLimpiarTexto   = $('#btnLimpiarTexto');
        const $btnLimpiarFiltros = $('#btnLimpiarFiltros');

        todosLosLotes.forEach(function (i) {
            const partes = i.fecha_Vencimiento.split('-');
            const fechaVenc = new Date(
                parseInt(partes[0]),
                parseInt(partes[1]) - 1,
                parseInt(partes[2])
            );
            const hoy = new Date();
            hoy.setHours(0, 0, 0, 0);
            const diff = fechaVenc - hoy;
            i.diasParaVencer = Math.floor(diff / (1000 * 60 * 60 * 24));
            i.stockBajo = i.cantidad_Disponible <= i.cantidad_Minima;
        });

        function filtrar() {
            const texto      = $buscador.val().trim().toLowerCase();
            const estado     = $filtroEstado.val();
            const stock      = $filtroStock.val();
            const vencDias   = $filtroVencimiento.val();
            const hayFiltros = texto !== '' || estado !== '' || stock !== '' || vencDias !== '';

            actualizarChips(texto, estado, stock, vencDias);
            $btnLimpiarFiltros.toggle(hayFiltros);
            $btnLimpiarTexto.toggle(texto !== '');

            if (!hayFiltros) {
                restaurarVista();
                return;
            }

            const resultado = todosLosLotes.filter(function (i) {
                const coincideTexto = texto === '' ||
                    i.producto.toLowerCase().includes(texto) ||
                    i.numero_Lote.toLowerCase().includes(texto) ||
                    i.proveedor.toLowerCase().includes(texto);

                const coincideEstado = estado === '' ||
                    i.estado.toString() === estado;

                const coincideStock = stock === '' ||
                    (stock === 'bajo' && i.stockBajo) ||
                    (stock === 'ok'   && !i.stockBajo);

                const coincideVenc = vencDias === '' ||
                    (i.diasParaVencer >= 0 && i.diasParaVencer <= parseInt(vencDias));

                return coincideTexto && coincideEstado && coincideStock && coincideVenc;
            });

            renderTabla(resultado, texto);
        }

        function renderTabla(lotes, texto) {
            if (lotes.length === 0) {
                $tabla.html('');
                $estadoVacio.removeClass('d-none');
                $contador.text('');
                return;
            }

            $estadoVacio.addClass('d-none');
            $contador.html(
                `<span class="fw-semibold">${lotes.length}</span> resultado${lotes.length !== 1 ? 's' : ''} encontrado${lotes.length !== 1 ? 's' : ''}`
            );

            let filas = '';
            lotes.forEach(function (i, index) {
                const estadoBadge = i.estado
                    ? `<span class="badge bg-success">Activo</span>`
                    : `<span class="badge bg-danger">Inactivo</span>`;

                const stockBadge = i.stockBajo
                    ? `<span class="badge bg-danger">${i.cantidad_Disponible} ⚠️</span>`
                    : `<span class="badge bg-success">${i.cantidad_Disponible}</span>`;

                let vencBadge = '';
                if (i.diasParaVencer < 0)
                    vencBadge = `<span class="badge bg-dark">${formatearFecha(i.fecha_Vencimiento)} ❌ Vencido</span>`;
                else if (i.diasParaVencer <= 30)
                    vencBadge = `<span class="badge bg-danger">${formatearFecha(i.fecha_Vencimiento)} 🗓️</span>`;
                else if (i.diasParaVencer <= 60)
                    vencBadge = `<span class="badge bg-warning text-dark">${formatearFecha(i.fecha_Vencimiento)}</span>`;
                else
                    vencBadge = `<span class="badge bg-success">${formatearFecha(i.fecha_Vencimiento)}</span>`;

                const rowClass = i.diasParaVencer < 0
                    ? 'table-secondary'
                    : (i.stockBajo ? 'table-warning' : (i.diasParaVencer <= 30 ? 'table-danger' : ''));

                filas += `
                    <tr class="${rowClass}">
                        <td class="text-muted small">${index + 1}</td>
                        <td class="fw-semibold">${resaltar(i.producto, texto)}</td>
                        <td><span class="badge bg-secondary">${resaltar(i.numero_Lote || '—', texto)}</span></td>
                        <td class="text-muted">${resaltar(i.proveedor || '—', texto)}</td>
                        <td class="text-center">${stockBadge}</td>
                        <td class="text-center"><span class="badge bg-secondary">${i.cantidad_Minima}</span></td>
                        <td class="text-center text-muted small">${formatearFecha(i.fecha_Ingreso)}</td>
                        <td class="text-center">${vencBadge}</td>
                        <td class="text-center">${estadoBadge}</td>
                        <td class="text-center">
                            <a href="/inventario/detalle/${i.inventario_Id}"
                               class="btn btn-info btn-sm px-3 text-white">
                                <i class="bi bi-eye"></i> Ver
                            </a>
                            <a href="/inventario/editar/${i.inventario_Id}"
                               class="btn btn-warning btn-sm px-3">
                                <i class="bi bi-pencil"></i> Editar
                            </a>
                            <a href="/inventario/eliminar/${i.inventario_Id}"
                               class="btn btn-danger btn-sm px-3"
                               onclick="return confirmarEliminar(event, '${escapeJs(i.producto)}', ${i.cantidad_Disponible}, ${i.inventario_Id})">
                                <i class="bi bi-trash"></i> Eliminar
                            </a>
                        </td>
                    </tr>`;
            });

            $tabla.html(filas);
        }

        function restaurarVista() {
            $estadoVacio.addClass('d-none');
            $btnLimpiarFiltros.hide();
            $btnLimpiarTexto.hide();
            $contador.text('');
            renderTabla(todosLosLotes, '');
        }

        function formatearFecha(fechaStr) {
            const partes = fechaStr.split('-');
            const d = new Date(
                parseInt(partes[0]),
                parseInt(partes[1]) - 1,
                parseInt(partes[2])
            );
            return d.toLocaleDateString('es-CR');
        }

        function resaltar(valor, busqueda) {
            if (!busqueda) return escapeHtml(valor);
            const escaped = busqueda.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            return escapeHtml(valor).replace(
                new RegExp(`(${escaped})`, 'gi'),
                '<mark class="px-0 bg-warning rounded-1">$1</mark>'
            );
        }

        function escapeHtml(str) {
            return (str ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }

        function escapeJs(str) {
            return (str ?? '')
                .replace(/\\/g, '\\\\')
                .replace(/'/g, "\\'");
        }

        function actualizarChips(texto, estado, stock, vencimiento) {
            $('#chipTexto').toggleClass('d-none', texto === '');
            if (texto !== '') $('#chipTextoLabel').text(`"${texto}"`);

            $('#chipEstado').toggleClass('d-none', estado === '');
            if (estado !== '') $('#chipEstadoLabel').text(estado === 'true' ? 'Activo' : 'Inactivo');

            $('#chipStock').toggleClass('d-none', stock === '');
            if (stock !== '') $('#chipStockLabel').text(stock === 'bajo' ? 'Stock bajo' : 'Stock OK');

            $('#chipVencimiento').toggleClass('d-none', vencimiento === '');
            if (vencimiento !== '') $('#chipVencimientoLabel').text(`Vence en ${vencimiento} días`);
        }

        function confirmarEliminar(e, nombre, cantidad, id) {
            e.preventDefault();
            if (cantidad > 0) {
                alert(`⚠️ No se puede eliminar el lote de "${nombre}" porque tiene ${cantidad} unidades disponibles.`);
                return false;
            }
            if (!confirm(`¿Está seguro de eliminar este lote de "${nombre}"?`))
                return false;

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const form  = document.createElement('form');
            form.method = 'POST';
            form.action = `/inventario/eliminar/${id}`;
            const inp   = document.createElement('input');
            inp.type    = 'hidden';
            inp.name    = '__RequestVerificationToken';
            inp.value   = token;
            form.appendChild(inp);
            document.body.appendChild(form);
            form.submit();
            return false;
        }

        $buscador.on('input', filtrar);
        $filtroEstado.on('change', filtrar);
        $filtroStock.on('change', filtrar);
        $filtroVencimiento.on('change', filtrar);

        $btnLimpiarTexto.on('click', () => $buscador.val('').trigger('input').focus());
        $btnLimpiarFiltros.on('click', limpiarTodo);
        $('#btnLimpiarDesdeVacio').on('click', limpiarTodo);
        $('#btnRemoveTexto').on('click', () => $buscador.val('').trigger('input'));
        $('#btnRemoveEstado').on('click', () => $filtroEstado.val('').trigger('change'));
        $('#btnRemoveStock').on('click', () => $filtroStock.val('').trigger('change'));
        $('#btnRemoveVencimiento').on('click', () => $filtroVencimiento.val('').trigger('change'));

        function limpiarTodo() {
            $buscador.val('');
            $filtroEstado.val('');
            $filtroStock.val('');
            $filtroVencimiento.val('');
            restaurarVista();
        }
    </script>
}