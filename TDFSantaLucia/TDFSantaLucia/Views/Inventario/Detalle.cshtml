@model TDFSantaLucia.Models.Inventario
@{
    ViewData["Title"] = "Detalle de Lote";
    var diasVencer = (Model.Fecha_Vencimiento - DateTime.Today).Days;
    var stockBajo = Model.Cantidad_Disponible <= Model.Cantidad_Minima;
}

<h2 class="mb-4">📦 Detalle del Lote</h2>

@if (stockBajo)
{
    <div class="alert alert-warning d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <strong>⚠️ Este lote tiene stock bajo.</strong> Cantidad disponible por debajo del mínimo establecido.
    </div>
}
@if (diasVencer <= 30)
{
    <div class="alert alert-danger d-flex align-items-center gap-2">
        <i class="bi bi-calendar-x-fill"></i>
        <strong>🗓️ Este lote vence en @diasVencer día(s).</strong> Tomar acción inmediata.
    </div>
}

<div class="card border-0 shadow-sm" style="max-width: 700px;">
    <div class="card-body p-4">

        <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
                <h4 class="mb-1">@Model.Producto?.Nombre</h4>
                <small class="text-muted">Lote: <span class="badge bg-secondary">@(Model.Numero_Lote ?? "Sin número")</span></small>
            </div>
            @if (Model.Estado)
            {
                <span class="badge bg-success fs-6">Activo</span>
            }
            else
            {
                <span class="badge bg-danger fs-6">Inactivo</span>
            }
        </div>

        <hr />

        <div class="row g-3">
            <div class="col-md-6">
                <p class="text-muted small fw-semibold mb-1">PRODUCTO</p>
                <p>
                    @Model.Producto?.Nombre <br />
                    <small class="text-muted">@Model.Producto?.Categoria?.Nombre</small>
                </p>
            </div>
            <div class="col-md-6">
                <p class="text-muted small fw-semibold mb-1">PROVEEDOR</p>
                <p>@(Model.Proveedor ?? "No especificado")</p>
            </div>
            <div class="col-md-3">
                <p class="text-muted small fw-semibold mb-1">DISPONIBLE</p>
                @if (stockBajo)
                {
                    <span class="badge bg-danger fs-6">@Model.Cantidad_Disponible ⚠️</span>
                }
                else
                {
                    <span class="badge bg-success fs-6">@Model.Cantidad_Disponible</span>
                }
            </div>
            <div class="col-md-3">
                <p class="text-muted small fw-semibold mb-1">MÍNIMO</p>
                <span class="badge bg-secondary fs-6">@Model.Cantidad_Minima</span>
            </div>
            <div class="col-md-3">
                <p class="text-muted small fw-semibold mb-1">F. INGRESO</p>
                <p>@Model.Fecha_Ingreso.ToString("dd/MM/yyyy")</p>
            </div>
            <div class="col-md-3">
                <p class="text-muted small fw-semibold mb-1">F. VENCIMIENTO</p>
                @if (diasVencer <= 30)
                {
                    <span class="badge bg-danger">@Model.Fecha_Vencimiento.ToString("dd/MM/yyyy")</span>
                }
                else if (diasVencer <= 60)
                {
                    <span class="badge bg-warning text-dark">@Model.Fecha_Vencimiento.ToString("dd/MM/yyyy")</span>
                }
                else
                {
                    <span class="badge bg-success">@Model.Fecha_Vencimiento.ToString("dd/MM/yyyy")</span>
                }
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Volver
            </a>
            <a asp-action="Editar" asp-route-id="@Model.Inventario_Id" class="btn btn-warning">
                <i class="bi bi-pencil"></i> Editar
            </a>
        </div>
    </div>
</div>