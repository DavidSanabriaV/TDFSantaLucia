@model TDFSantaLucia.Models.Inventario
@{
    ViewData["Title"] = "Detalle de Lote";
    var diasVencer = (Model.Fecha_Vencimiento - DateTime.Today).Days;
    var stockBajo = Model.Cantidad_Disponible <= Model.Cantidad_Minima;
}

<div class="container py-4" style="max-width:750px;">

    @if (stockBajo)
    {
        <div class="alert alert-warning alert-dismissible fade show rounded-3 shadow-sm mb-3 d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div><strong>Stock bajo.</strong> Cantidad disponible por debajo del mínimo establecido.</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (diasVencer <= 30)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-3 d-flex align-items-center gap-2">
            <i class="bi bi-calendar-x-fill fs-5"></i>
            <div><strong>Próximo a vencer.</strong> Este lote vence en @diasVencer día(s).</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h2 class="fw-bold mb-1" style="color:#1a3c5e;">
                        <i class="bi bi-box-seam-fill me-2 text-primary"></i>Detalle del Lote
                    </h2>
                    <span class="text-muted small">@(Model.Numero_Lote ?? "Sin número")</span>
                </div>
                @if (Model.Estado)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle fs-6">Activo</span>
                }
                else
                {
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle fs-6">Inactivo</span>
                }
            </div>

            <hr />

            <div class="row g-4">
                <div class="col-md-6">
                    <p class="text-muted small mb-1">PRODUCTO</p>
                    <p class="fw-semibold mb-0">@Model.Producto?.Nombre</p>
                    <small class="text-muted">@Model.Producto?.Categoria?.Nombre</small>
                </div>
                <div class="col-md-6">
                    <p class="text-muted small mb-1">PROVEEDOR</p>
                    <p class="fw-semibold">@(Model.Proveedor ?? "No especificado")</p>
                </div>
                <div class="col-md-3">
                    <p class="text-muted small mb-1">DISPONIBLE</p>
                    @if (stockBajo)
                    {
                        <p class="fw-bold text-danger fs-5 mb-0">
                            @Model.Cantidad_Disponible
                            <i class="bi bi-exclamation-triangle-fill ms-1 small"></i>
                        </p>
                    }
                    else
                    {
                        <p class="fw-bold text-success fs-5 mb-0">@Model.Cantidad_Disponible</p>
                    }
                </div>
                <div class="col-md-3">
                    <p class="text-muted small mb-1">MÍNIMO</p>
                    <p class="fw-semibold text-muted fs-5 mb-0">@Model.Cantidad_Minima</p>
                </div>
                <div class="col-md-3">
                    <p class="text-muted small mb-1">F. INGRESO</p>
                    <p class="fw-semibold">@Model.Fecha_Ingreso.ToString("dd/MM/yyyy")</p>
                </div>
                <div class="col-md-3">
                    <p class="text-muted small mb-1">F. VENCIMIENTO</p>
                    @if (diasVencer < 0)
                    {
                        <p class="fw-semibold text-danger mb-0">
                            <i class="bi bi-x-circle me-1"></i>@Model.Fecha_Vencimiento.ToString("dd/MM/yyyy")
                        </p>
                    }
                    else if (diasVencer <= 30)
                    {
                        <p class="fw-semibold text-danger mb-0">
                            <i class="bi bi-exclamation-circle me-1"></i>@Model.Fecha_Vencimiento.ToString("dd/MM/yyyy")
                        </p>
                    }
                    else if (diasVencer <= 60)
                    {
                        <p class="fw-semibold text-warning mb-0">
                            @Model.Fecha_Vencimiento.ToString("dd/MM/yyyy")
                        </p>
                    }
                    else
                    {
                        <p class="fw-semibold text-muted mb-0">
                            @Model.Fecha_Vencimiento.ToString("dd/MM/yyyy")
                        </p>
                    }
                </div>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn rounded-3"
                   style="background-color:#d0e8f5; color:#2a7ab5; border:none;">
                    <i class="bi bi-arrow-left me-1"></i>Volver
                </a>
                <a asp-action="Editar" asp-route-id="@Model.Inventario_Id"
                   class="btn rounded-3"
                   style="background-color:#fde8cc; color:#d4620a; border:none;">
                    <i class="bi bi-pencil me-1"></i>Editar
                </a>
            </div>

        </div>
    </div>
</div>