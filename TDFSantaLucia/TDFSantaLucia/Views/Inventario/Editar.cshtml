@model TDFSantaLucia.Models.Inventario
@{
    ViewData["Title"] = "Editar Lote";
}

<div class="container py-4" style="max-width:750px;">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <h2 class="fw-bold mb-4" style="color:#1a3c5e;">
                <i class="bi bi-pencil-square me-2 text-primary"></i>Editar Lote de Inventario
            </h2>

            @if (!ViewData.ModelState.IsValid && ViewContext.HttpContext.Request.Method == "POST")
            {
                <div class="alert alert-danger rounded-3 mb-4">
                    <h6 class="fw-bold mb-2">
                        <i class="bi bi-exclamation-triangle me-1"></i>Por favor corrija los siguientes errores:
                    </h6>
                    <ul class="mb-0">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            @using (Html.BeginForm("Editar", "Inventario", new { id = Model.Inventario_Id },
                FormMethod.Post, null, new { @class = "row g-3" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Inventario_Id)

                <div class="col-md-12">
                    <label class="form-label fw-semibold">Producto</label>
                    @Html.DropDownList("Producto_Id",
                        (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Productos,
                        "-- Seleccione un producto --",
                        new { @class = "form-select rounded-3" })
                    @Html.ValidationMessageFor(m => m.Producto_Id, "", new { @class = "text-danger small" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.Numero_Lote, "Número de Lote",
                        new { @class = "form-label fw-semibold" })
                    @Html.TextBoxFor(m => m.Numero_Lote,
                        new { @class = "form-control rounded-3" })
                    @Html.ValidationMessageFor(m => m.Numero_Lote, "",
                        new { @class = "text-danger small" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.Proveedor,
                        new { @class = "form-label fw-semibold" })
                    @Html.TextBoxFor(m => m.Proveedor,
                        new { @class = "form-control rounded-3" })
                    @Html.ValidationMessageFor(m => m.Proveedor, "",
                        new { @class = "text-danger small" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.Cantidad_Disponible, "Cantidad Disponible",
                        new { @class = "form-label fw-semibold" })
                    @Html.TextBoxFor(m => m.Cantidad_Disponible,
                        new { @class = "form-control rounded-3", type = "number", min = "0" })
                    @Html.ValidationMessageFor(m => m.Cantidad_Disponible, "",
                        new { @class = "text-danger small" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.Cantidad_Minima, "Cantidad Mínima (alerta stock)",
                        new { @class = "form-label fw-semibold" })
                    @Html.TextBoxFor(m => m.Cantidad_Minima,
                        new { @class = "form-control rounded-3", type = "number", min = "0" })
                    @Html.ValidationMessageFor(m => m.Cantidad_Minima, "",
                        new { @class = "text-danger small" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.Fecha_Ingreso, "Fecha de Ingreso",
                        new { @class = "form-label fw-semibold" })
                    @Html.TextBoxFor(m => m.Fecha_Ingreso, "{0:yyyy-MM-dd}",
                        new { @class = "form-control rounded-3", type = "date" })
                    @Html.ValidationMessageFor(m => m.Fecha_Ingreso, "",
                        new { @class = "text-danger small" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.Fecha_Vencimiento, "Fecha de Vencimiento",
                        new { @class = "form-label fw-semibold" })
                    @Html.TextBoxFor(m => m.Fecha_Vencimiento, "{0:yyyy-MM-dd}",
                        new { @class = "form-control rounded-3", type = "date" })
                    @Html.ValidationMessageFor(m => m.Fecha_Vencimiento, "",
                        new { @class = "text-danger small" })
                </div>

                <div class="col-12">
                    <div class="form-check form-switch">
                        @Html.CheckBoxFor(m => m.Estado,
                            new { @class = "form-check-input", role = "switch" })
                        @Html.LabelFor(m => m.Estado, "Lote Activo",
                            new { @class = "form-check-label fw-semibold" })
                    </div>
                </div>

                <div class="col-12 d-flex justify-content-between mt-2">
                    @Html.ActionLink("Cancelar", "Index", "Inventario", null,
                        new { @class = "btn btn-outline-secondary rounded-3" })
                    <button type="submit" class="btn btn-warning rounded-3 text-white" id="btnGuardar">
                        <i class="bi bi-save me-1"></i>Guardar cambios
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelector('form').addEventListener('submit', function () {
            const btn = document.getElementById('btnGuardar');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Guardando...';
        });
    </script>
}