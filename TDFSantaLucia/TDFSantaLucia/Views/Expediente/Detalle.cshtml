@model TDFSantaLucia.Models.Expediente
@{
    ViewData["Title"] = "Detalle de Expediente";
}

<style>
    .table-responsive {
        overflow: visible !important;
    }

    .card {
        overflow: visible !important;
    }
</style>

<div class="container py-4" style="max-width:900px;">

    @if (TempData["ExitoExpediente"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4">
            <i class="bi bi-check-circle me-2"></i>@TempData["ExitoExpediente"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorExpediente"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorExpediente"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0" style="color:#1a3c5e;">
            <i class="bi bi-folder-fill me-2 text-primary"></i>Expediente #@Model.Expediente_Id
        </h2>
        <span class="badge bg-primary fs-6">
            @Model.RecetasMedicas.Count receta(s)
        </span>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
        <div class="row g-3">
            <div class="col-md-6">
                <p class="text-muted small mb-1">CLIENTE</p>
                <p class="fw-semibold">
                    @(Model.Cliente?.Usuario != null
                        ? $"{Model.Cliente.Usuario.Nombre} {Model.Cliente.Usuario.Primer_Apellido} {Model.Cliente.Usuario.Segundo_Apellido}"
                        : "—")
                </p>
            </div>
            <div class="col-md-6">
                <p class="text-muted small mb-1">EMPLEADO RESPONSABLE</p>
                <p class="fw-semibold">
                    @(Model.Empleado?.Usuario != null
                        ? $"{Model.Empleado.Usuario.Nombre} {Model.Empleado.Usuario.Primer_Apellido}"
                        : "—")
                </p>
            </div>
            <div class="col-md-6">
                <p class="text-muted small mb-1">CREADO</p>
                <p class="fw-semibold">@Model.Fecha_Creacion.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
            <div class="col-md-6">
                <p class="text-muted small mb-1">ACTUALIZADO</p>
                <p class="fw-semibold">@Model.Fecha_Actualizacion.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
            <div class="col-12">
                <p class="text-muted small mb-1">DESCRIPCIÓN</p>
                <p class="fw-semibold">@(Model.Descripcion ?? "Sin descripción registrada.")</p>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-0" style="color:#1a3c5e;">
            <i class="bi bi-file-medical me-2"></i>Recetas Médicas
        </h4>
        @if (User.IsInRole("Admin") || User.IsInRole("Empleado"))
        {
            <a asp-controller="Receta" asp-action="Crear"
               asp-route-expedienteId="@Model.Expediente_Id"
               class="btn btn-sm rounded-3"
               style="background-color:#d4edda; color:#2d7a4f; border:none;">
                <i class="bi bi-plus-circle me-1"></i>Nueva receta
            </a>
        }
    </div>

    @if (!Model.RecetasMedicas.Any())
    {
        <div class="text-center py-4 card border-0 shadow-sm rounded-4 mb-4">
            <i class="bi bi-clipboard-x display-6 text-muted"></i>
            <p class="text-muted mt-2">Este expediente no tiene recetas médicas.</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Medicamento</th>
                            <th>Frecuencia</th>
                            <th>Descripción</th>
                            <th class="text-center">Vencimiento</th>
                            <th class="text-center">Fecha emisión</th>
                            @if (User.IsInRole("Admin") || User.IsInRole("Empleado"))
                            {
                                <th class="text-center">Acciones</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.RecetasMedicas.OrderByDescending(r => r.Fecha_Emision))
                        {
                            <tr>
                                <td class="fw-semibold">
                                    @r.Producto?.Nombre
                                    @if (!string.IsNullOrEmpty(r.Producto?.Marca))
                                    {
                                        <small class="text-muted">— @r.Producto.Marca</small>
                                    }
                                </td>
                                <td>@(r.Frecuencia ?? "—")</td>
                                <td class="text-muted small">@(r.Descripcion ?? "—")</td>
                                <td class="text-center">
                                    @if (r.Fecha_Vencimiento.HasValue)
                                    {
                                        @if (r.Fecha_Vencimiento < DateTime.Today)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Vencida</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">@r.Fecha_Vencimiento.Value.ToString("dd/MM/yyyy")</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-center small text-muted">
                                    @r.Fecha_Emision.ToString("dd/MM/yyyy")
                                </td>
                                @if (User.IsInRole("Admin") || User.IsInRole("Empleado"))
                                {
                                    <td class="text-center">
                                        <div class="dropdown">
                                            <button class="btn btn-outline-secondary btn-sm rounded-3"
                                                    type="button"
                                                    data-bs-toggle="dropdown"
                                                    aria-expanded="false">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu shadow rounded-3">
                                                <li>
                                                    <a class="dropdown-item"
                                                       asp-controller="Receta" asp-action="Descargar"
                                                       asp-route-id="@r.Receta_Id" target="_blank">
                                                        <i class="bi bi-download me-2" style="color:#6baed6;"></i>Descargar
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item"
                                                       asp-controller="Receta" asp-action="Editar"
                                                       asp-route-id="@r.Receta_Id">
                                                        <i class="bi bi-pencil me-2" style="color:#fd8d3c;"></i>Editar
                                                    </a>
                                                </li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <form asp-controller="Receta" asp-action="Eliminar"
                                                          asp-route-id="@r.Receta_Id" method="post"
                                                          onsubmit="return confirm('¿Eliminar esta receta?')">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="dropdown-item">
                                                            <i class="bi bi-trash me-2" style="color:#e57373;"></i>Eliminar
                                                        </button>
                                                    </form>
                                                </li>
                                            </ul>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="d-flex justify-content-between mt-2">
        <a asp-action="Index" class="btn rounded-3"
           style="background-color:#d0e8f5; color:#2a7ab5; border:none;">
            <i class="bi bi-arrow-left me-1"></i>Volver
        </a>
        <a asp-action="Editar" asp-route-id="@Model.Expediente_Id"
           class="btn rounded-3"
           style="background-color:#fde8cc; color:#d4620a; border:none;">
            <i class="bi bi-pencil me-1"></i>Editar
        </a>
    </div>

</div>