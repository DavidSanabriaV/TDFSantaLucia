@model TDFSantaLucia.Models.Expediente
@{
    ViewData["Title"] = "Detalle de Expediente";
}

<h2 class="mb-4">📋 Detalle de Expediente</h2>

<div class="card border-0 shadow-sm" style="max-width: 800px;">
    <div class="card-body p-4">

        <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
                <h4 class="card-title mb-1">
                    @(Model.Cliente?.Usuario != null
                        ? $"{Model.Cliente.Usuario.Nombre} {Model.Cliente.Usuario.Primer_Apellido}"
                        : "Cliente no disponible")
                </h4>
                <small class="text-muted">ID Expediente: @Model.Expediente_Id</small>
            </div>
            <span class="badge bg-primary fs-6">
                @Model.RecetasMedicas.Count receta(s)
            </span>
        </div>

        <hr />

        <div class="row mb-3">
            <div class="col-md-6">
                <p class="text-muted small fw-semibold mb-1">CLIENTE</p>
                <p>
                    @(Model.Cliente?.Usuario != null
                    ? $"{Model.Cliente.Usuario.Nombre} {Model.Cliente.Usuario.Primer_Apellido} {Model.Cliente.Usuario.Segundo_Apellido}"
                    : "—")
                </p>
            </div>
            <div class="col-md-6">
                <p class="text-muted small fw-semibold mb-1">EMPLEADO RESPONSABLE</p>
                <p>
                    @(Model.Empleado?.Usuario != null
                    ? $"{Model.Empleado.Usuario.Nombre} {Model.Empleado.Usuario.Primer_Apellido} {Model.Empleado.Usuario.Segundo_Apellido}"
                    : "—")
                </p>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <p class="text-muted small fw-semibold mb-1">FECHA DE CREACIÓN</p>
                <p>@Model.Fecha_Creacion.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
            <div class="col-md-6">
                <p class="text-muted small fw-semibold mb-1">ÚLTIMA ACTUALIZACIÓN</p>
                <p>@Model.Fecha_Actualizacion.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
        </div>

        <div class="mb-4">
            <p class="text-muted small fw-semibold mb-1">DESCRIPCIÓN</p>
            <p>@(Model.Descripcion ?? "Sin descripción registrada.")</p>
        </div>

        <hr />

        <h5 class="mb-3">💊 Recetas médicas asociadas</h5>

        @if (Model.RecetasMedicas.Any())
        {
            <div class="text-center py-4">
                <i class="bi bi-clipboard-check display-6 text-primary"></i>
                <p class="text-muted mt-2">
                    Este expediente tiene <strong>@Model.RecetasMedicas.Count</strong> receta(s) médica(s) registrada(s).
                </p>
            </div>
        }
        else
        {
            <div class="text-center py-4">
                <i class="bi bi-clipboard-x display-6 text-muted"></i>
                <p class="text-muted mt-2">Este expediente no tiene recetas médicas asociadas.</p>
            </div>
        }

        <div class="d-flex gap-2 mt-4">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Volver
            </a>
            <a asp-action="Editar" asp-route-id="@Model.Expediente_Id" class="btn btn-warning">
                <i class="bi bi-pencil"></i> Editar
            </a>
        </div>

    </div>
</div>