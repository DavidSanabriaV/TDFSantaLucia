@model TDFSantaLucia.Models.ChatbotOpcion
@{
    ViewData["Title"] = "Editar Opción";
}

<div class="container py-4 chatbot-form-wrapper">
    <h2 class="fw-bold mb-4" style="color:#243C8F;">
        <i class="bi bi-pencil-square me-2"></i>Editar Opción
    </h2>
    <form method="post"
          action="/chatbot/admin/editar/@Model.Opcion_Id">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Opcion_Id" />
        <input type="hidden" asp-for="Fecha_Creacion" />
        @await Html.PartialAsync("_FormChatbot", Model)
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary rounded-3 px-4">
                <i class="bi bi-save me-1"></i>Actualizar
            </button>
            <a asp-action="Admin"
               class="btn btn-outline-secondary rounded-3">
                Cancelar
            </a>
        </div>
    </form>
</div>
