@model TDFSantaLucia.Models.ChatbotOpcion
@{
    ViewData["Title"] = "Nueva Opción";
}

<div class="container py-4" style="max-width:750px;">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <h2 class="fw-bold mb-4" style="color:#1a3c5e;">
                <i class="bi bi-plus-circle me-2 text-primary"></i>Nueva Opción
            </h2>

            <form asp-action="Crear" method="post">
                @Html.AntiForgeryToken()
                @await Html.PartialAsync("_FormChatbot", Model)

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Admin" class="btn rounded-3"
                       style="background-color:#d0e8f5; color:#2a7ab5; border:none;">
                        <i class="bi bi-arrow-left me-1"></i>Cancelar
                    </a>
                    <button type="submit" class="btn rounded-3"
                            style="background-color:#d4edda; color:#2d7a4f; border:none;">
                        <i class="bi bi-save me-1"></i>Guardar
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>