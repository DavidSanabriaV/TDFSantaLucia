@model TDFSantaLucia.Models.Categoria
@{
    ViewData["Title"] = "Editar Categoría";
}

<div class="container py-4" style="max-width:600px;">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <h2 class="fw-bold mb-4" style="color:#1a3c5e;">
                <i class="bi bi-pencil-square me-2 text-primary"></i>Editar Categoría
            </h2>

            @if (!ViewData.ModelState.IsValid && ViewContext.HttpContext.Request.Method == "POST")
            {
                <div class="alert alert-danger rounded-3 mb-4">
                    <h6 class="fw-bold mb-2">
                        <i class="bi bi-exclamation-triangle me-1"></i>Por favor corrija los siguientes errores:
                    </h6>
                    <ul class="mb-0">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            @using (Html.BeginForm("Editar", "Categoria", new { id = Model.Categoria_Id }, FormMethod.Post, null, new { @class = "row g-3" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Categoria_Id)

                <div class="col-12">
                    @Html.LabelFor(m => m.Nombre, new { @class = "form-label fw-semibold" })
                    @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control rounded-3" })
                    @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger small" })
                </div>

                <div class="col-12">
                    @Html.LabelFor(m => m.Descripcion, new { @class = "form-label fw-semibold" })
                    @Html.TextAreaFor(m => m.Descripcion, 3, 0, new { @class = "form-control rounded-3" })
                    @Html.ValidationMessageFor(m => m.Descripcion, "", new { @class = "text-danger small" })
                </div>

                <div class="col-12">
                    <div class="form-check form-switch">
                        @Html.CheckBoxFor(m => m.Estado, new { @class = "form-check-input", role = "switch" })
                        @Html.LabelFor(m => m.Estado, "Categoría Activa", new { @class = "form-check-label fw-semibold" })
                    </div>
                </div>

                <div class="col-12 d-flex justify-content-between mt-2">
                    @Html.ActionLink("Cancelar", "Index", "Categoria", null, new { @class = "btn btn-outline-secondary rounded-3" })
                    <button type="submit" class="btn btn-warning rounded-3 text-white" id="btnGuardar">
                        <i class="bi bi-save me-1"></i>Guardar cambios
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelector('form').addEventListener('submit', function () {
            const btn = document.getElementById('btnGuardar');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Guardando...';
        });
    </script>
}