@model TDFSantaLucia.Models.Categoria
@{
    ViewData["Title"] = "Detalle de Categoría";
}

<div class="container py-4" style="max-width:800px;">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h2 class="fw-bold mb-1" style="color:#1a3c5e;">
                        <i class="bi bi-grid-fill me-2 text-primary"></i>@Model.Nombre
                    </h2>
                    <small class="text-muted">ID: @Model.Categoria_Id</small>
                </div>
                @if (Model.Estado)
                {
                    <span class="badge bg-success fs-6">Activo</span>
                }
                else
                {
                    <span class="badge bg-danger fs-6">Inactivo</span>
                }
            </div>

            <hr />

            <div class="row g-4 mb-3">
                <div class="col-md-8">
                    <p class="text-muted small mb-1">DESCRIPCIÓN</p>
                    <p class="fw-semibold">@(Model.Descripcion ?? "Sin descripción registrada.")</p>
                </div>
                <div class="col-md-4">
                    <p class="text-muted small mb-1">TOTAL DE PRODUCTOS</p>
                    <span class="badge bg-secondary fs-6">
                        <i class="bi bi-box-seam me-1"></i>@Model.Productos.Count producto(s)
                    </span>
                </div>
            </div>

            <hr />

            <h5 class="fw-bold mb-3" style="color:#1a3c5e;">
                <i class="bi bi-box-seam me-2"></i>Productos asociados
            </h5>

            @if (Model.Productos.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Nombre</th>
                                <th>Marca</th>
                                <th class="text-end">Precio</th>
                                <th class="text-center">Receta</th>
                                <th class="text-center">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.Productos.OrderBy(p => p.Nombre))
                            {
                                <tr>
                                    <td class="fw-semibold">@p.Nombre</td>
                                    <td class="text-muted">@(p.Marca ?? "—")</td>
                                    <td class="text-end">₡@p.Precio.ToString("N2")</td>
                                    <td class="text-center">
                                        @if (p.Receta)
                                        {
                                            <span class="badge bg-warning text-dark">Sí</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border">No</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (p.Estado)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactivo</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="bi bi-inbox display-6 text-muted"></i>
                    <p class="text-muted mt-2">Esta categoría no tiene productos asociados.</p>
                </div>
            }

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-3">
                    <i class="bi bi-arrow-left me-1"></i>Volver
                </a>
                <a asp-action="Editar" asp-route-id="@Model.Categoria_Id"
                   class="btn btn-warning rounded-3 text-white">
                    <i class="bi bi-pencil me-1"></i>Editar
                </a>
            </div>

        </div>
    </div>
</div>