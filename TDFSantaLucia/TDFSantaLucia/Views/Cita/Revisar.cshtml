@model TDFSantaLucia.Models.CitaViewModel
@{
    ViewData["Title"] = "Revisar Cita";
}

<div class="container py-4" style="max-width:750px;">

    <h2 class="fw-bold mb-4" style="color:#1a3c5e;">
        <i class="bi bi-calendar-check-fill me-2 text-primary"></i>Revisar Cita
    </h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
        <h5 class="fw-bold mb-3" style="color:#1a3c5e;">
            <i class="bi bi-info-circle me-2"></i>Datos de la Cita
        </h5>
        <hr />
        <div class="row g-3">
            <div class="col-md-6">
                <p class="text-muted small mb-1">SERVICIO</p>
                <p class="fw-semibold">@Model.Servicio</p>
            </div>
            <div class="col-md-6">
                <p class="text-muted small mb-1">FECHA</p>
                <p class="fw-semibold">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
            <div class="col-md-6">
                <p class="text-muted small mb-1">ESTADO</p>
                @if (Model.Estado == "Aceptada")
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle fs-6">✔ Aceptada</span>
                }
                else if (Model.Estado == "Cancelada")
                {
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle fs-6">✖ Cancelada</span>
                }
                else
                {
                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle fs-6">⏳ En Proceso</span>
                }
            </div>
            <div class="col-md-6">
                <p class="text-muted small mb-1">EMPLEADO ASIGNADO</p>
                @if (Model.Empleado_Id.HasValue)
                {
                    <p class="fw-semibold">@Model.NombreEmpleado</p>
                }
                else
                {
                    <p class="text-muted fst-italic">Sin empleado asignado aún.</p>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Observaciones))
            {
                <div class="col-12">
                    <p class="text-muted small mb-1">OBSERVACIONES</p>
                    <p class="fw-semibold">@Model.Observaciones</p>
                </div>
            }
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
        <h5 class="fw-bold mb-3" style="color:#1a3c5e;">
            <i class="bi bi-person-check me-2"></i>Asignar Empleado
        </h5>
        <form asp-action="Asignar" asp-route-id="@Model.Cita_Id" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <div class="col-md-8">
                <select name="empleadoId" class="form-select rounded-3" required>
                    <option value="">Seleccione un empleado</option>
                    @foreach (var emp in Model.Empleados)
                    {
                        <option value="@emp.Empleado_Id"
                                selected="@(Model.Empleado_Id.HasValue && Model.Empleado_Id.Value == emp.Empleado_Id ? "selected" : null)">
                            @emp.Usuario?.Nombre @emp.Usuario?.Primer_Apellido
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn w-100 rounded-3"
                        style="background-color:#d6e4f0; color:#1a3c5e; border:none;">
                    <i class="bi bi-person-check me-1"></i>Asignar
                </button>
            </div>
        </form>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
        <h5 class="fw-bold mb-3" style="color:#1a3c5e;">
            <i class="bi bi-arrow-repeat me-2"></i>Cambiar Estado
        </h5>
        <div class="d-flex gap-3 mt-2">
            <form asp-action="CambiarEstado" asp-route-id="@Model.Cita_Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="estado" value="Aceptada" />
                <button type="submit" class="btn rounded-3"
                        style="background-color:#d4edda; color:#2d7a4f; border:none;"
                        @(!Model.Empleado_Id.HasValue ? "disabled" : "")>
                    <i class="bi bi-check-circle me-1"></i>Aceptar Cita
                </button>
            </form>
            <form asp-action="CambiarEstado" asp-route-id="@Model.Cita_Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="estado" value="Cancelada" />
                <button type="submit" class="btn rounded-3"
                        style="background-color:#fbdcdc; color:#c62828; border:none;"
                        onclick="return confirm('¿Seguro que desea cancelar esta cita?')">
                    <i class="bi bi-x-circle me-1"></i>Cancelar Cita
                </button>
            </form>
        </div>
        @if (!Model.Empleado_Id.HasValue)
        {
            <div class="alert alert-warning rounded-3 mt-3 mb-0 small">
                <i class="bi bi-exclamation-triangle me-1"></i>
                Debe asignar un empleado antes de aceptar la cita.
            </div>
        }
    </div>

    <a asp-action="Index" class="btn rounded-3"
        style="background-color:#d0e8f5; color:#2a7ab5; border:none;">
        <i class="bi bi-arrow-left me-1"></i>Volver
    </a>
</div>