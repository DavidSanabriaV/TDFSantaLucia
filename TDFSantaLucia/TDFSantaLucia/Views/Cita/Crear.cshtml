@model TDFSantaLucia.Models.CitaViewModel

@{
    ViewData["Title"] = "Crear Cita";
}

<div class="container mt-4">
    <h2 class="mb-4">➕ Nueva Cita</h2>

    <form asp-action="Crear" method="post" class="card p-4 shadow-sm">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Cliente_Id" class="form-label">Cliente</label>
                <select asp-for="Cliente_Id" class="form-select"
                        asp-items="@(new SelectList(Model.Clientes, "Cliente_Id", "Usuario.Nombre"))">
                    <option value="">Seleccione un cliente</option>
                </select>
                <span asp-validation-for="Cliente_Id" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Servicio" class="form-label">Servicio</label>
                <input asp-for="Servicio" class="form-control" />
                <span asp-validation-for="Servicio" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Fecha" class="form-label">Fecha y Hora</label>
                <input asp-for="Fecha" type="datetime-local" class="form-control"
                       min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                <span asp-validation-for="Fecha" class="text-danger"></span>
            </div>

            <div class="col-md-12">
                <label asp-for="Observaciones" class="form-label">Observaciones</label>
                <textarea asp-for="Observaciones" class="form-control" rows="3"></textarea>
            </div>
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a asp-action="Index" class="btn btn-secondary">⬅ Volver</a>
            <button type="submit" class="btn btn-success">✔ Guardar</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}