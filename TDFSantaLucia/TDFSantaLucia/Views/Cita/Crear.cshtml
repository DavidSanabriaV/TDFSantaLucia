@model TDFSantaLucia.Models.CitaViewModel
@{
    ViewData["Title"] = "Crear Cita";
}

<div class="container py-4" style="max-width:750px;">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <h2 class="fw-bold mb-4" style="color:#1a3c5e;">
                <i class="bi bi-calendar-plus-fill me-2 text-primary"></i>Nueva Cita
            </h2>

            @if (!ViewData.ModelState.IsValid && ViewContext.HttpContext.Request.Method == "POST")
            {
                <div class="alert alert-danger rounded-3 mb-4">
                    <h6 class="fw-bold mb-2">
                        <i class="bi bi-exclamation-triangle me-1"></i>Por favor corrija los siguientes errores:
                    </h6>
                    <ul class="mb-0">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form asp-action="Crear" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Cliente</label>
                        <div class="input-group mb-2">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="text" id="buscadorCliente"
                                   class="form-control border-start-0 ps-0 rounded-end-3"
                                   placeholder="Buscar por nombre o cédula..."
                                   autocomplete="off" />
                        </div>

                        <div id="listaClientes" class="rounded-3 border"
                             style="max-height:220px;overflow-y:auto;background:white;">
                            @foreach (var c in Model.Clientes)
                            {
                                <div class="cliente-item px-3 py-2"
                                     style="cursor:pointer;border-bottom:1px solid #f0f0f0;"
                                     data-id="@c.Cliente_Id"
                                     data-nombre="@c.Usuario?.Nombre @c.Usuario?.Primer_Apellido @c.Usuario?.Segundo_Apellido"
                                     data-cedula="@c.Usuario?.Cedula">
                                    <div class="fw-semibold">@c.Usuario?.Nombre @c.Usuario?.Primer_Apellido @c.Usuario?.Segundo_Apellido</div>
                                    <div class="text-muted small">Cédula: @c.Usuario?.Cedula</div>
                                </div>
                            }
                        </div>

                        <input type="hidden" asp-for="Cliente_Id" id="clienteIdHidden" />

                        <div id="clienteSeleccionado" class="mt-2" style="display:none;">
                            <span class="badge bg-success px-3 py-2 fs-6" id="clienteNombreBadge"></span>
                            <button type="button" class="btn btn-sm btn-outline-danger ms-2 rounded-3" id="btnLimpiar">
                                <i class="bi bi-x me-1"></i>Cambiar
                            </button>
                        </div>

                        <span asp-validation-for="Cliente_Id" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Servicio" class="form-label fw-semibold">Servicio</label>
                        <input asp-for="Servicio" class="form-control rounded-3" />
                        <span asp-validation-for="Servicio" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Fecha" class="form-label fw-semibold">Fecha y Hora</label>
                        <input asp-for="Fecha" type="datetime-local" class="form-control rounded-3"
                               min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                        <span asp-validation-for="Fecha" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Observaciones" class="form-label fw-semibold">Observaciones</label>
                        <textarea asp-for="Observaciones" class="form-control rounded-3" rows="3"></textarea>
                    </div>

                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-3">
                        <i class="bi bi-arrow-left me-1"></i>Volver
                    </a>
                    <button type="submit" class="btn btn-success rounded-3" id="btnGuardar">
                        <i class="bi bi-save me-1"></i>Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const items = Array.from(document.querySelectorAll('.cliente-item'));
        const $     = id => document.getElementById(id);

        $('buscadorCliente').addEventListener('input', e =>
            items.forEach(i => i.style.display =
                (i.dataset.nombre + i.dataset.cedula).toLowerCase()
                    .includes(e.target.value.toLowerCase()) ? '' : 'none'));

        items.forEach(i => {
            i.addEventListener('mouseenter', () => i.style.background = '#f0f7ff');
            i.addEventListener('mouseleave', () => i.style.background = 'white');
            i.addEventListener('click', () => {
                $('clienteIdHidden').value      = i.dataset.id;
                $('clienteNombreBadge').textContent = `${i.dataset.nombre} — ${i.dataset.cedula}`;
                $('clienteSeleccionado').style.display = 'block';
                $('listaClientes').style.display = $('buscadorCliente').style.display = 'none';
            });
        });

        $('btnLimpiar').addEventListener('click', () => {
            $('clienteIdHidden').value = $('buscadorCliente').value = '';
            $('clienteSeleccionado').style.display = 'none';
            $('listaClientes').style.display = $('buscadorCliente').style.display = '';
            items.forEach(i => i.style.display = '');
        });

        document.querySelector('form').addEventListener('submit', function () {
            const btn = document.getElementById('btnGuardar');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Guardando...';
        });
    </script>
}