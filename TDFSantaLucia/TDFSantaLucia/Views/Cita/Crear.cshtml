@model TDFSantaLucia.Models.CitaViewModel
@{
    ViewData["Title"] = "Crear Cita";
}

<div class="container mt-4">
    <h2 class="mb-4">➕ Nueva Cita</h2>
    <form asp-action="Crear" method="post" class="card p-4 shadow-sm">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="row g-3">

            <div class="col-md-6">
                <label class="form-label">Cliente</label>

                <input type="text" id="buscadorCliente" class="form-control mb-2"
                       placeholder="🔍 Buscar por nombre, apellido o cédula..."
                       autocomplete="off" />

                <div id="listaClientes"
                     style="max-height:220px; overflow-y:auto; border:1px solid #dee2e6;
                            border-radius:10px; background:white;">
                    @foreach (var c in Model.Clientes)
                    {
                        <div class="cliente-item px-3 py-2"
                             style="cursor:pointer; border-bottom:1px solid #f0f0f0;"
                             data-id="@c.Cliente_Id"
                             data-nombre="@c.Usuario?.Nombre @c.Usuario?.Primer_Apellido @c.Usuario?.Segundo_Apellido"
                             data-cedula="@c.Usuario?.Cedula">
                            <div class="fw-semibold">@c.Usuario?.Nombre @c.Usuario?.Primer_Apellido @c.Usuario?.Segundo_Apellido</div>
                            <div class="text-muted" style="font-size:0.82rem;">Cédula: @c.Usuario?.Cedula</div>
                        </div>
                    }
                </div>

                <input type="hidden" asp-for="Cliente_Id" id="clienteIdHidden" />

                <div id="clienteSeleccionado" class="mt-2" style="display:none;">
                    <span class="badge bg-success px-3 py-2 fs-6" id="clienteNombreBadge"></span>
                    <button type="button" class="btn btn-sm btn-outline-danger ms-2" id="btnLimpiar">✕ Cambiar</button>
                </div>

                <span asp-validation-for="Cliente_Id" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Servicio" class="form-label">Servicio</label>
                <input asp-for="Servicio" class="form-control" />
                <span asp-validation-for="Servicio" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Fecha" class="form-label">Fecha y Hora</label>
                <input asp-for="Fecha" type="datetime-local" class="form-control"
                       min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                <span asp-validation-for="Fecha" class="text-danger"></span>
            </div>

            <div class="col-md-12">
                <label asp-for="Observaciones" class="form-label">Observaciones</label>
                <textarea asp-for="Observaciones" class="form-control" rows="3"></textarea>
            </div>
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a asp-action="Index" class="btn btn-secondary">⬅ Volver</a>
            <button type="submit" class="btn btn-success">✔ Guardar</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />


    <script>
        const items = Array.from(document.querySelectorAll('.cliente-item'));
        const $ = id => document.getElementById(id);

        document.getElementById('buscadorCliente').addEventListener('input', e =>
            items.forEach(i => i.style.display =
                (i.dataset.nombre + i.dataset.cedula).toLowerCase().includes(e.target.value.toLowerCase()) ? '' : 'none'));

        items.forEach(i => {
            i.addEventListener('mouseenter', () => i.style.background = '#f0f7ff');
            i.addEventListener('mouseleave', () => i.style.background = 'white');
            i.addEventListener('click', () => {
                $('clienteIdHidden').value = i.dataset.id;
                $('clienteNombreBadge').textContent = `${i.dataset.nombre} — ${i.dataset.cedula}`;
                $('clienteSeleccionado').style.display = 'block';
                $('listaClientes').style.display = $('buscadorCliente').style.display = 'none';
            });
        });

        $('btnLimpiar').addEventListener('click', () => {
            $('clienteIdHidden').value = $('buscadorCliente').value = '';
            $('clienteSeleccionado').style.display = 'none';
            $('listaClientes').style.display = $('buscadorCliente').style.display = '';
            items.forEach(i => i.style.display = '');
        });
    </script>
}
}