@model TDFSantaLucia.Models.Cita
@{
    ViewData["Title"] = "Detalle Cita";
}

<div class="container py-4" style="max-width:700px;">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <h2 class="fw-bold mb-4" style="color:#1a3c5e;">
                <i class="bi bi-calendar-event-fill me-2 text-primary"></i>Detalle de Cita
            </h2>

            <div class="d-flex justify-content-between align-items-start mb-3">
                <h4 class="fw-bold mb-0" style="color:#1a3c5e;">@Model.Servicio</h4>
                @if (Model.Estado == "Aceptada")
                {
                    <span class="badge bg-success fs-6">✔ Aceptada</span>
                }
                else if (Model.Estado == "Cancelada")
                {
                    <span class="badge bg-danger fs-6">✖ Cancelada</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark fs-6">⏳ En Proceso</span>
                }
            </div>

            <hr />

            <div class="row g-4">
                <div class="col-md-6">
                    <p class="text-muted small mb-1">CLIENTE</p>
                    <p class="fw-semibold">
                        @Model.Cliente?.Usuario?.Nombre @Model.Cliente?.Usuario?.Primer_Apellido
                    </p>
                </div>
                <div class="col-md-6">
                    <p class="text-muted small mb-1">FECHA</p>
                    <p class="fw-semibold">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
                <div class="col-md-6">
                    <p class="text-muted small mb-1">EMPLEADO</p>
                    @if (Model.Empleado != null)
                    {
                        <p class="fw-semibold">
                            @Model.Empleado.Usuario?.Nombre @Model.Empleado.Usuario?.Primer_Apellido
                        </p>
                    }
                    else
                    {
                        <p class="text-muted fst-italic">Sin asignar</p>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Observaciones))
                {
                    <div class="col-12">
                        <p class="text-muted small mb-1">OBSERVACIONES</p>
                        <p class="fw-semibold">@Model.Observaciones</p>
                    </div>
                }
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-3">
                    <i class="bi bi-arrow-left me-1"></i>Volver
                </a>
                <a asp-action="Revisar" asp-route-id="@Model.Cita_Id"
                   class="btn btn-warning rounded-3 text-white">
                    <i class="bi bi-search me-1"></i>Revisar
                </a>
            </div>

        </div>
    </div>
</div>