@model List<TDFSantaLucia.Models.Cita>
@{
    ViewData["Title"] = "Gestión de Citas";

    var todasParaJs = Model.Select(c => new
    {
        cita_Id = c.Cita_Id,
        cliente = $"{c.Cliente?.Usuario?.Nombre} {c.Cliente?.Usuario?.Primer_Apellido}".Trim(),
        servicio = c.Servicio ?? "",
        fecha = c.Fecha.ToString("yyyy-MM-dd HH:mm"),
        estado = c.Estado,
        empleado = c.Empleado != null
            ? $"{c.Empleado.Usuario?.Nombre} {c.Empleado.Usuario?.Primer_Apellido}".Trim()
            : ""
    });
}

<style>
    .table-responsive {
        overflow: visible !important;
    }
</style>

<div class="container-fluid px-4 py-4">

    @if (TempData["ErrorCita"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorCita"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ExitoCita"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["ExitoCita"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-1" style="color:#1a3c5e;">
                <i class="bi bi-calendar-event me-2 text-primary"></i>
                Gestión de Citas
            </h2>
            <p class="text-muted mb-0">Revisa, asigna y gestiona las citas de clientes</p>
        </div>
        <a asp-action="Crear" class="btn btn-success rounded-3 shadow-sm">
            <i class="bi bi-calendar-plus me-1"></i> Nueva Cita
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label fw-semibold text-muted small">BUSCAR</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" id="buscador"
                               class="form-control border-start-0 ps-0"
                               placeholder="Cliente, servicio o empleado..." />
                        <button class="btn btn-outline-secondary" id="btnLimpiarTexto"
                                type="button" style="display:none;">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-muted small">ESTADO</label>
                    <select id="filtroEstado" class="form-select rounded-3">
                        <option value="">Todos</option>
                        <option value="Aceptada">Aceptada</option>
                        <option value="Cancelada">Cancelada</option>
                        <option value="En Proceso">En Proceso</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button id="btnLimpiarFiltros" class="btn btn-outline-secondary w-100 rounded-3" style="display:none;">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Limpiar
                    </button>
                </div>
                <div class="col-md-2 text-end">
                    <small id="contadorResultados" class="text-muted"></small>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Cliente</th>
                    <th>Servicio</th>
                    <th>Fecha</th>
                    <th class="text-center">Estado</th>
                    <th>Empleado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody id="tablaCitas">
                @foreach (var cita in Model)
                {
                    <tr>
                        <td class="fw-semibold">@cita.Cliente?.Usuario?.Nombre @cita.Cliente?.Usuario?.Primer_Apellido</td>
                        <td>@cita.Servicio</td>
                        <td class="text-muted small">@cita.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-center">
                            @if (cita.Estado == "Aceptada")
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">Aceptada</span>
                            }
                            else if (cita.Estado == "Cancelada")
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Cancelada</span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle">En Proceso</span>
                            }
                        </td>
                        <td>
                            @if (cita.Empleado != null)
                            {
                                @($"{cita.Empleado.Usuario?.Nombre} {cita.Empleado.Usuario?.Primer_Apellido}")
                            }
                            else
                            {
                                <span class="text-muted">Sin asignar</span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="dropdown">
                                <button class="btn btn-outline-secondary btn-sm rounded-3"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow rounded-3">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-action="Revisar" asp-route-id="@cita.Cita_Id">
                                            <i class="bi bi-zoom-in me-2" style="color:#fd8d3c;"></i>Revisar
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item"
                                           asp-action="Detalle" asp-route-id="@cita.Cita_Id">
                                            <i class="bi bi-eye me-2" style="color:#6baed6;"></i>Ver detalle
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div id="estadoVacio" class="text-center py-5 d-none">
        <i class="bi bi-inbox display-4 text-muted"></i>
        <p class="text-muted mt-2">No se encontraron citas con los filtros aplicados.</p>
        <button class="btn btn-outline-secondary btn-sm rounded-3" id="btnLimpiarDesdeVacio">
            Limpiar filtros
        </button>
    </div>

</div>

@section Scripts {
    <script>
        const todasLasCitas = @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(todasParaJs)
            );

        const $buscador          = $('#buscador');
        const $filtroEstado      = $('#filtroEstado');
        const $tabla             = $('#tablaCitas');
        const $estadoVacio       = $('#estadoVacio');
        const $contador          = $('#contadorResultados');
        const $btnLimpiarTexto   = $('#btnLimpiarTexto');
        const $btnLimpiarFiltros = $('#btnLimpiarFiltros');

        function filtrar() {
            const texto  = $buscador.val().trim().toLowerCase();
            const estado = $filtroEstado.val();
            const hay    = texto !== '' || estado !== '';

            $btnLimpiarFiltros.toggle(hay);
            $btnLimpiarTexto.toggle(texto !== '');

            if (!hay) { restaurarVista(); return; }

            const resultado = todasLasCitas.filter(function (c) {
                const coincideTexto = texto === '' ||
                    c.cliente.toLowerCase().includes(texto) ||
                    c.servicio.toLowerCase().includes(texto) ||
                    c.empleado.toLowerCase().includes(texto);
                const coincideEstado = estado === '' || c.estado === estado;
                return coincideTexto && coincideEstado;
            });

            renderTabla(resultado, texto);
        }

        function badgeEstado(estado) {
            if (estado === 'Aceptada')
                return `<span class="badge bg-success-subtle text-success border border-success-subtle">Aceptada</span>`;
            if (estado === 'Cancelada')
                return `<span class="badge bg-danger-subtle text-danger border border-danger-subtle">Cancelada</span>`;
            return `<span class="badge bg-warning-subtle text-warning border border-warning-subtle">En Proceso</span>`;
        }

        function renderTabla(citas, texto) {
            if (citas.length === 0) {
                $tabla.html('');
                $estadoVacio.removeClass('d-none');
                $contador.text('');
                return;
            }

            $estadoVacio.addClass('d-none');
            $contador.html(`<span class="fw-semibold">${citas.length}</span> resultado${citas.length !== 1 ? 's' : ''} encontrado${citas.length !== 1 ? 's' : ''}`);

            let filas = '';
            citas.forEach(function (c) {
                const fechaFormateada = formatearFecha(c.fecha);
                filas += `
                    <tr>
                        <td class="fw-semibold">${resaltar(c.cliente, texto)}</td>
                        <td>${resaltar(c.servicio, texto)}</td>
                        <td class="text-muted small">${fechaFormateada}</td>
                        <td class="text-center">${badgeEstado(c.estado)}</td>
                        <td>${c.empleado ? resaltar(c.empleado, texto) : '<span class="text-muted">Sin asignar</span>'}</td>
                        <td class="text-center">
                            <div class="dropdown">
                                <button class="btn btn-outline-secondary btn-sm rounded-3"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow rounded-3">
                                    <li>
                                        <a class="dropdown-item" href="/cita/revisar/${c.cita_Id}">
                                            <i class="bi bi-zoom-in me-2" style="color:#fd8d3c;"></i>Revisar
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="/cita/detalle/${c.cita_Id}">
                                            <i class="bi bi-eye me-2" style="color:#6baed6;"></i>Ver detalle
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>`;
            });

            $tabla.html(filas);
        }

        function restaurarVista() {
            $estadoVacio.addClass('d-none');
            $btnLimpiarFiltros.hide();
            $btnLimpiarTexto.hide();
            $contador.text('');
            renderTabla(todasLasCitas, '');
        }

        function formatearFecha(fechaStr) {
            const [fecha, hora] = fechaStr.split(' ');
            const partes = fecha.split('-');
            const d = new Date(parseInt(partes[0]), parseInt(partes[1]) - 1, parseInt(partes[2]));
            return `${d.toLocaleDateString('es-CR')} ${hora}`;
        }

        function resaltar(valor, busqueda) {
            if (!busqueda) return escapeHtml(valor);
            const escaped = busqueda.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            return escapeHtml(valor).replace(new RegExp(`(${escaped})`, 'gi'), '<mark class="px-0 bg-warning rounded-1">$1</mark>');
        }

        function escapeHtml(str) {
            return (str ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        $buscador.on('input', filtrar);
        $filtroEstado.on('change', filtrar);
        $btnLimpiarTexto.on('click', () => $buscador.val('').trigger('input').focus());
        $btnLimpiarFiltros.on('click', () => { $buscador.val(''); $filtroEstado.val(''); restaurarVista(); });
        $('#btnLimpiarDesdeVacio').on('click', () => { $buscador.val(''); $filtroEstado.val(''); restaurarVista(); });
    </script>
}