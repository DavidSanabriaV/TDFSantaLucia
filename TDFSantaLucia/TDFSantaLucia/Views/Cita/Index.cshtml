@model List<TDFSantaLucia.Models.Cita>

@{
    ViewData["Title"] = "Gestión de Citas";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>🗓️ Gestión de Citas</h2>
        <a asp-action="Crear" class="btn btn-success">➕ Nueva Cita</a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Cliente</th>
                <th>Servicio</th>
                <th>Fecha</th>
                <th>Estado</th>
                <th>Empleado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cita in Model)
            {
                <tr>
                    <td>@cita.Cliente?.Usuario?.Nombre @cita.Cliente?.Usuario?.Primer_Apellido</td>
                    <td>@cita.Servicio</td>
                    <td>@cita.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        @if (cita.Estado == "Aceptada")
                        {
                            <span class="badge bg-success">✔ Aceptada</span>
                        }
                        else if (cita.Estado == "Cancelada")
                        {
                            <span class="badge bg-danger">✖ Cancelada</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">⏳ En Proceso</span>
                        }
                    </td>
                    <td>
                        @if (cita.Empleado != null)
                        {
                            @($"{cita.Empleado.Usuario?.Nombre} {cita.Empleado.Usuario?.Primer_Apellido}")
                        }
                        else
                        {
                            <span class="text-muted">Sin asignar</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Revisar" asp-route-id="@cita.Cita_Id"
                           class="btn btn-primary btn-sm">🔍 Revisar</a>
                        <a asp-action="Detalle" asp-route-id="@cita.Cita_Id"
                           class="btn btn-info btn-sm">Ver</a>
                        <form asp-action="Eliminar" asp-route-id="@cita.Cita_Id"
                              method="post" style="display:inline"
                              onsubmit="return confirm('¿Eliminar esta cita?')">
                            <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>