@model List<TDFSantaLucia.Models.Cita>
@{
    ViewData["Title"] = "Gestión de Citas";
}


<style>
    .table-responsive {
        overflow: visible !important;
    }
</style>

<div class="container-fluid px-4 py-4">

    @if (TempData["ErrorCita"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorCita"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ExitoCita"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["ExitoCita"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-1" style="color:#1a3c5e;">
                <i class="bi bi-calendar-event me-2 text-primary"></i>
                Gestión de Citas
            </h2>
            <p class="text-muted mb-0">Revisa, asigna y gestiona las citas de clientes</p>
        </div>
        <a asp-action="Crear" class="btn btn-primary rounded-3 shadow-sm">
            <i class="bi bi-calendar-plus me-1"></i> Nueva Cita
        </a>
    </div>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Cliente</th>
                <th>Servicio</th>
                <th>Fecha</th>
                <th>Estado</th>
                <th>Empleado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cita in Model)
            {
                <tr>
                    <td>@cita.Cliente?.Usuario?.Nombre @cita.Cliente?.Usuario?.Primer_Apellido</td>
                    <td>@cita.Servicio</td>
                    <td>@cita.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        @if (cita.Estado == "Aceptada")
                        {
                            <span class="badge bg-success">Aceptada</span>
                        }
                        else if (cita.Estado == "Cancelada")
                        {
                            <span class="badge bg-danger">Cancelada</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">En Proceso</span>
                        }
                    </td>
                    <td>
                        @if (cita.Empleado != null)
                        {
                            @($"{cita.Empleado.Usuario?.Nombre} {cita.Empleado.Usuario?.Primer_Apellido}")
                        }
                        else
                        {
                            <span class="text-muted">Sin asignar</span>
                        }
                    </td>
                    <td class="text-center">
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary btn-sm rounded-3"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow rounded-3">
                                <li>
                                    <a class="dropdown-item"
                                       asp-action="Revisar" asp-route-id="@cita.Cita_Id">
                                        <i class="bi bi-zoom-in me-2" style="color:#6baed6;"></i>Revisar
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item"
                                       asp-action="Detalle" asp-route-id="@cita.Cita_Id">
                                        <i class="bi bi-eye me-2" style="color:#6baed6;"></i>Ver detalle
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>