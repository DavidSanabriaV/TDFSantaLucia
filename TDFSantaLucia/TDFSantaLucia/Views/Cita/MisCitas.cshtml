@model List<TDFSantaLucia.Models.Cita>
@{
    ViewData["Title"] = "Mis Citas";
}

<div class="container py-4">

    <h2 class="fw-bold mb-4" style="color:#243C8F;">
        <i class="bi bi-calendar-event-fill me-2"></i>Mis Citas
    </h2>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-calendar-x display-3 text-muted"></i>
            <p class="text-muted mt-3">No tienes citas agendadas.</p>
            <a asp-action="Agendar" class="btn btn-primary mt-2 rounded-3">
                <i class="bi bi-plus-circle me-1"></i>Agendar una cita
            </a>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var cita in Model)
            {
                var badgeColor = cita.Estado switch
                {
                    "Aceptada" => "success",
                    "Cancelada" => "danger",
                    _ => "warning text-dark"
                };

                var icono = cita.Estado switch
                {
                    "Aceptada" => "bi-check-circle-fill",
                    "Cancelada" => "bi-x-circle-fill",
                    _ => "bi-hourglass-split"
                };

                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-4">

                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h5 class="fw-bold mb-0" style="color:#243C8F;">
                                    @cita.Servicio
                                </h5>
                                <span class="badge bg-@badgeColor fs-6">
                                    <i class="bi @icono me-1"></i>@cita.Estado
                                </span>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <p class="text-muted small mb-1">FECHA</p>
                                    <p class="fw-semibold mb-0">
                                        @cita.Fecha.ToString("dd/MM/yyyy")
                                    </p>
                                    <p class="text-muted small">@cita.Fecha.ToString("HH:mm")</p>
                                </div>
                                <div class="col-6">
                                    <p class="text-muted small mb-1">EMPLEADO</p>
                                    @if (cita.Empleado != null)
                                    {
                                        <p class="fw-semibold mb-0">
                                            @cita.Empleado.Usuario?.Nombre
                                            @cita.Empleado.Usuario?.Primer_Apellido
                                        </p>
                                    }
                                    else
                                    {
                                        <p class="text-muted fst-italic mb-0 small">Sin asignar</p>
                                    }
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(cita.Observaciones))
                            {
                                <div class="mb-3">
                                    <p class="text-muted small mb-1">OBSERVACIONES</p>
                                    <p class="small mb-0">@cita.Observaciones</p>
                                </div>
                            }

                            <a asp-action="DetalleCliente" asp-route-id="@cita.Cita_Id"
                               class="btn btn-outline-primary btn-sm rounded-3 w-100">
                                <i class="bi bi-eye me-1"></i>Ver Detalle
                            </a>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>