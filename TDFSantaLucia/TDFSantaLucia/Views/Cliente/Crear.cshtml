@model TDFSantaLucia.Models.ClienteViewModel
@{
    ViewData["Title"] = "Crear Cliente";
}

<div class="container mt-4">
    <h2 class="mb-4">➕ Nuevo Cliente</h2>

    <form asp-action="Crear" method="post" class="card p-4 shadow-sm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <h5 class="mb-3">Datos Personales</h5>

        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="Nombre" class="form-label">Nombre</label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Primer_Apellido" class="form-label">Primer Apellido</label>
                <input asp-for="Primer_Apellido" class="form-control" />
                <span asp-validation-for="Primer_Apellido" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Segundo_Apellido" class="form-label">Segundo Apellido</label>
                <input asp-for="Segundo_Apellido" class="form-control" />
                <span asp-validation-for="Segundo_Apellido" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Email" class="form-label">Correo</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Password" class="form-label">Contraseña</label>
                <div class="input-group">
                    <!-- type="text" para que ASP.NET repopule el valor al volver con errores -->
                    <input asp-for="Password"
                           type="text"
                           class="form-control"
                           id="passwordInput"
                           placeholder="Mínimo 6 caracteres" />
                    <button type="button"
                            class="btn btn-outline-secondary"
                            onclick="togglePassword()">
                        👁
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Cedula" class="form-label">Cédula</label>
                <input asp-for="Cedula"
                       class="form-control"
                       maxlength="9"
                       oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0,9)" />
                <span asp-validation-for="Cedula" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Telefono" class="form-label">Teléfono</label>
                <input asp-for="Telefono"
                       class="form-control"
                       maxlength="8"
                       oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0,8)" />
                <span asp-validation-for="Telefono" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Fecha_Nacimiento" class="form-label">Fecha Nacimiento</label>
                <input asp-for="Fecha_Nacimiento"
                       type="date"
                       class="form-control"
                       max="@DateTime.Now.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="Fecha_Nacimiento" class="text-danger"></span>
            </div>

            <div class="col-md-8">
                <label asp-for="Direccion_Exacta" class="form-label">Dirección</label>
                <input asp-for="Direccion_Exacta" class="form-control" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Estado</label>
                <div class="form-check mt-2">
                    <input asp-for="Estado" class="form-check-input" type="checkbox" />
                    <label asp-for="Estado" class="form-check-label">Activo</label>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a asp-action="Index" class="btn btn-secondary">⬅ Volver</a>
            <button type="submit" class="btn btn-success">✔ Guardar</button>
        </div>
    </form>
</div>

<script>
    // Iniciar como password al cargar la página
    document.getElementById('passwordInput').type = 'password';

    function togglePassword() {
        const input = document.getElementById("passwordInput");
        input.type = input.type === "password" ? "text" : "password";
    }
</script>

<style>
    input[type="password"]::-ms-reveal,
    input[type="password"]::-ms-clear {
        display: none;
    }
</style>