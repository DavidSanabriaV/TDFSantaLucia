@model List<TDFSantaLucia.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>👤 Clientes</h2>
        <a asp-action="Crear" class="btn btn-success">➕ Nuevo Cliente</a>
    </div>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>Cédula</th>
                <th>Correo</th>
                <th>Teléfono</th>
                <th>Estado</th>
                <th>Puntos</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cliente in Model)
            {
                <tr>
                    <td>@cliente.Usuario.Nombre @cliente.Usuario.Primer_Apellido @cliente.Usuario.Segundo_Apellido</td>
                    <td>@cliente.Usuario.Cedula</td>
                    <td>@cliente.Usuario.Email</td>
                    <td>@cliente.Usuario.Telefono</td>
                    <td>
                        @if (cliente.Usuario.Estado)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactivo</span>
                        }
                    </td>
                    <td>@cliente.Puntos_Acumulados</td>
                    <td>
                        <a asp-action="Detalle" asp-route-id="@cliente.Cliente_Id"
                           class="btn btn-primary btn-sm">Ver</a>
                        <a asp-action="Editar" asp-route-id="@cliente.Cliente_Id"
                           class="btn btn-warning btn-sm">Editar</a>
                        <form asp-action="Eliminar" asp-route-id="@cliente.Cliente_Id"
                              method="post" style="display:inline"
                              onsubmit="return confirm('¿Desea eliminar este cliente?')">
                            <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>