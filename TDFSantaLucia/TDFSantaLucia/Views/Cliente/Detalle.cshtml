@model TDFSantaLucia.Models.Cliente

@{
    ViewData["Title"] = "Detalle Cliente";
}

<div class="container mt-4">
    <h2 class="mb-4">👤 Detalle del Cliente</h2>

    <div class="card shadow-sm p-4" style="max-width: 700px;">
        <h5 class="card-title">
            @Model.Usuario.Nombre @Model.Usuario.Primer_Apellido @Model.Usuario.Segundo_Apellido
        </h5>

        <hr />

        <div class="row">
            <div class="col-md-6">
                <p><strong>Cédula:</strong> @Model.Usuario.Cedula</p>
                <p><strong>Correo:</strong> @Model.Usuario.Email</p>
                <p><strong>Teléfono:</strong> @Model.Usuario.Telefono</p>
                <p><strong>Dirección:</strong> @Model.Usuario.Direccion_Exacta</p>
            </div>
            <div class="col-md-6">
                <p><strong>Fecha Nacimiento:</strong> @Model.Fecha_Nacimiento?.ToShortDateString()</p>
                <p><strong>Puntos Acumulados:</strong> @Model.Puntos_Acumulados</p>
                <p>
                    <strong>Estado:</strong>
                    @if (Model.Usuario.Estado)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactivo</span>
                    }
                </p>
            </div>
        </div>

        <div class="d-flex justify-content-between mt-3">
            <a asp-action="Index" class="btn btn-secondary">⬅ Volver</a>
            <a asp-action="Editar" asp-route-id="@Model.Cliente_Id" class="btn btn-warning">✏️ Editar</a>
        </div>
    </div>
</div>