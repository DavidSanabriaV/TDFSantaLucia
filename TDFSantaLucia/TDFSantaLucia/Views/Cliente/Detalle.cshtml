@model TDFSantaLucia.Models.Cliente
@{
    ViewData["Title"] = "Detalle Cliente";
}

<div class="container py-4" style="max-width:750px;">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <h2 class="fw-bold mb-4" style="color:#1a3c5e;">
                <i class="bi bi-person-fill me-2 text-primary"></i>Detalle del Cliente
            </h2>

            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="rounded-circle bg-primary text-white d-flex align-items-center
                    justify-content-center fw-bold"
                     style="width:56px;height:56px;font-size:22px;flex-shrink:0;">
                    @Model.Usuario.Nombre[0].ToString().ToUpper()
                </div>
                <div>
                    <h4 class="fw-bold mb-0" style="color:#1a3c5e;">
                        @Model.Usuario.Nombre @Model.Usuario.Primer_Apellido @Model.Usuario.Segundo_Apellido
                    </h4>
                    <small class="text-muted">@Model.Usuario.UserName</small>
                </div>
                <div class="ms-auto">
                    @if (Model.Usuario.Estado)
                    {
                        <span class="badge bg-success fs-6">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger fs-6">Inactivo</span>
                    }
                </div>
            </div>

            <hr />

            <div class="row g-4">
                <div class="col-md-6">
                    <p class="text-muted small mb-1">CÉDULA</p>
                    <p class="fw-semibold">@(Model.Usuario.Cedula ?? "—")</p>
                </div>
                <div class="col-md-6">
                    <p class="text-muted small mb-1">CORREO</p>
                    <p class="fw-semibold">@(Model.Usuario.Email ?? "—")</p>
                </div>
                <div class="col-md-6">
                    <p class="text-muted small mb-1">TELÉFONO</p>
                    <p class="fw-semibold">@(Model.Usuario.Telefono ?? "—")</p>
                </div>
                <div class="col-md-6">
                    <p class="text-muted small mb-1">FECHA NACIMIENTO</p>
                    <p class="fw-semibold">
                        @(Model.Fecha_Nacimiento?.ToString("dd/MM/yyyy") ?? "—")
                    </p>
                </div>
                <div class="col-md-12">
                    <p class="text-muted small mb-1">DIRECCIÓN</p>
                    <p class="fw-semibold">@(Model.Usuario.Direccion_Exacta ?? "—")</p>
                </div>
                <div class="col-md-6">
                    <p class="text-muted small mb-1">PUNTOS ACUMULADOS</p>
                    <p>
                        <span class="badge bg-warning text-dark fs-6">
                            <i class="bi bi-star-fill me-1"></i>@Model.Puntos_Acumulados pts
                        </span>
                    </p>
                </div>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-3">
                    <i class="bi bi-arrow-left me-1"></i>Volver
                </a>
                <a asp-action="Editar" asp-route-id="@Model.Cliente_Id"
                   class="btn btn-warning rounded-3 text-white">
                    <i class="bi bi-pencil me-1"></i>Editar
                </a>
            </div>

        </div>
    </div>
</div>