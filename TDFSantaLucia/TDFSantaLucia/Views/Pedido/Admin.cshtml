@model List<TDFSantaLucia.Models.Pedido>
@{
    ViewData["Title"] = "Gestión de Pedidos";
}

@functions {
    string EstadoLegible(string estado) => estado switch
    {
        "EnProceso" => "En Proceso",
        "EnCamino" => "En Camino",
        _ => estado
    };

    string BadgeEstado(string estado) => estado switch
    {
        "Pendiente" => "bg-warning-subtle text-warning border border-warning-subtle",
        "Aceptado" => "bg-info-subtle text-info border border-info-subtle",
        "EnProceso" => "bg-primary-subtle text-primary border border-primary-subtle",
        "Listo" => "bg-success-subtle text-success border border-success-subtle",
        "EnCamino" => "bg-primary-subtle text-primary border border-primary-subtle",
        "Entregado" => "bg-success-subtle text-success border border-success-subtle",
        "Rechazado" => "bg-danger-subtle text-danger border border-danger-subtle",
        "Cancelado" => "bg-secondary-subtle text-secondary border border-secondary-subtle",
        _ => "bg-secondary-subtle text-secondary border border-secondary-subtle"
    };
}

<style>
    .table-responsive {
        overflow: visible !important;
    }
</style>

<div class="container-fluid py-4">
    <h2 class="fw-bold mb-4" style="color:#243C8F;">
        <i class="bi bi-clipboard2-check me-2"></i>Gestión de Pedidos
    </h2>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm">
            <i class="bi bi-check-circle me-2"></i>@TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-semibold text-muted small">ESTADO</label>
                <select name="estado" class="form-select rounded-3" asp-items="ViewBag.Estados">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold text-muted small">DESDE</label>
                <input type="date" name="desde" class="form-control rounded-3" value="@ViewBag.Desde" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold text-muted small">HASTA</label>
                <input type="date" name="hasta" class="form-control rounded-3" value="@ViewBag.Hasta" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn w-100 rounded-3"
                        style="background-color:#d6e4f0; color:#1a3c5e; border:none;">
                    <i class="bi bi-search me-1"></i>Filtrar
                </button>
            </div>
        </form>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Orden</th>
                    <th>Cliente</th>
                    <th>Fecha</th>
                    <th>Entrega</th>
                    <th>Pago</th>
                    <th class="text-center">Total</th>
                    <th class="text-center">Descuentos</th>
                    <th class="text-center">Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    var esDomicilio = p.Tipo_Entrega == "Domicilio";

                    var metodoPagoHtml = p.Metodo_Pago switch
                    {
                        "Efectivo" => "<i class='bi bi-cash me-1'></i>Efectivo",
                        "Tarjeta" => "<i class='bi bi-credit-card me-1'></i>Tarjeta",
                        "Sinpe" => "<i class='bi bi-phone me-1'></i>Sinpe",
                        "Transferencia" => "<i class='bi bi-bank me-1'></i>Transferencia",
                        null or "" => "<span class='text-muted'>—</span>",
                        var m => m
                    };

                    var puedeCobrar = !esDomicilio && p.Estado == "Aceptado";

                    var subtotal = p.DetallesPedido.Sum(d => d.Subtotal);
                    var impuesto = Math.Round(subtotal * 0.13m, 2);
                    var descCupon = Math.Max(0, subtotal + impuesto - p.Descuento_Puntos - p.Total);
                    var tieneDesc = p.Uso_Puntos || p.Cupon_Id.HasValue;

                    <tr>
                        <td class="fw-bold" style="color:#243C8F;">@p.Numero_Orden</td>
                        <td>@p.Cliente?.Usuario?.Nombre @p.Cliente?.Usuario?.Primer_Apellido</td>
                        <td class="text-muted small">@p.Fecha_Creacion.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @if (esDomicilio)
                            {
                                <span class="badge bg-info-subtle text-info border border-info-subtle">
                                    <i class="bi bi-truck me-1"></i>Domicilio
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                    <i class="bi bi-shop me-1"></i>Tienda
                                </span>
                            }
                        </td>
                        <td>@Html.Raw(metodoPagoHtml)</td>
                        <td class="text-center fw-bold text-success">
                            ₡@p.Total.ToString("N2")
                        </td>
                        <td class="text-center">
                            @if (!tieneDesc)
                            {
                                <span class="text-muted small">—</span>
                            }
                            else
                            {
                                <div class="d-flex flex-column gap-1 align-items-center">
                                    @if (p.Uso_Puntos && p.Puntos_Canjeados > 0)
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle" style="font-size:0.7rem;">
                                            <i class="bi bi-star-fill me-1"></i>
                                            @p.Puntos_Canjeados pts
                                        </span>
                                    }
                                    @if (p.Cupon_Id.HasValue && descCupon > 0)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size:0.7rem;">
                                            <i class="bi bi-ticket-perforated-fill me-1"></i>
                                            -₡@descCupon.ToString("N2")
                                        </span>
                                    }
                                </div>
                            }
                        </td>
                        <td class="text-center">
                            <span class="badge @BadgeEstado(p.Estado)">@EstadoLegible(p.Estado)</span>
                        </td>
                        <td class="text-center">
                            <div class="dropdown">
                                <button class="btn btn-outline-secondary btn-sm rounded-3"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow rounded-3">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-action="Detalle" asp-route-id="@p.Pedido_Id"
                                           asp-route-desde="admin">
                                            <i class="bi bi-eye me-2" style="color:#6baed6;"></i>Ver detalle
                                        </a>
                                    </li>
                                    <li>
                                        <button type="button" class="dropdown-item"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalEstado-@p.Pedido_Id">
                                            <i class="bi bi-arrow-repeat me-2" style="color:#fd8d3c;"></i>Cambiar estado
                                        </button>
                                    </li>
                                    @if (puedeCobrar)
                                    {
                                        <li>
                                            <button type="button" class="dropdown-item"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalCobrar-@p.Pedido_Id">
                                                <i class="bi bi-cash-coin me-2" style="color:#74c476;"></i>Cobrar pedido
                                            </button>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@foreach (var p in Model)
{
    var esDomicilio = p.Tipo_Entrega == "Domicilio";

    var estadosTienda = new[] { "Aceptado", "Rechazado", "Cancelado" };
    var estadosDomicilio = new[] { "EnProceso", "EnCamino", "Entregado", "Cancelado", "Listo" };
    var estadosDisponibles = esDomicilio ? estadosDomicilio : estadosTienda;
    var puedeCobrar = !esDomicilio && p.Estado == "Aceptado";

    <div class="modal fade" id="modalEstado-@p.Pedido_Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header" style="background:#243C8F; color:white;">
                    <h5 class="modal-title">
                        <i class="bi bi-arrow-repeat me-2"></i>Cambiar estado — @p.Numero_Orden
                    </h5>
                    <button type="button" class="btn-close btn-close-white"
                            data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3">
                        Estado actual: <strong>@EstadoLegible(p.Estado)</strong>
                    </p>

                    @{
                        var subtotal = p.DetallesPedido.Sum(d => d.Subtotal);
                        var impuesto = Math.Round(subtotal * 0.13m, 2);
                        var descCupon = Math.Max(0, subtotal + impuesto - p.Descuento_Puntos - p.Total);
                    }
                    @if (p.Uso_Puntos || p.Cupon_Id.HasValue)
                    {
                        <div class="card border-0 bg-light rounded-3 p-3 mb-3">
                            <p class="fw-semibold small mb-2 text-muted">DESCUENTOS APLICADOS</p>
                            @if (p.Uso_Puntos && p.Puntos_Canjeados > 0)
                            {
                                <div class="d-flex justify-content-between small mb-1">
                                    <span>
                                        <i class="bi bi-star-fill text-warning me-1"></i>
                                        Puntos (@p.Puntos_Canjeados pts)
                                    </span>
                                    <span class="text-danger fw-semibold">
                                        -₡@p.Descuento_Puntos.ToString("N2")
                                    </span>
                                </div>
                            }
                            @if (p.Cupon_Id.HasValue && descCupon > 0)
                            {
                                <div class="d-flex justify-content-between small mb-1">
                                    <span>
                                        <i class="bi bi-ticket-perforated-fill text-success me-1"></i>
                                        Cupón@(p.Cupon != null ? $": {p.Cupon.Descripcion}" : "")
                                    </span>
                                    <span class="text-success fw-semibold">
                                        -₡@descCupon.ToString("N2")
                                    </span>
                                </div>
                            }
                            <hr class="my-2" />
                            <div class="d-flex justify-content-between small fw-bold">
                                <span>Total pagado</span>
                                <span style="color:#243C8F;">₡@p.Total.ToString("N2")</span>
                            </div>
                        </div>
                    }

                    <div class="d-grid gap-2">
                        @foreach (var est in estadosDisponibles)
                        {
                            <form asp-action="CambiarEstado" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="pedidoId" value="@p.Pedido_Id" />
                                <input type="hidden" name="nuevoEstado" value="@est" />
                                <button type="submit" class="btn w-100 rounded-3"
                                        style="@(p.Estado == est
                                            ? "background-color:#d6e4f0; color:#1a3c5e; border:none;"
                                            : "background-color:#e2e6ea; color:#495057; border:none;")">
                                    @EstadoLegible(est)
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (puedeCobrar)
    {
        <div class="modal fade" id="modalCobrar-@p.Pedido_Id" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-4 border-0 shadow">
                    <div class="modal-header" style="background:#198754; color:white;">
                        <h5 class="modal-title">
                            <i class="bi bi-cash-coin me-2"></i>Cobrar — @p.Numero_Orden
                        </h5>
                        <button type="button" class="btn-close btn-close-white"
                                data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted small mb-1">Total a cobrar:</p>
                        <p class="fw-bold fs-4 text-success mb-1">
                            ₡@p.Total.ToString("N2")
                        </p>

                        @{
                            var subT = p.DetallesPedido.Sum(d => d.Subtotal);
                            var impT = Math.Round(subT * 0.13m, 2);
                            var dcT = Math.Max(0, subT + impT - p.Descuento_Puntos - p.Total);
                        }
                        @if (p.Uso_Puntos || p.Cupon_Id.HasValue)
                        {
                            <div class="mb-3">
                                @if (p.Uso_Puntos && p.Puntos_Canjeados > 0)
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle me-1">
                                        <i class="bi bi-star-fill me-1"></i>
                                        @p.Puntos_Canjeados pts canjeados
                                    </span>
                                }
                                @if (p.Cupon_Id.HasValue && dcT > 0)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        <i class="bi bi-ticket-perforated-fill me-1"></i>
                                        Cupón -₡@dcT.ToString("N2")
                                    </span>
                                }
                            </div>
                        }

                        <div class="card border-0 bg-light rounded-3 p-3 mb-4">
                            <p class="fw-semibold mb-2">
                                <i class="bi bi-calculator me-1"></i>Calculadora de cambio
                            </p>
                            <div class="input-group mb-2">
                                <span class="input-group-text">₡</span>
                                <input type="number" class="form-control"
                                       id="montoRecibido-@p.Pedido_Id"
                                       placeholder="Monto recibido"
                                       min="@p.Total"
                                       step="500"
                                       oninput="calcularCambio('@p.Pedido_Id', @p.Total.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))" />
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted small">Cambio:</span>
                                <span class="fw-bold fs-5 text-success" id="cambioResultado-@p.Pedido_Id">
                                    ₡0,00
                                </span>
                            </div>
                        </div>

                        <p class="text-muted small mb-2">Selecciona el método de pago:</p>
                        <div class="d-grid gap-2">
                            @foreach (var metodo in new[]
                            {
                                ("Efectivo",      "bi-cash",        "#d4edda", "#2d7a4f"),
                                ("Tarjeta",       "bi-credit-card", "#d6e4f0", "#1a3c5e"),
                                ("Sinpe",         "bi-phone",       "#fde8cc", "#d4620a"),
                                ("Transferencia", "bi-bank",        "#d0e8f5", "#2a7ab5")
                            })
                            {
                                <form asp-action="Cobrar" asp-route-id="@p.Pedido_Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="metodoPago" value="@metodo.Item1" />
                                    <button type="submit" class="btn w-100 rounded-3"
                                            style="background-color:@metodo.Item3; color:@metodo.Item4; border:none;">
                                        <i class="bi @metodo.Item2 me-2"></i>@metodo.Item1
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}

@section Scripts {
    <script>
        function calcularCambio(pedidoId, total) {
            const input     = document.getElementById('montoRecibido-' + pedidoId);
            const resultado = document.getElementById('cambioResultado-' + pedidoId);
            const monto     = parseFloat(input.value) || 0;
            const cambio    = monto - total;

            if (cambio < 0) {
                resultado.textContent = 'Monto insuficiente';
                resultado.className   = 'fw-bold fs-5 text-danger';
            } else {
                resultado.textContent = '₡' + cambio.toLocaleString('es-CR', {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
                resultado.className = 'fw-bold fs-5 text-success';
            }
        }
    </script>
}