@model List<TDFSantaLucia.Models.Pedido>
@{
    ViewData["Title"] = "Mis Pedidos";
}

<div class="container py-4">
    <h2 class="fw-bold mb-4" style="color:#243C8F;">
        <i class="bi bi-list-ul me-2"></i>Mis Pedidos
    </h2>

    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-semibold text-muted small">DESDE</label>
                <input type="date" name="desde" class="form-control" value="@ViewBag.Desde" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold text-muted small">HASTA</label>
                <input type="date" name="hasta" class="form-control" value="@ViewBag.Hasta" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold text-muted small">ESTADO</label>
                <select name="estado" class="form-select" asp-items="ViewBag.Estados">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100 rounded-3">
                    <i class="bi bi-search me-1"></i>Filtrar
                </button>
            </div>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-inbox display-3 text-muted"></i>
            <p class="text-muted mt-3">No tienes pedidos registrados.</p>
            <a asp-controller="Producto" asp-action="Index" class="btn btn-primary mt-2">
                <i class="bi bi-bag me-1"></i>Ver productos
            </a>
        </div>
    }
    else
    {
        @foreach (var pedido in Model)
        {
            var badgeColor = pedido.Estado switch
            {
                "Pendiente" => "warning text-dark",
                "Aceptado" => "info text-dark",
                "EnProceso" => "primary",
                "Listo" => "success",
                "EnCamino" => "primary",
                "Entregado" => "success",
                "Rechazado" => "danger",
                "Cancelado" => "secondary",
                _ => "secondary"
            };

            var subtotal = pedido.DetallesPedido.Sum(d => d.Subtotal);
            var impuesto = Math.Round(subtotal * 0.13m, 2);
            var descCupon = Math.Max(0, subtotal + impuesto - pedido.Descuento_Puntos - pedido.Total);
            var tieneDesc = pedido.Uso_Puntos || pedido.Cupon_Id.HasValue;

            <div class="card border-0 shadow-sm rounded-4 mb-3">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                        <div>
                            <h5 class="fw-bold mb-1" style="color:#243C8F;">
                                @pedido.Numero_Orden
                            </h5>
                            <small class="text-muted">
                                @pedido.Fecha_Creacion.ToString("dd/MM/yyyy HH:mm")
                            </small>
                        </div>
                        <span class="badge bg-@badgeColor fs-6">@pedido.Estado</span>
                    </div>

                    <div class="row mt-3 g-2">
                        <div class="col-md-3">
                            <small class="text-muted">Entrega</small>
                            <div class="fw-semibold">@pedido.Tipo_Entrega</div>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted">Total</small>
                            <div class="fw-bold text-success">₡@pedido.Total.ToString("N2")</div>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted">Productos</small>
                            <div>@pedido.DetallesPedido.Count ítem(s)</div>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted">Descuentos</small>
                            <div class="d-flex flex-column gap-1 mt-1">
                                @if (pedido.Uso_Puntos && pedido.Puntos_Canjeados > 0)
                                {
                                    <span class="badge bg-warning text-dark" style="font-size:0.7rem;">
                                        <i class="bi bi-star-fill me-1"></i>
                                        @pedido.Puntos_Canjeados pts
                                    </span>
                                }
                                @if (pedido.Cupon_Id.HasValue && descCupon > 0)
                                {
                                    <span class="badge bg-success" style="font-size:0.7rem;">
                                        <i class="bi bi-ticket-perforated-fill me-1"></i>
                                        Cupón -₡@descCupon.ToString("N2")
                                    </span>
                                }
                                @if (!tieneDesc)
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="mt-3 d-flex gap-2">
                        <a asp-action="Detalle" asp-route-id="@pedido.Pedido_Id"
                           class="btn btn-outline-primary btn-sm rounded-3">
                            <i class="bi bi-eye me-1"></i>Ver detalle
                        </a>
                        @if (pedido.Facturas.Any())
                        {
                            <a asp-controller="Factura" asp-action="Descargar"
                               asp-route-id="@pedido.Facturas.First().Factura_Id"
                               class="btn btn-outline-secondary btn-sm rounded-3">
                                <i class="bi bi-download me-1"></i>Factura
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>