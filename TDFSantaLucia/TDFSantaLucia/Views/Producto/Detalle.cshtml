@model TDFSantaLucia.Models.Producto

@{
    ViewData["Title"] = "Detalle";
}

<div class="container py-5">

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <div class="row g-0">

            <div class="col-md-5 bg-light d-flex align-items-center justify-content-center p-4">

                @{
                    var img =
                    !string.IsNullOrWhiteSpace(Model.Imagen_URL)
                    ? Model.Imagen_URL
                    : Url.Content("~/img/producto-default.png");
                }

                <img src="@img"
                     class="img-fluid rounded-4"
                     style="max-height:350px; object-fit:contain;"
                     onerror="this.src='@Url.Content("~/img/producto-default.png")'" />

            </div>

            <div class="col-md-7">

                <div class="card-body p-4">

                    <span class="badge bg-primary rounded-pill mb-3">
                        @(Model.Categoria?.Nombre ?? "General")
                    </span>

                    <h2 class="fw-bold mb-3" style="color:#1a3c5e;">
                        @Model.Nombre
                    </h2>

                    <p class="text-muted mb-4">
                        @(Model.Descripcion ?? "Sin descripción disponible.")
                    </p>

                    <div class="mb-3">
                        <strong>Marca:</strong>
                        @(Model.Marca ?? "No especificada")
                    </div>

                    <div class="mb-4">
                        <strong>Precio:</strong>

                        <span class="fs-3 fw-bold text-primary">
                            ₡@Model.Precio.ToString("N2")
                        </span>
                    </div>

                    @if (Model.Receta)
                    {
                        <div class="alert alert-warning rounded-3">
                            <i class="bi bi-file-medical me-2"></i>
                            Este producto requiere receta médica.
                        </div>
                    }

                    <div class="d-flex gap-3 mt-4">

                        <a asp-action="Administrar"
                               class="btn btn-outline-secondary rounded-3">
                            Volver
                        </a>

                        <button class="btn btn-primary rounded-3"
                                onclick="agregarAlCarrito(@Model.Producto_Id, '@Model.Nombre')">

                            <i class="bi bi-cart-plus me-1"></i>
                            Agregar al carrito
                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@Html.AntiForgeryToken()

@section Scripts {

    <script>

        function agregarAlCarrito(productoId, nombre) {

            const token =
                document.querySelector('input[name="__RequestVerificationToken"]').value;

            fetch('/producto/agregaralcarrito', {

                method: 'POST',

                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },

                body: `productoId=${productoId}&cantidad=1`
            })

            .then(res => res.json())

            .then(data => {

                if (data.exito)
                    alert(nombre + ' agregado al carrito');
                else
                    alert(data.mensaje);
            });
        }

    </script>

}