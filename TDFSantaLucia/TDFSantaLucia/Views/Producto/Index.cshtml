@model List<TDFSantaLucia.Models.Producto>

@{
    ViewData["Title"] = "Productos";
    var lista = Model ?? new List<TDFSantaLucia.Models.Producto>();
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">

        <div>
            <h2 class="fw-bold mb-1" style="color:#1a3c5e;">
                <i class="bi bi-capsule-pill me-2 text-primary"></i>
                Nuestros Productos
            </h2>

            <p class="text-muted mb-0">
                Encuentra medicamentos y productos fácilmente
            </p>
        </div>

        <a asp-action="Crear" class="btn btn-primary rounded-3 shadow-sm">
            <i class="bi bi-plus-circle me-1"></i>
            Nuevo Producto
        </a>

    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">

            <div class="input-group">
                <span class="input-group-text bg-white border-end-0">
                    <i class="bi bi-search text-muted"></i>
                </span>

                <input id="searchInput"
                       class="form-control border-start-0 ps-0"
                       type="search"
                       placeholder="Buscar por nombre, categoría o marca..." />
            </div>

        </div>
    </div>

    <div class="row g-4">

        @foreach (var p in lista)
        {
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3 producto-card"
                 data-nombre="@p.Nombre?.ToLower()"
                 data-categoria="@p.Categoria?.Nombre?.ToLower()"
                 data-marca="@p.Marca?.ToLower()">

                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">

                    <div class="position-relative">

                        @{
                            var img = !string.IsNullOrWhiteSpace(p.Imagen_URL)
                            ? p.Imagen_URL
                            : Url.Content("~/img/producto-default.png");
                        }

                        <img src="@img"
                             class="card-img-top"
                             style="height:220px; object-fit:cover;"
                             alt="@p.Nombre"
                             onerror="this.src='@Url.Content("~/img/producto-default.png")'" />

                        @if (p.Receta)
                        {
                            <span class="badge bg-warning text-dark position-absolute top-0 start-0 m-2 rounded-pill">
                                <i class="bi bi-file-medical me-1"></i>
                                Receta
                            </span>
                        }

                        <span class="badge bg-primary position-absolute top-0 end-0 m-2 rounded-pill">
                            @(p.Categoria?.Nombre ?? "General")
                        </span>

                    </div>

                    <div class="card-body d-flex flex-column">

                        <h5 class="fw-bold mb-1" style="color:#1a3c5e;">
                            @p.Nombre
                        </h5>

                        <p class="text-muted small mb-2">
                            <i class="bi bi-tag me-1"></i>
                            @(p.Marca ?? "Sin marca")
                        </p>

                        <p class="text-muted small flex-grow-1"
                               style="display:-webkit-box;
                            -webkit-line-clamp:2;
                            -webkit-box-orient:vertical;
                            overflow:hidden;">
                            @(p.Descripcion ?? "Sin descripción.")
                        </p>

                        <div class="mt-3">

                            <h4 class="fw-bold text-primary mb-3">
                                ₡@p.Precio.ToString("N2")
                            </h4>

                            <div class="d-grid gap-2">

                                <a asp-action="Detalle"
                                       asp-route-id="@p.Producto_Id"
                                       class="btn btn-outline-primary rounded-3">
                                    <i class="bi bi-eye me-1"></i>
                                    Ver Detalle
                                </a>

                                <a asp-action="Editar"
                                       asp-route-id="@p.Producto_Id"
                                       class="btn btn-warning rounded-3 text-white">
                                    <i class="bi bi-pencil-square me-1"></i>
                                    Editar
                                </a>

                                <button class="btn btn-primary rounded-3"
                                        onclick="agregarAlCarrito(@p.Producto_Id, '@p.Nombre')">
                                    <i class="bi bi-cart-plus me-1"></i>
                                    Agregar al carrito
                                </button>

                                <button class="btn btn-danger rounded-3"
                                        onclick="eliminarProducto(@p.Producto_Id, '@p.Nombre')">
                                    <i class="bi bi-trash me-1"></i>
                                    Eliminar
                                </button>

                            </div>

                        </div>

                    </div>
                </div>
            </div>
        }

    </div>

</div>

@Html.AntiForgeryToken()

@section Scripts {

    <script>

        (function () {

            const input = document.getElementById('searchInput');

            const cards = Array.from(document.querySelectorAll('.producto-card'));

            function filtrar() {

                const q = input.value.trim().toLowerCase();

                cards.forEach(card => {

                    const nombre =
                        card.dataset.nombre || '';

                    const categoria =
                        card.dataset.categoria || '';

                    const marca =
                        card.dataset.marca || '';

                    const visible =
                        nombre.includes(q) ||
                        categoria.includes(q) ||
                        marca.includes(q);

                    card.classList.toggle('d-none', !visible);
                });
            }

            input.addEventListener('input', filtrar);

        })();

        function agregarAlCarrito(productoId, nombre) {

            const token =
                document.querySelector('input[name="__RequestVerificationToken"]').value;

            fetch('/producto/agregaralcarrito', {

                method: 'POST',

                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },

                body: `productoId=${productoId}&cantidad=1`
            })

            .then(res => res.json())

            .then(data => {

                if (data.exito)
                    alert(nombre + ' agregado al carrito');
                else
                    alert(data.mensaje);
            });
        }

        function eliminarProducto(id, nombre) {

            if (!confirm(`¿Desea eliminar "${nombre}"?`))
                return;

            const token =
                document.querySelector('input[name="__RequestVerificationToken"]').value;

            const form = document.createElement('form');

            form.method = 'POST';

            form.action = `/producto/eliminar/${id}`;

            const input = document.createElement('input');

            input.type = 'hidden';

            input.name = '__RequestVerificationToken';

            input.value = token;

            form.appendChild(input);

            document.body.appendChild(form);

            form.submit();
        }

    </script>

}