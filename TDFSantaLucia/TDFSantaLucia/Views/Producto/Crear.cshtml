@model TDFSantaLucia.Models.Producto

@{
    ViewData["Title"] = "Nuevo Producto";
}

<div class="container py-4" style="max-width:750px;">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <h2 class="fw-bold mb-4 text-primary">
                <i class="bi bi-plus-circle me-2"></i>
                Nuevo Producto
            </h2>

            @if (!ViewData.ModelState.IsValid && ViewContext.HttpContext.Request.Method == "POST")
            {
                <div class="alert alert-danger rounded-3">
                    <h6 class="fw-bold mb-2">
                        <i class="bi bi-exclamation-triangle me-1"></i> Por favor corrija los siguientes errores:
                    </h6>
                    <ul class="mb-0">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form asp-action="Crear" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-4">

                    <div class="col-12">
                        <label asp-for="Nombre" class="form-label fw-semibold"></label>
                        <input asp-for="Nombre"
                               class="form-control rounded-3 @(ViewData.ModelState["Nombre"]?.Errors.Any() == true ? "is-invalid" : "")"
                               placeholder="Ej: Ibuprofeno 400mg..." />
                        <span asp-validation-for="Nombre" class="invalid-feedback"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Categoría</label>
                        <input type="text" id="buscadorCategoria" class="form-control rounded-3 mb-2"
                               placeholder="🔍 Buscar categoría..."
                               autocomplete="off" />
                        <div id="listaCategorias"
                             style="max-height:220px; overflow-y:auto; border:1px solid #dee2e6;
                             border-radius:10px; background:white;">
                            @foreach (var item in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Categorias)
                            {
                                <div class="categoria-item px-3 py-2"
                                     style="cursor:pointer; border-bottom:1px solid #f0f0f0;"
                                     data-id="@item.Value"
                                     data-nombre="@item.Text">
                                    <div class="fw-semibold">@item.Text</div>
                                </div>
                            }
                        </div>
                        <div id="categoriaSeleccionada" class="mt-2" style="display:none;">
                            <span class="badge bg-success px-3 py-2 fs-6" id="categoriaNombreBadge"></span>
                            <button type="button" class="btn btn-sm btn-outline-danger ms-2 rounded-3" id="btnLimpiarCategoria">
                                ✕ Cambiar
                            </button>
                        </div>
                        <input type="hidden" asp-for="Categoria_Id" id="categoriaIdHidden" />
                        <span asp-validation-for="Categoria_Id" class="invalid-feedback d-block"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Marca" class="form-label fw-semibold"></label>
                        <input asp-for="Marca"
                               class="form-control rounded-3"
                               placeholder="Ej: Bayer, Pfizer..." />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Precio" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text rounded-start-3">₡</span>
                            <input asp-for="Precio"
                                   type="number"
                                   step="0.01"
                                   min="500"
                                   max="9999999.99"
                                   class="form-control rounded-end-3 @(ViewData.ModelState["Precio"]?.Errors.Any() == true ? "is-invalid" : "")"
                                   placeholder="500.00" />
                            <span asp-validation-for="Precio" class="invalid-feedback"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Imagen_URL" class="form-label fw-semibold"></label>
                        <input asp-for="Imagen_URL"
                               class="form-control rounded-3"
                               placeholder="https://..." />
                        <div id="previewImagen" class="mt-2 d-none">
                            <img id="imgPreview"
                                 src=""
                                 alt="Vista previa"
                                 class="rounded-3 border"
                                 style="max-height:120px; object-fit:cover;" />
                        </div>
                    </div>

                    <div class="col-12">
                        <label asp-for="Descripcion" class="form-label fw-semibold"></label>
                        <textarea asp-for="Descripcion"
                                  rows="4"
                                  class="form-control rounded-3 @(ViewData.ModelState["Descripcion"]?.Errors.Any() == true ? "is-invalid" : "")"
                                  placeholder="Descripción del producto..."></textarea>
                        <span asp-validation-for="Descripcion" class="invalid-feedback"></span>
                        <small class="text-muted"><span id="contadorDesc">0</span> / 1000 caracteres</small>
                    </div>

                    

                    <div class="col-md-6">
                        <div class="form-check form-switch">
                            <input asp-for="Receta"
                                   class="form-check-input"
                                   type="checkbox" />
                            <label asp-for="Receta" class="form-check-label">Requiere receta</label>
                        </div>
                    </div>

                </div>

                <div class="d-flex justify-content-end gap-3 mt-4">
                    <a asp-action="Administrar" class="btn btn-outline-secondary rounded-3">
                        <i class="bi bi-x-circle me-1"></i> Cancelar
                    </a>
                    <button type="submit" class="btn btn-primary rounded-3" id="btnGuardar">
                        <i class="bi bi-save me-1"></i> Guardar Producto
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const imgInput    = document.getElementById('Imagen_URL');
        const preview     = document.getElementById('previewImagen');
        const imgPreview  = document.getElementById('imgPreview');
        const descripcion = document.getElementById('Descripcion');
        const contador    = document.getElementById('contadorDesc');

        imgInput.addEventListener('input', function () {
            const url = this.value.trim();
            if (url) {
                imgPreview.src = url;
                preview.classList.remove('d-none');
                imgPreview.onerror = () => preview.classList.add('d-none');
            } else {
                preview.classList.add('d-none');
            }
        });

        descripcion.addEventListener('input', function () {
            contador.textContent = this.value.length;
        });
        contador.textContent = descripcion.value.length;

        document.querySelector('form').addEventListener('submit', function () {
            const btn = document.getElementById('btnGuardar');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Guardando...';
        });


        const byId = id => document.getElementById(id);
        const itemsCategoria = Array.from(document.querySelectorAll('.categoria-item'));

        byId('buscadorCategoria').addEventListener('input', function () {
            const texto = this.value.toLowerCase();
            itemsCategoria.forEach(i => {
                i.style.display = i.dataset.nombre.toLowerCase().includes(texto) ? '' : 'none';
            });
        });

        itemsCategoria.forEach(i => {
            i.addEventListener('mouseenter', () => i.style.background = '#f0f7ff');
            i.addEventListener('mouseleave', () => i.style.background = 'white');

            i.addEventListener('click', () => {
                byId('categoriaIdHidden').value          = i.dataset.id;
                byId('categoriaNombreBadge').textContent = i.dataset.nombre;
                byId('categoriaSeleccionada').style.display = 'block';
                byId('listaCategorias').style.display       = 'none';
                byId('buscadorCategoria').style.display     = 'none';
            });
        });

        byId('btnLimpiarCategoria').addEventListener('click', () => {
            byId('categoriaIdHidden').value             = '';
            byId('buscadorCategoria').value             = '';
            byId('categoriaSeleccionada').style.display = 'none';
            byId('listaCategorias').style.display       = '';
            byId('buscadorCategoria').style.display     = '';
            itemsCategoria.forEach(i => i.style.display = '');
        });
    </script>
}