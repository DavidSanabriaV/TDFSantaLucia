@model TDFSantaLucia.Models.Producto

@{
    ViewData["Title"] = "Nuevo Producto";
}

<div class="container py-4" style="max-width:750px;">

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-4">

            <h2 class="fw-bold mb-4 text-primary">
                <i class="bi bi-plus-circle me-2"></i>
                Nuevo Producto
            </h2>

            <form asp-action="Crear">

                @Html.AntiForgeryToken()

                <div class="row g-4">

                    <div class="col-12">
                        <label asp-for="Nombre" class="form-label fw-semibold"></label>
                        <input asp-for="Nombre" class="form-control rounded-3" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Categoria_Id" class="form-label fw-semibold"></label>

                        <select asp-for="Categoria_Id"
                                asp-items="ViewBag.Categorias"
                                class="form-select rounded-3">

                            <option value="">Seleccione</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Marca" class="form-label fw-semibold"></label>
                        <input asp-for="Marca" class="form-control rounded-3" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Precio" class="form-label fw-semibold"></label>

                        <input asp-for="Precio"
                               type="number"
                               step="0.01"
                               class="form-control rounded-3" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Imagen_URL" class="form-label fw-semibold"></label>

                        <input asp-for="Imagen_URL"
                               class="form-control rounded-3" />
                    </div>

                    <div class="col-12">
                        <label asp-for="Descripcion" class="form-label fw-semibold"></label>

                        <textarea asp-for="Descripcion"
                                  rows="4"
                                  class="form-control rounded-3"></textarea>
                    </div>

                    <div class="col-md-6">
                        <div class="form-check form-switch">
                            <input asp-for="Estado"
                                   class="form-check-input"
                                   type="checkbox"
                                   checked />

                            <label asp-for="Estado"
                                   class="form-check-label">
                                Producto activo
                            </label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-check form-switch">
                            <input asp-for="Receta"
                                   class="form-check-input"
                                   type="checkbox" />

                            <label asp-for="Receta"
                                   class="form-check-label">
                                Requiere receta
                            </label>
                        </div>
                    </div>

                </div>

                <div class="d-flex justify-content-end gap-3 mt-4">

                    <a asp-action="Administrar"
                           class="btn btn-outline-secondary rounded-3">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-primary rounded-3">
                        Guardar Producto
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>