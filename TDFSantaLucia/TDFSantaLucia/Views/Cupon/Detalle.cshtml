@model TDFSantaLucia.Models.Cupon
@{
    ViewData["Title"] = "Detalle Cupón";
    var vencido = Model.Fecha_Expiracion < DateTime.Today;
    var clientesDisponibles = ViewBag.ClientesDisponibles as List<TDFSantaLucia.Models.Cliente>;
}

<div class="container mt-4" style="max-width:700px;">
    <h2 class="fw-bold mb-4" style="color:#1a3c5e;">
        <i class="bi bi-ticket-perforated-fill me-2"></i>Detalle del Cupón
    </h2>

    @if (TempData["ExitoCupon"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4">
            <i class="bi bi-check-circle me-2"></i>@TempData["ExitoCupon"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorCupon"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorCupon"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
        <div class="row g-3">
            <div class="col-md-6">
                <p class="text-muted small mb-1">DESCRIPCIÓN</p>
                <p class="fw-semibold">@Model.Descripcion</p>
            </div>
            <div class="col-md-3">
                <p class="text-muted small mb-1">TIPO</p>
                <span class="badge bg-info text-dark">@Model.Tipo_Descuento</span>
            </div>
            <div class="col-md-3">
                <p class="text-muted small mb-1">VALOR</p>
                <p class="fw-bold text-success fs-5">
                    @if (Model.Tipo_Descuento == "Porcentaje")
                    {
                        @($"{Model.Valor_Descuento:G29}%")
                    }
                    else
                    {
                        @($"₡{Model.Valor_Descuento:N2}")
                    }
                </p>
            </div>
            <div class="col-md-4">
                <p class="text-muted small mb-1">FECHA EXPIRACIÓN</p>
                @if (vencido)
                {
                    <span class="badge bg-danger">@Model.Fecha_Expiracion.ToString("dd/MM/yyyy") ❌ Vencido</span>
                }
                else
                {
                    <span class="badge bg-success">@Model.Fecha_Expiracion.ToString("dd/MM/yyyy")</span>
                }
            </div>
            <div class="col-md-4">
                <p class="text-muted small mb-1">CREADO</p>
                <p>@Model.Fecha_Creacion.ToString("dd/MM/yyyy")</p>
            </div>
            <div class="col-md-4">
                <p class="text-muted small mb-1">ESTADO</p>
                @if (Model.Estado && !vencido)
                {
                    <span class="badge bg-success">Activo</span>
                }
                else
                {
                    <span class="badge bg-danger">Inactivo</span>
                }
            </div>
        </div>
    </div>

    <!-- Asignar a cliente -->
    @if (Model.Estado && !vencido)
    {
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
            <h5 class="fw-bold mb-3" style="color:#1a3c5e;">
                <i class="bi bi-person-plus me-2"></i>Asignar a Cliente
            </h5>

            @if (clientesDisponibles == null || !clientesDisponibles.Any())
            {
                <p class="text-muted small mb-0">
                    <i class="bi bi-info-circle me-1"></i>
                    Todos los clientes ya tienen este cupón asignado.
                </p>
            }
            else
            {
                <form asp-action="Asignar" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="cuponId" value="@Model.Cupon_Id" />
                    <div class="col-md-8">
                        <select name="clienteId" class="form-select rounded-3">
                            <option value="">Seleccione un cliente...</option>
                            @foreach (var cliente in clientesDisponibles)
                            {
                                <option value="@cliente.Cliente_Id">
                                    @cliente.Usuario?.Nombre @cliente.Usuario?.Primer_Apellido
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-primary w-100 rounded-3">
                            <i class="bi bi-person-check me-1"></i>Asignar
                        </button>
                    </div>
                </form>
            }
        </div>
    }

    <!-- Clientes con este cupón -->
    @if (Model.ClienteCupones.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
            <h5 class="fw-bold mb-3" style="color:#1a3c5e;">
                <i class="bi bi-people-fill me-2"></i>Clientes con este cupón
            </h5>
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Cliente</th>
                        <th class="text-center">Asignado</th>
                        <th class="text-center">Utilizado</th>
                        <th class="text-center">Fecha uso</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cc in Model.ClienteCupones)
                    {
                        <tr>
                            <td>@cc.Cliente?.Usuario?.Nombre @cc.Cliente?.Usuario?.Primer_Apellido</td>
                            <td class="text-center small">@cc.Fecha_Asignacion.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">
                                @if (cc.Utilizado)
                                {
                                    <span class="badge bg-secondary">Sí</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">No</span>
                                }
                            </td>
                            <td class="text-center small">@(cc.Fecha_Uso?.ToString("dd/MM/yyyy") ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="d-flex justify-content-between">
        <a asp-action="Index" class="btn btn-secondary rounded-3">⬅ Volver</a>
        <a asp-action="Editar" asp-route-id="@Model.Cupon_Id"
           class="btn btn-warning rounded-3 text-white">✏️ Editar</a>
    </div>
</div>