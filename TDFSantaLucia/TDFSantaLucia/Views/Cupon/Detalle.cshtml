@model TDFSantaLucia.Models.Cupon
@{
    ViewData["Title"] = "Detalle Cupón";
    var vencido = Model.Fecha_Expiracion.Date < DateTime.Today;
    var clientesDisponibles = ViewBag.ClientesDisponibles as List<TDFSantaLucia.Models.Cliente>;
    var utilizados = Model.ClienteCupones.Count(cc => cc.Utilizado);
    var disponibles = Model.ClienteCupones.Count(cc => !cc.Utilizado);
}

<div class="container-fluid px-4 py-4" style="max-width:900px;">
    <h2 class="fw-bold mb-4" style="color:#1a3c5e;">
        <i class="bi bi-ticket-perforated-fill me-2"></i>Detalle del Cupón
    </h2>

    @if (TempData["ExitoCupon"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-3">
            <i class="bi bi-check-circle me-2"></i>@TempData["ExitoCupon"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorCupon"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-3">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorCupon"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Info del cupón -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
        <div class="row g-3">
            <div class="col-md-6">
                <p class="text-muted small mb-1">DESCRIPCIÓN</p>
                <p class="fw-bold fs-5">@Model.Descripcion</p>
            </div>
            <div class="col-md-3">
                <p class="text-muted small mb-1">TIPO</p>
                <span class="badge @(Model.Tipo_Descuento == "Porcentaje" ? "bg-info text-dark" : "bg-primary") fs-6">
                    @Model.Tipo_Descuento
                </span>
            </div>
            <div class="col-md-3">
                <p class="text-muted small mb-1">VALOR</p>
                <p class="fw-bold text-success fs-4 mb-0">
                    @if (Model.Tipo_Descuento == "Porcentaje")
                    {
                        @($"{Model.Valor_Descuento:G29}% OFF")
                    }
                    else
                    {
                        @($"₡{Model.Valor_Descuento:N2} OFF")
                    }
                </p>
            </div>
            <div class="col-md-3">
                <p class="text-muted small mb-1">VENCE</p>
                @if (vencido)
                {
                    <span class="badge bg-danger">@Model.Fecha_Expiracion.ToString("dd/MM/yyyy") ❌</span>
                }
                else
                {
                    <span class="badge bg-success">@Model.Fecha_Expiracion.ToString("dd/MM/yyyy")</span>
                }
            </div>
            <div class="col-md-3">
                <p class="text-muted small mb-1">ESTADO</p>
                @if (Model.Estado && !vencido)
                {
                    <span class="badge bg-success fs-6">Activo</span>
                }
                else
                {
                    <span class="badge bg-danger fs-6">@(vencido ? "Vencido" : "Inactivo")</span>
                }
            </div>
            <div class="col-md-2">
                <p class="text-muted small mb-1">ASIGNADOS</p>
                <span class="badge bg-secondary fs-6">@Model.ClienteCupones.Count</span>
            </div>
            <div class="col-md-2">
                <p class="text-muted small mb-1">UTILIZADOS</p>
                <span class="badge bg-warning text-dark fs-6">@utilizados</span>
            </div>
            <div class="col-md-2">
                <p class="text-muted small mb-1">DISPONIBLES</p>
                <span class="badge bg-primary fs-6">@disponibles</span>
            </div>
        </div>
    </div>

    @if (Model.Estado && !vencido)
    {
        <!-- Asignar a cliente específico -->
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
            <h5 class="fw-bold mb-3" style="color:#1a3c5e;">
                <i class="bi bi-person-plus me-2"></i>Asignar a cliente
            </h5>

            @if (clientesDisponibles == null || !clientesDisponibles.Any())
            {
                <p class="text-muted small">Todos los clientes ya tienen este cupón.</p>
            }
            else
            {
                <form asp-action="Asignar" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="cuponId" value="@Model.Cupon_Id" />
                    <div class="col-md-7">
                        <input type="text" id="buscadorCliente" class="form-control rounded-3 mb-2"
                               placeholder="Buscar cliente..." oninput="filtrarClientes(this.value)" />
                        <select name="clienteId" id="selectCliente" class="form-select rounded-3" size="5">
                            @foreach (var c in clientesDisponibles)
                            {
                                <option value="@c.Cliente_Id"
                                        data-nombre="@($"{c.Usuario?.Nombre} {c.Usuario?.Primer_Apellido}".ToLower())">
                                    @c.Usuario?.Nombre @c.Usuario?.Primer_Apellido @c.Usuario?.Segundo_Apellido
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-5 d-flex flex-column gap-2 justify-content-start pt-2">
                        <button type="submit" class="btn btn-primary rounded-3">
                            <i class="bi bi-person-check me-1"></i>Asignar seleccionado
                        </button>
                    </div>
                </form>
            }
        </div>

        <!-- Asignar a todos -->
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
            <h5 class="fw-bold mb-3" style="color:#1a3c5e;">
                <i class="bi bi-people-fill me-2"></i>Asignar masivamente
            </h5>
            <form asp-action="AsignarATodos" method="post" class="row g-3 align-items-end"
                  onsubmit="return confirm('¿Asignar este cupón a los clientes filtrados?')">
                @Html.AntiForgeryToken()
                <input type="hidden" name="cuponId" value="@Model.Cupon_Id" />
                <div class="col-md-5">
                    <label class="form-label fw-semibold small text-muted">FILTRAR POR ROL</label>
                    <select name="filtroRol" class="form-select rounded-3">
                        <option value="">Todos los clientes</option>
                        <option value="Cliente">Solo clientes</option>
                        <option value="Empleado">Solo empleados</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-warning rounded-3 fw-semibold">
                        <i class="bi bi-people me-1"></i>Asignar a todos
                    </button>
                </div>
            </form>
        </div>
    }

    <!-- Lista de clientes con el cupón -->
    @if (Model.ClienteCupones.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-0">
                <div class="p-4 pb-2">
                    <h5 class="fw-bold mb-0" style="color:#1a3c5e;">
                        <i class="bi bi-list-check me-2"></i>Clientes con este cupón
                    </h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Cliente</th>
                                <th class="text-center">Asignado</th>
                                <th class="text-center">Estado</th>
                                <th class="text-center">Fecha uso</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cc in Model.ClienteCupones.OrderByDescending(x => x.Fecha_Asignacion))
                            {
                                <tr>
                                    <td>
                                        <strong>@cc.Cliente?.Usuario?.Nombre @cc.Cliente?.Usuario?.Primer_Apellido</strong>
                                        <br /><small class="text-muted">@cc.Cliente?.Usuario?.Email</small>
                                    </td>
                                    <td class="text-center small">@cc.Fecha_Asignacion.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center">
                                        @if (cc.Utilizado)
                                        {
                                            <span class="badge bg-secondary">Utilizado</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Disponible</span>
                                        }
                                    </td>
                                    <td class="text-center small">
                                        @(cc.Fecha_Uso?.ToString("dd/MM/yyyy") ?? "—")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <div class="d-flex justify-content-between">
        <a asp-action="Index" class="btn btn-secondary rounded-3">⬅ Volver</a>
        <a asp-action="Editar" asp-route-id="@Model.Cupon_Id"
           class="btn btn-warning rounded-3 text-white">✏️ Editar</a>
    </div>
</div>

@section Scripts {
    <script>
        function filtrarClientes(texto) {
            const select  = document.getElementById('selectCliente');
            const options = select.querySelectorAll('option');
            texto = texto.toLowerCase();
            options.forEach(opt => {
                const nombre = opt.dataset.nombre || '';
                opt.hidden   = texto && !nombre.includes(texto);
            });
        }
    </script>
}