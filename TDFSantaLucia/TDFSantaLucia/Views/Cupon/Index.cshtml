@model List<TDFSantaLucia.Models.Cupon>
@{
    ViewData["Title"] = "Cupones";

    var todosParaJs = Model.Select(c => new
    {
        cupon_Id = c.Cupon_Id,
        descripcion = c.Descripcion ?? "",
        tipo = c.Tipo_Descuento ?? "",
        valorTexto = c.Tipo_Descuento == "Porcentaje"
            ? $"{c.Valor_Descuento:G29}%"
            : $"₡{c.Valor_Descuento:N2}",
        fecha_Expiracion = c.Fecha_Expiracion.ToString("yyyy-MM-dd"),
        asignados = c.ClienteCupones.Count,
        utilizados = c.ClienteCupones.Count(cc => cc.Utilizado),
        estado = c.Estado,
        vencido = c.Fecha_Expiracion.Date < DateTime.Today
    });
}

<style>
    .table-responsive {
        overflow: visible !important;
    }
</style>

<div class="container-fluid px-4 py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-1" style="color:#1a3c5e;">
                <i class="bi bi-ticket-perforated-fill me-2 text-primary"></i>
                Gestión de Cupones
            </h2>
            <p class="text-muted mb-0">Crea y administra cupones de descuento</p>
        </div>
        <a asp-action="Crear" class="btn btn-success rounded-3 shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Nuevo Cupón
        </a>
    </div>

    @if (TempData["ExitoCupon"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4">
            <i class="bi bi-check-circle me-2"></i>@TempData["ExitoCupon"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorCupon"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorCupon"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-muted small">BUSCAR</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" id="buscador"
                               class="form-control border-start-0 ps-0"
                               placeholder="Descripción..." />
                        <button class="btn btn-outline-secondary" id="btnLimpiarTexto"
                                type="button" style="display:none;">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold text-muted small">TIPO</label>
                    <select id="filtroTipo" class="form-select rounded-3">
                        <option value="">Todos</option>
                        <option value="Porcentaje">Porcentaje</option>
                        <option value="Monto">Monto fijo</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold text-muted small">ESTADO</label>
                    <select id="filtroEstado" class="form-select rounded-3">
                        <option value="">Todos</option>
                        <option value="true">Activo</option>
                        <option value="false">Inactivo</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold text-muted small">VENCIMIENTO</label>
                    <select id="filtroVencimiento" class="form-select rounded-3">
                        <option value="">Todos</option>
                        <option value="vigente">Vigentes</option>
                        <option value="vencido">Vencidos</option>
                    </select>
                </div>
                <div class="col-md-2 text-end">
                    <button id="btnLimpiarFiltros" class="btn btn-outline-secondary w-100 rounded-3" style="display:none;">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Limpiar
                    </button>
                </div>
            </div>

            <div class="d-flex gap-2 mt-3 flex-wrap align-items-center">
                <span id="chipTexto" class="badge bg-primary d-none">
                    <span id="chipTextoLabel"></span>
                    <button type="button" class="btn-close btn-close-white btn-sm ms-1" id="btnRemoveTexto" style="font-size:0.6rem;"></button>
                </span>
                <span id="chipTipo" class="badge bg-secondary d-none">
                    <span id="chipTipoLabel"></span>
                    <button type="button" class="btn-close btn-close-white btn-sm ms-1" id="btnRemoveTipo" style="font-size:0.6rem;"></button>
                </span>
                <span id="chipEstado" class="badge bg-info text-dark d-none">
                    <span id="chipEstadoLabel"></span>
                    <button type="button" class="btn-close btn-sm ms-1" id="btnRemoveEstado" style="font-size:0.6rem;"></button>
                </span>
                <span id="chipVencimiento" class="badge bg-warning text-dark d-none">
                    <span id="chipVencimientoLabel"></span>
                    <button type="button" class="btn-close btn-sm ms-1" id="btnRemoveVencimiento" style="font-size:0.6rem;"></button>
                </span>
                <small id="contadorResultados" class="text-muted ms-auto"></small>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Descripción</th>
                    <th class="text-center">Tipo</th>
                    <th class="text-center">Valor</th>
                    <th class="text-center">Vence</th>
                    <th class="text-center">Asignados</th>
                    <th class="text-center">Utilizados</th>
                    <th class="text-center">Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody id="tablaCupones">
                @{
                    int fila = 1;
                }
                @foreach (var c in Model)
                {
                    var vencido = c.Fecha_Expiracion.Date < DateTime.Today;
                    var utilizados = c.ClienteCupones.Count(cc => cc.Utilizado);
                    var valorTexto = c.Tipo_Descuento == "Porcentaje" ? $"{c.Valor_Descuento:G29}%" : $"₡{c.Valor_Descuento:N2}";
                    <tr>
                        <td class="text-muted small">@fila</td>
                        <td class="fw-semibold">@c.Descripcion</td>
                        <td class="text-center">
                            <span class="badge @(c.Tipo_Descuento == "Porcentaje" ? "bg-info-subtle text-info border border-info-subtle" : "bg-primary-subtle text-primary border border-primary-subtle")">
                                @c.Tipo_Descuento
                            </span>
                        </td>
                        <td class="text-center fw-bold text-success">@valorTexto</td>
                        <td class="text-center small">
                            @if (vencido)
                            {
                                <span class="text-danger fw-semibold">
                                    <i class="bi bi-x-circle me-1"></i>@c.Fecha_Expiracion.ToString("dd/MM/yyyy")
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">@c.Fecha_Expiracion.ToString("dd/MM/yyyy")</span>
                            }
                        </td>
                        <td class="text-center">
                            <span class="badge bg-secondary">@c.ClienteCupones.Count</span>
                        </td>
                        <td class="text-center">
                            <span class="badge bg-warning text-dark">@utilizados</span>
                        </td>
                        <td class="text-center">
                            @if (c.Estado && !vencido)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">@(vencido ? "Vencido" : "Inactivo")</span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="dropdown">
                                <button class="btn btn-outline-secondary btn-sm rounded-3"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow rounded-3">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-action="Detalle" asp-route-id="@c.Cupon_Id">
                                            <i class="bi bi-eye me-2" style="color:#6baed6;"></i>Ver detalle
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item"
                                           asp-action="Editar" asp-route-id="@c.Cupon_Id">
                                            <i class="bi bi-pencil me-2" style="color:#fd8d3c;"></i>Editar
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    @if (c.Estado)
                                    {
                                        <li>
                                            <a class="dropdown-item"
                                               href="#"
                                               onclick="return confirmarCambioEstado(event, '@c.Cupon_Id', false)">
                                                <i class="bi bi-slash-circle me-2" style="color:#e57373;"></i>Desactivar
                                            </a>
                                        </li>
                                    }
                                    else
                                    {
                                        <li>
                                            <a class="dropdown-item"
                                               href="#"
                                               onclick="return confirmarCambioEstado(event, '@c.Cupon_Id', true)">
                                                <i class="bi bi-check-circle me-2" style="color:#74c476;"></i>Activar
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </td>
                    </tr>
                    fila++;
                }
            </tbody>
        </table>
    </div>

    <div id="estadoVacio" class="text-center py-5 d-none">
        <i class="bi bi-inbox display-4 text-muted"></i>
        <p class="text-muted mt-2">No se encontraron cupones con los filtros aplicados.</p>
        <button class="btn btn-outline-secondary btn-sm rounded-3" id="btnLimpiarDesdeVacio">
            Limpiar filtros
        </button>
    </div>

</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        const todosLosCupones = @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(todosParaJs)
            );

        const $buscador          = $('#buscador');
        const $filtroTipo        = $('#filtroTipo');
        const $filtroEstado      = $('#filtroEstado');
        const $filtroVencimiento = $('#filtroVencimiento');
        const $tabla             = $('#tablaCupones');
        const $estadoVacio       = $('#estadoVacio');
        const $contador          = $('#contadorResultados');
        const $btnLimpiarTexto   = $('#btnLimpiarTexto');
        const $btnLimpiarFiltros = $('#btnLimpiarFiltros');

        function filtrar() {
            const texto    = $buscador.val().trim().toLowerCase();
            const tipo     = $filtroTipo.val();
            const estado   = $filtroEstado.val();
            const venc     = $filtroVencimiento.val();
            const hay      = texto !== '' || tipo !== '' || estado !== '' || venc !== '';

            actualizarChips(texto, tipo, estado, venc);
            $btnLimpiarFiltros.toggle(hay);
            $btnLimpiarTexto.toggle(texto !== '');

            if (!hay) { restaurarVista(); return; }

            const resultado = todosLosCupones.filter(function (c) {
                const coincideTexto  = texto === '' || c.descripcion.toLowerCase().includes(texto);
                const coincideTipo   = tipo === '' || c.tipo === tipo;
                const coincideEstado = estado === '' || (c.estado && !c.vencido).toString() === estado;
                const coincideVenc   = venc === '' ||
                    (venc === 'vencido' && c.vencido) ||
                    (venc === 'vigente' && !c.vencido);
                return coincideTexto && coincideTipo && coincideEstado && coincideVenc;
            });

            renderTabla(resultado, texto);
        }

        function renderTabla(cupones, texto) {
            if (cupones.length === 0) {
                $tabla.html('');
                $estadoVacio.removeClass('d-none');
                $contador.text('');
                return;
            }

            $estadoVacio.addClass('d-none');
            $contador.html(`<span class="fw-semibold">${cupones.length}</span> resultado${cupones.length !== 1 ? 's' : ''} encontrado${cupones.length !== 1 ? 's' : ''}`);

            let filas = '';
            cupones.forEach(function (c, index) {
                const tipoBadge = c.tipo === 'Porcentaje'
                    ? `<span class="badge bg-info-subtle text-info border border-info-subtle">Porcentaje</span>`
                    : `<span class="badge bg-primary-subtle text-primary border border-primary-subtle">Monto</span>`;

                const vencHtml = c.vencido
                    ? `<span class="text-danger fw-semibold"><i class="bi bi-x-circle me-1"></i>${formatearFecha(c.fecha_Expiracion)}</span>`
                    : `<span class="text-muted">${formatearFecha(c.fecha_Expiracion)}</span>`;

                const estadoBadge = (c.estado && !c.vencido)
                    ? `<span class="badge bg-success-subtle text-success border border-success-subtle">Activo</span>`
                    : `<span class="badge bg-danger-subtle text-danger border border-danger-subtle">${c.vencido ? 'Vencido' : 'Inactivo'}</span>`;

                const accionEstadoHtml = c.estado
                    ? `<a class="dropdown-item" href="#" onclick="return confirmarCambioEstado(event, ${c.cupon_Id}, false)">
                           <i class="bi bi-slash-circle me-2" style="color:#e57373;"></i>Desactivar</a>`
                    : `<a class="dropdown-item" href="#" onclick="return confirmarCambioEstado(event, ${c.cupon_Id}, true)">
                           <i class="bi bi-check-circle me-2" style="color:#74c476;"></i>Activar</a>`;

                filas += `
                    <tr>
                        <td class="text-muted small">${index + 1}</td>
                        <td class="fw-semibold">${resaltar(c.descripcion, texto)}</td>
                        <td class="text-center">${tipoBadge}</td>
                        <td class="text-center fw-bold text-success">${c.valorTexto}</td>
                        <td class="text-center small">${vencHtml}</td>
                        <td class="text-center"><span class="badge bg-secondary">${c.asignados}</span></td>
                        <td class="text-center"><span class="badge bg-warning text-dark">${c.utilizados}</span></td>
                        <td class="text-center">${estadoBadge}</td>
                        <td class="text-center">
                            <div class="dropdown">
                                <button class="btn btn-outline-secondary btn-sm rounded-3"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow rounded-3">
                                    <li>
                                        <a class="dropdown-item" href="/cupon/detalle/${c.cupon_Id}">
                                            <i class="bi bi-eye me-2" style="color:#6baed6;"></i>Ver detalle
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="/cupon/editar/${c.cupon_Id}">
                                            <i class="bi bi-pencil me-2" style="color:#fd8d3c;"></i>Editar
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>${accionEstadoHtml}</li>
                                </ul>
                            </div>
                        </td>
                    </tr>`;
            });

            $tabla.html(filas);
        }

        function restaurarVista() {
            $estadoVacio.addClass('d-none');
            $btnLimpiarFiltros.hide();
            $btnLimpiarTexto.hide();
            $contador.text('');
            renderTabla(todosLosCupones, '');
        }

        function formatearFecha(fechaStr) {
            const partes = fechaStr.split('-');
            const d = new Date(parseInt(partes[0]), parseInt(partes[1]) - 1, parseInt(partes[2]));
            return d.toLocaleDateString('es-CR');
        }

        function resaltar(valor, busqueda) {
            if (!busqueda) return escapeHtml(valor);
            const escaped = busqueda.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            return escapeHtml(valor).replace(new RegExp(`(${escaped})`, 'gi'), '<mark class="px-0 bg-warning rounded-1">$1</mark>');
        }

        function escapeHtml(str) {
            return (str ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        function actualizarChips(texto, tipo, estado, venc) {
            $('#chipTexto').toggleClass('d-none', texto === '');
            if (texto !== '') $('#chipTextoLabel').text(`"${texto}"`);

            $('#chipTipo').toggleClass('d-none', tipo === '');
            if (tipo !== '') $('#chipTipoLabel').text(tipo);

            $('#chipEstado').toggleClass('d-none', estado === '');
            if (estado !== '') $('#chipEstadoLabel').text(estado === 'true' ? 'Activo' : 'Inactivo');

            $('#chipVencimiento').toggleClass('d-none', venc === '');
            if (venc !== '') $('#chipVencimientoLabel').text(venc === 'vencido' ? 'Vencidos' : 'Vigentes');
        }

        function confirmarCambioEstado(e, id, activar) {
            e.preventDefault();
            const accion = activar ? 'activar' : 'desactivar';
            if (!confirm(`¿Está seguro de ${accion} este cupón?`)) return false;

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const form  = document.createElement('form');
            form.method = 'POST';
            form.action = `/cupon/${accion}/${id}`;
            const inp   = document.createElement('input');
            inp.type = 'hidden'; inp.name = '__RequestVerificationToken'; inp.value = token;
            form.appendChild(inp);
            document.body.appendChild(form);
            form.submit();
            return false;
        }

        $buscador.on('input', filtrar);
        $filtroTipo.on('change', filtrar);
        $filtroEstado.on('change', filtrar);
        $filtroVencimiento.on('change', filtrar);
        $btnLimpiarTexto.on('click', () => $buscador.val('').trigger('input').focus());
        $btnLimpiarFiltros.on('click', () => { $buscador.val(''); $filtroTipo.val(''); $filtroEstado.val(''); $filtroVencimiento.val(''); restaurarVista(); });
        $('#btnLimpiarDesdeVacio').on('click', () => { $buscador.val(''); $filtroTipo.val(''); $filtroEstado.val(''); $filtroVencimiento.val(''); restaurarVista(); });
        $('#btnRemoveTexto').on('click', () => $buscador.val('').trigger('input'));
        $('#btnRemoveTipo').on('click', () => $filtroTipo.val('').trigger('change'));
        $('#btnRemoveEstado').on('click', () => $filtroEstado.val('').trigger('change'));
        $('#btnRemoveVencimiento').on('click', () => $filtroVencimiento.val('').trigger('change'));
    </script>
}