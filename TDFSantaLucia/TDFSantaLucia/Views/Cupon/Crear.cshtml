@model TDFSantaLucia.Models.CuponViewModel
@{
    ViewData["Title"] = "Crear Cupón";
    var minFecha = DateTime.Today.AddDays(1).ToString("yyyy-MM-dd");
}

<div class="container mt-4" style="max-width:600px;">
    <h2 class="fw-bold mb-4" style="color:#1a3c5e;">
        <i class="bi bi-ticket-perforated-fill me-2"></i>Nuevo Cupón
    </h2>

    <form asp-action="Crear" method="post" class="card border-0 shadow-sm rounded-4 p-4">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small"></div>

        <div class="mb-3">
            <label asp-for="Descripcion" class="form-label fw-semibold">Descripción</label>
            <input asp-for="Descripcion" class="form-control rounded-3"
                   placeholder="Ej: Descuento de bienvenida" />
            <span asp-validation-for="Descripcion" class="text-danger small"></span>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="Tipo_Descuento" class="form-label fw-semibold">Tipo de Descuento</label>
                <select asp-for="Tipo_Descuento" class="form-select rounded-3"
                        onchange="actualizarLimites(this.value)">
                    <option value="">Seleccione...</option>
                    <option value="Porcentaje">Porcentaje (%) sobre el total</option>
                    <option value="Monto">Monto fijo (₡) del total</option>
                </select>
                <span asp-validation-for="Tipo_Descuento" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Valor_Descuento" class="form-label fw-semibold">Valor</label>
                <input asp-for="Valor_Descuento" type="number" step="0.01" min="0.01"
                       id="inputValor" class="form-control rounded-3"
                       placeholder="Seleccione el tipo primero" />
                <span asp-validation-for="Valor_Descuento" class="text-danger small"></span>
                <div id="previewDescuento" class="text-muted small mt-1"></div>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Fecha_Expiracion" class="form-label fw-semibold">Fecha de Expiración</label>
            <input asp-for="Fecha_Expiracion" type="date" class="form-control rounded-3"
                   id="inputFecha"
                   min="@minFecha" />
            <span asp-validation-for="Fecha_Expiracion" class="text-danger small"></span>
            <div id="errorFecha" class="text-danger small mt-1" style="display:none;">
                <i class="bi bi-exclamation-circle me-1"></i>
                La fecha debe ser posterior a hoy.
            </div>
        </div>

        <div class="mb-4">
            <div class="form-check">
                <input asp-for="Estado" class="form-check-input" type="checkbox" />
                <label asp-for="Estado" class="form-check-label fw-semibold">Activo</label>
            </div>
        </div>

        <div class="d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary rounded-3">⬅ Volver</a>
            <button type="submit" class="btn btn-success rounded-3">✔ Guardar</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const MIN_FECHA = '@minFecha';

        function actualizarLimites(tipo) {
            const input   = document.getElementById('inputValor');
            const preview = document.getElementById('previewDescuento');

            if (tipo === 'Porcentaje') {
                input.min         = '0.01';
                input.max         = '100';
                input.step        = '0.01';
                input.placeholder = 'Ej: 10 para 10% de descuento';
                preview.textContent = 'Máximo: 100%';
                preview.className   = 'text-muted small mt-1';
            } else if (tipo === 'Monto') {
                input.min         = '0.01';
                input.max         = '10000';
                input.step        = '1';
                input.placeholder = 'Ej: 5000 para ₡5,000 de descuento';
                preview.textContent = 'Máximo: ₡10,000';
                preview.className   = 'text-muted small mt-1';
            } else {
                input.removeAttribute('max');
                input.placeholder   = 'Seleccione el tipo primero';
                preview.textContent = '';
            }

            // Revalidar valor actual si ya tenía uno
            validarValor(input);
        }

        function validarValor(input) {
            const tipo    = document.getElementById('Tipo_Descuento').value;
            const valor   = parseFloat(input.value) || 0;
            const preview = document.getElementById('previewDescuento');

            if (!tipo || !input.value) return;

            if (tipo === 'Porcentaje') {
                if (valor > 100) {
                    preview.textContent = '⚠️ El porcentaje no puede superar 100%.';
                    preview.className   = 'text-danger small mt-1';
                    input.value = 100;
                } else if (valor <= 0) {
                    preview.textContent = '⚠️ El valor debe ser mayor a 0.';
                    preview.className   = 'text-danger small mt-1';
                } else {
                    preview.textContent = `✔ Descuento del ${valor}% sobre el total.`;
                    preview.className   = 'text-success small mt-1';
                }
            } else if (tipo === 'Monto') {
                if (valor > 10000) {
                    preview.textContent = '⚠️ El monto no puede superar ₡10,000.';
                    preview.className   = 'text-danger small mt-1';
                    input.value = 10000;
                } else if (valor <= 0) {
                    preview.textContent = '⚠️ El valor debe ser mayor a 0.';
                    preview.className   = 'text-danger small mt-1';
                } else {
                    preview.textContent = `✔ Descuento de ₡${valor.toLocaleString('es-CR')} del total.`;
                    preview.className   = 'text-success small mt-1';
                }
            }
        }

                function validarFecha(input) {
            const errorEl = document.getElementById('errorFecha');

            if (!/^\d{4}-\d{2}-\d{2}$/.test(input.value)) {
                errorEl.style.display = 'none';
                return;
            }

            const hoy = new Date();
            hoy.setHours(0, 0, 0, 0);
            const seleccionada = new Date(input.value + 'T00:00:00');

            if (seleccionada <= hoy) {
                errorEl.style.display = 'block';
            } else {
                errorEl.style.display = 'none';
            }
        }

        document.getElementById('inputValor')
            .addEventListener('input', function () { validarValor(this); });

        document.getElementById('inputFecha')
            .addEventListener('blur', function () { validarFecha(this); });

        // Validación al enviar el form
        document.querySelector('form').addEventListener('submit', function (e) {
            const tipo   = document.getElementById('Tipo_Descuento').value;
            const valor  = parseFloat(document.getElementById('inputValor').value) || 0;
            const fecha  = document.getElementById('inputFecha').value;
            const hoy    = new Date();
            hoy.setHours(0, 0, 0, 0);

            let valido = true;

            if (tipo === 'Monto' && valor > 10000) {
                document.getElementById('previewDescuento').textContent =
                    '⚠️ El monto no puede superar ₡10,000.';
                document.getElementById('previewDescuento').className =
                    'text-danger small mt-1';
                valido = false;
            }

            if (tipo === 'Porcentaje' && valor > 100) {
                document.getElementById('previewDescuento').textContent =
                    '⚠️ El porcentaje no puede superar 100%.';
                document.getElementById('previewDescuento').className =
                    'text-danger small mt-1';
                valido = false;
            }

            if (fecha && new Date(fecha + 'T00:00:00') <= hoy) {
                document.getElementById('errorFecha').style.display = 'block';
                valido = false;
            }

            if (!valido) e.preventDefault();
        });
    </script>
    <partial name="_ValidationScriptsPartial" />
}